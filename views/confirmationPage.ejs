<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Booking Submitted - RideWave</title>

    <link rel="icon" type="image/png" href="/images/title.png.jpeg">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-primary': '#FF6B35',
                        'brand-primary-hover': '#e85a26'
                    }
                }
            }
        }
    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            padding-top: 72px !important;
        }

        .ridewave-navbar {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 102px !important;
            background: #ffffff !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            border-bottom: 1px solid #e5e7eb;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            z-index: 99998;
        }

        .ridewave-logo {
            width: 125px;
            height: 90px;
            object-fit: contain;
            display: block;
        }

        .ridewave-nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .ridewave-nav-links a {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #334155 !important;
            text-decoration: none;
            font-size: 16px;
            font-weight: 500;
            white-space: nowrap;
            transition: color 0.2s ease;
        }

        .ridewave-nav-links a:hover {
            color: #FF6B35 !important;
        }

        /* TRUST & SECURITY SECTION */

        .trust-section {
            width: 100%;
            background: #f8fafc;
            padding: 65px 7%;
            border-top: 1px solid #e5e7eb;
        }

        .trust-container {
            max-width: 1150px;
            margin: auto;
        }

        .trust-heading {
            text-align: center;
            margin-bottom: 42px;
        }

        .trust-heading h2 {
            color: #08123B;
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .trust-heading h2 span {
            color: #FF6B35;
        }

        .trust-heading p {
            color: #64748b;
            font-size: 15px;
            line-height: 1.7;
        }

        .trust-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .trust-card {
            background: #ffffff;
            padding: 27px 22px;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            transition: 0.3s ease;
        }

        .trust-card:hover {
            transform: translateY(-5px);
            border-color: #FF6B35;
            box-shadow: 0 10px 25px rgba(8,18,59,0.07);
        }

        .trust-icon {
            width: 52px;
            height: 52px;
            background: #fff0e9;
            color: #FF6B35;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 27px;
            margin-bottom: 18px;
        }

        .trust-card h3 {
            font-size: 17px;
            font-weight: 700;
            color: #08123B;
            margin-bottom: 9px;
        }

        .trust-card p {
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
        }

        .trust-note {
            margin-top: 35px;
            padding: 20px;
            background: #08123B;
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .trust-note i {
            color: #FF6B35;
            font-size: 30px;
            flex-shrink: 0;
        }

        .trust-note p {
            color: #e2e8f0;
            font-size: 14px;
            line-height: 1.7;
        }

        .trust-note strong {
            color: white;
        }

        @media (max-width: 768px) {
            .ridewave-navbar {
                height: 64px !important;
                padding: 0 18px;
            }

            .ridewave-logo {
                width: 105px;
                height: 38px;
            }

            .ridewave-nav-links {
                gap: 14px;
            }

            .ridewave-nav-links a {
                font-size: 13px;
            }

            body {
                padding-top: 64px !important;
            }

            .trust-section {
                padding: 45px 20px;
            }

            .trust-heading h2 {
                font-size: 25px;
            }

            .trust-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 13px;
            }

            .trust-card {
                padding: 20px 15px;
            }

            .trust-card h3 {
                font-size: 15px;
            }

            .trust-card p {
                font-size: 13px;
            }
        }

        @media (max-width: 480px) {
            .trust-grid {
                grid-template-columns: 1fr;
            }

            .trust-note {
                align-items: flex-start;
            }
        }
    </style>
</head>

<body class="bg-white text-gray-900 min-h-screen flex flex-col justify-between">

