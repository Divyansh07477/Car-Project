<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RideWave - Automotive Films</title>

    <link rel="icon" type="image/png" href="/images/title.png.jpeg">

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >

<style>

/* =========================================================
   RIDEWAVE — BLACK LUXURY AUTOMOTIVE
========================================================= */

:root {
    --black: #050505;
    --black-2: #080808;
    --black-3: #0d0d0d;

    --card: #101010;
    --card-2: #151515;

    --white: #ffffff;

    --muted: #929292;
    --muted-2: #666666;

    --line: rgba(255,255,255,.09);

    --orange: #ff532e;
    --orange-dark: #e94725;

    --orange-soft: rgba(255,83,46,.12);
}


/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    background: var(--black);
}

body {
    font-family: "Inter", sans-serif;
    background: var(--black);
    color: var(--white);
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font-family: inherit;
}


/* =========================================================
   NAVBAR
========================================================= */

.navbar {

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 82px;

    display: flex;
    align-items: center;

    padding: 0 5.5%;

    background: rgba(5, 5, 5, .94);

    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    border-bottom: 1px solid rgba(255,255,255,.08);

    /*
       IMPORTANT
       Navbar sabke upar rahega
    */
    z-index: 999999;

    isolation: isolate;
}


/* =========================================================
   LOGO
========================================================= */

.logo {

    display: flex;

    align-items: center;
    justify-content: flex-start;

    width: 190px;
    height: 70px;

    flex-shrink: 0;

    overflow: visible;

    position: relative;

    z-index: 1000000;
}

.ridewave-brand {

    font-size: 20px;

    font-weight: 800;

    letter-spacing: 1px;

    margin-left: 8px;

    color: #fff;

    text-transform: uppercase;

    white-space: nowrap;
}

.ridewave-brand span {
    color: var(--orange);
}


/* =========================================================
   NAV LINKS
========================================================= */

.nav-links {

    display: flex;

    align-items: center;

    gap: 32px;

    margin-left: auto;
    margin-right: 35px;

    position: relative;

    z-index: 1000000;
}

.nav-links a {

    position: relative;

    font-size: 13px;

    font-weight: 600;

    color: #a9a9a9;

    transition: .3s ease;
}

.nav-links a::after {

    content: "";

    position: absolute;

    left: 50%;

    bottom: -10px;

    width: 0;

    height: 2px;

    background: var(--orange);

    transform: translateX(-50%);

    transition: .3s ease;
}

.nav-links a:hover,
.nav-links a.active {

    color: #fff;
}

.nav-links a:hover::after,
.nav-links a.active::after {

    width: 100%;
}


/* =========================================================
   NAV CTA
========================================================= */

.nav-cta {

    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-width: 168px;

    padding: 14px 24px;

    border-radius: 8px;

    background: var(--orange);

    color: #fff;

    font-size: 12px;

    font-weight: 800;

    letter-spacing: .3px;

    white-space: nowrap;

    transition: .3s ease;

    box-shadow:
        0 10px 30px rgba(255,83,46,.15);

    position: relative;

    z-index: 1000000;
}

.nav-cta:hover {

    background: #fff;

    color: #111;

    transform: translateY(-2px);

    box-shadow:
        0 15px 35px rgba(255,255,255,.10);
}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.menu-btn {

    display: none;

    width: 42px;
    height: 42px;

    border: 1px solid rgba(255,255,255,.15);

    background: #111;

    color: #fff;

    border-radius: 8px;

    cursor: pointer;

    align-items: center;
    justify-content: center;

    font-size: 22px;

    line-height: 1;

    position: relative;

    z-index: 1000001;

    flex-shrink: 0;
}

.menu-btn:hover {

    background: var(--orange);

    border-color: var(--orange);
}


/* =========================================================
   HERO
========================================================= */

.hero {

    min-height: 100vh;

    width: 100%;

    max-width: 1600px;

    margin: 0 auto;

    padding: 135px 5% 75px;

    display: grid;

    grid-template-columns: .75fr 1.25fr;

    align-items: center;

    gap: 65px;

    position: relative;

    overflow: hidden;

    background:

        radial-gradient(
            circle at 82% 42%,
            rgba(255,83,46,.11),
            transparent 31%
        ),

        radial-gradient(
            circle at 10% 80%,
            rgba(255,255,255,.025),
            transparent 25%
        ),

        linear-gradient(
            135deg,
            #050505 0%,
            #080808 55%,
            #0d0d0d 100%
        );

    border-bottom:
        1px solid rgba(255,255,255,.06);

    z-index: 1;
}


/* =========================================================
   HERO DECORATION
========================================================= */

.hero::before {

    content: "";

    position: absolute;

    width: 700px;
    height: 700px;

    border-radius: 50%;

    border:
        1px solid rgba(255,83,46,.07);

    right: -280px;
    top: -230px;

    box-shadow:

        0 0 0 80px
        rgba(255,255,255,.008),

        0 0 0 160px
        rgba(255,255,255,.006),

        0 0 0 240px
        rgba(255,255,255,.004);

    pointer-events: none;
}

.hero::after {

    content: "";

    position: absolute;

    width: 350px;
    height: 350px;

    background:
        rgba(255,83,46,.08);

    filter: blur(130px);

    right: 15%;
    bottom: -180px;

    pointer-events: none;
}


/* =========================================================
   HERO CONTENT
========================================================= */

.hero-content {

    width: 100%;

    max-width: 560px;

    position: relative;

    z-index: 5;

    text-align: left;
}


/* =========================================================
   EYEBROW
========================================================= */

.eyebrow {

    display: inline-flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 25px;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 3px;

    text-transform: uppercase;

    color: var(--orange);
}

.eyebrow::before {

    content: "";

    width: 34px;
    height: 1px;

    background:
        var(--orange);
}


/* =========================================================
   HERO HEADING
========================================================= */

.hero h1 {

    font-size:
        clamp(55px, 6vw, 88px);

    line-height: .88;

    letter-spacing: -5px;

    font-weight: 900;

    color: #fff;

    margin-bottom: 30px;
}

.hero h1 span {

    color:
        var(--orange);

    text-shadow:
        0 0 35px
        rgba(255,83,46,.15);
}


/* =========================================================
   HERO TEXT
========================================================= */

.hero p {

    max-width: 500px;

    font-size: 14px;

    line-height: 1.8;

    color: #888;

    margin-bottom: 35px;
}


/* =========================================================
   CTA BUTTON
========================================================= */

.cta-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 15px 25px;

    border-radius: 7px;

    background: #fff;

    color: #080808;

    font-size: 12px;

    font-weight: 900;

    letter-spacing: .7px;

    transition: .3s ease;

    border:
        1px solid #fff;
}

.cta-btn:hover {

    background:
        var(--orange);

    border-color:
        var(--orange);

    color: #fff;

    transform:
        translateY(-3px);

    box-shadow:
        0 15px 40px
        rgba(255,83,46,.20);
}


/* =========================================================
   HERO VIDEO
========================================================= */

.hero-video {

    width: 100%;

    max-width: 950px;

    position: relative;

    z-index: 5;

    overflow: hidden;

    border-radius: 18px;

    background: #000;

    border:
        1px solid
        rgba(255,255,255,.12);

    margin-left: auto;

    box-shadow:

        0 35px 100px
        rgba(0,0,0,.65),

        0 0 50px
        rgba(255,83,46,.05);
}

.hero-video::before {

    content: "";

    position: absolute;

    inset: 0;

    border:
        1px solid
        rgba(255,83,46,.22);

    border-radius: 18px;

    pointer-events: none;

    z-index: 10;
}

.hero-video video {

    width: 100%;

    height: auto;

    aspect-ratio:
        16 / 9;

    display: block;

    object-fit: cover;

    object-position: center;

    background: #000;

    transform: none;

    transition:
        transform .7s ease;
}

.hero-video:hover video {

    transform:
        scale(1.012);
}


/* =========================================================
   COLLECTION
========================================================= */

.collection {

    padding:
        115px 6% 120px;

    background:

        radial-gradient(
            circle at 50% 0%,
            rgba(255,83,46,.035),
            transparent 30%
        ),

        linear-gradient(
            180deg,
            #080808 0%,
            #0b0b0b 100%
        );

    position: relative;

    z-index: 2;
}


/* =========================================================
   SECTION TOP
========================================================= */

.section-top {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 40px;

    margin-bottom: 48px;
}

.section-heading {

    max-width: 700px;
}

.section-label {

    color:
        var(--orange);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 3px;

    text-transform: uppercase;

    margin-bottom: 15px;
}

.section-heading h2 {

    font-size:
        clamp(40px, 5vw, 68px);

    line-height: .9;

    letter-spacing: -4px;

    font-weight: 900;

    color: #fff;
}

.section-heading p {

    margin-top: 20px;

    max-width: 590px;

    color: #777;

    font-size: 14px;

    line-height: 1.8;
}


/* =========================================================
   FILTERS
========================================================= */

.filters {

    display: flex;

    align-items: center;

    gap: 9px;

    flex-wrap: wrap;

    margin-bottom: 45px;
}

.filter-btn {

    border:
        1px solid
        rgba(255,255,255,.11);

    background: #101010;

    color: #888;

    padding:
        11px 18px;

    border-radius: 30px;

    font-size: 11px;

    font-weight: 700;

    cursor: pointer;

    transition: .3s ease;
}

.filter-btn:hover {

    border-color:
        var(--orange);

    color: #fff;

    background:
        var(--orange-soft);
}

.filter-btn.active {

    background:
        var(--orange);

    border-color:
        var(--orange);

    color: #fff;

    box-shadow:
        0 8px 25px
        rgba(255,83,46,.15);
}


/* =========================================================
   VIDEO GRID
========================================================= */

.video-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap:
        35px 28px;
}


/* =========================================================
   VIDEO CARD
========================================================= */

.video-card {

    background:
        linear-gradient(
            145deg,
            #111,
            #0b0b0b
        );

    border-radius: 15px;

    overflow: hidden;

    border:
        1px solid
        rgba(255,255,255,.08);

    transition:

        transform .4s ease,

        box-shadow .4s ease,

        border-color .4s ease;

    position: relative;
}

.video-card:hover {

    transform:
        translateY(-8px);

    border-color:
        rgba(255,83,46,.35);

    box-shadow:

        0 30px 70px
        rgba(0,0,0,.45),

        0 0 35px
        rgba(255,83,46,.05);
}


/* =========================================================
   VIDEO BOX
========================================================= */

.video-box {

    position: relative;

    width: 100%;

    aspect-ratio:
        16 / 9;

    background: #000;

    overflow: hidden;
}

.video-box video {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: contain;

    object-position: center;

    background: #000;

    transform: none;
}


/* =========================================================
   VIDEO OVERLAY
========================================================= */

.video-box::after {

    content: "";

    position: absolute;

    inset: 0;

    pointer-events: none;

    background:

        linear-gradient(
            180deg,
            rgba(0,0,0,.08),
            transparent 45%,
            rgba(0,0,0,.28)
        );
}


/* =========================================================
   VIDEO INFO
========================================================= */

.video-info {

    padding:
        23px 24px 25px;

    background:

        linear-gradient(
            145deg,
            #111,
            #0c0c0c
        );
}

.video-info-top {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;
}

.video-info h3 {

    font-size: 21px;

    line-height: 1.2;

    font-weight: 800;

    color: #fff;
}

.video-category {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding:
        7px 10px;

    border-radius: 5px;

    background:
        rgba(255,83,46,.10);

    border:
        1px solid
        rgba(255,83,46,.15);

    color:
        var(--orange);

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 1px;

    text-transform: uppercase;

    white-space: nowrap;
}

.video-info p {

    margin-top: 11px;

    font-size: 12px;

    line-height: 1.7;

    color: #777;
}


/* =========================================================
   HIDDEN
========================================================= */

.video-card.hidden {
    display: none;
}


/* =========================================================
   BOTTOM CTA
========================================================= */

.bottom-cta {

    padding:
        125px 6%;

    background:

        radial-gradient(
            circle at center,
            rgba(255,83,46,.09),
            transparent 32%
        ),

        #050505;

    position: relative;

    overflow: hidden;

    text-align: center;

    border-top:
        1px solid
        rgba(255,255,255,.06);
}

.bottom-cta::before {

    content: "";

    position: absolute;

    width: 600px;
    height: 600px;

    border-radius: 50%;

    border:
        1px solid
        rgba(255,83,46,.06);

    left: 50%;

    top: -350px;

    transform:
        translateX(-50%);

    box-shadow:

        0 0 0 80px
        rgba(255,255,255,.006),

        0 0 0 160px
        rgba(255,255,255,.004);
}

.bottom-cta-content {

    position: relative;

    z-index: 2;
}

.bottom-cta .small-title {

    color:
        var(--orange);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 3px;

    text-transform: uppercase;

    margin-bottom: 20px;
}

.bottom-cta h2 {

    color: #fff;

    font-size:
        clamp(42px, 6vw, 82px);

    line-height: .9;

    letter-spacing: -5px;

    font-weight: 900;

    margin-bottom: 27px;
}

.bottom-cta p {

    max-width: 560px;

    margin:
        0 auto 32px;

    color: #777;

    font-size: 13px;

    line-height: 1.8;
}

.bottom-cta .cta-btn {

    background:
        var(--orange);

    border-color:
        var(--orange);

    color: #fff;
}

.bottom-cta .cta-btn:hover {

    background: #fff;

    border-color: #fff;

    color: #111;
}


/* =========================================================
   FOOTER
========================================================= */

footer {

    background: #020202;

    color: #fff;

    padding:
        60px 6% 30px;

    border-top:
        1px solid
        rgba(255,255,255,.06);
}

.footer-top {

    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 50px;

    padding-bottom: 45px;

    border-bottom:
        1px solid
        rgba(255,255,255,.08);
}

.footer-brand {

    max-width: 350px;
}

.footer-brand p {

    color: #666;

    font-size: 12px;

    line-height: 1.8;
}

.footer-links {

    display: flex;

    gap: 75px;
}

.footer-column h4 {

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 2px;

    margin-bottom: 20px;

    color: #fff;
}

.footer-column a {

    display: block;

    color: #666;

    font-size: 12px;

    margin-bottom: 12px;

    transition: .25s ease;
}

.footer-column a:hover {

    color:
        var(--orange);

    transform:
        translateX(3px);
}

.footer-bottom {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    padding-top: 25px;
}

.footer-bottom p,
.footer-bottom span {

    color: #444;

    font-size: 10px;
}

.footer-bottom span {

    letter-spacing: 1px;
}


/* =========================================================
   TABLET — 1050px
========================================================= */

@media (max-width: 1050px) {

    .navbar {
        padding: 0 4%;
    }

    .nav-links {
        gap: 20px;
        margin-right: 20px;
    }

    .nav-links a {
        font-size: 12px;
    }

    .nav-cta {
        min-width: 145px;
        padding: 13px 18px;
    }

    .hero {

        grid-template-columns:
            1fr 1.15fr;

        gap: 40px;

        padding:
            125px 4% 65px;
    }

    .hero h1 {

        font-size:
            clamp(50px, 6vw, 72px);
    }

    .footer-links {
        gap: 40px;
    }
}


/* =========================================================
   MOBILE / TABLET — 850px
========================================================= */

@media (max-width: 850px) {

    /* =========================
       NAVBAR
    ========================= */

    .navbar {

        height: 72px;

        padding:
            0 5%;

        /*
           IMPORTANT
           Menu ko hero ke upar rakhega
        */
        z-index: 999999;
    }

    .logo {

        width: auto;

        height: 55px;

        flex: 1;

        z-index: 1000000;
    }

    .ridewave-brand {

        font-size: 18px;

        margin-left: 0;
    }


    /* =========================
       MENU BUTTON
    ========================= */

    .menu-btn {

        display: flex;

        margin-left: auto;

        z-index: 1000001;
    }


    /* =========================
       CTA HIDE
    ========================= */

    .nav-cta {
        display: none;
    }


    /* =====================================================
       MOBILE NAV MENU — MAIN FIX
    ===================================================== */

    .nav-links {

        position: fixed !important;

        top: 72px !important;

        left: 0 !important;

        right: 0 !important;

        width: 100% !important;

        height: auto !important;

        max-height: calc(100vh - 72px);

        overflow-y: auto;

        padding:
            18px 5% 25px !important;

        background:
            #050505 !important;

        backdrop-filter:
            blur(25px) !important;

        -webkit-backdrop-filter:
            blur(25px) !important;

        border-bottom:
            1px solid
            rgba(255,255,255,.12) !important;

        box-shadow:
            0 25px 60px
            rgba(0,0,0,.75) !important;

        display: flex !important;

        flex-direction: column !important;

        align-items: stretch !important;

        justify-content: flex-start !important;

        gap: 0 !important;

        margin: 0 !important;

        /*
           CLOSED STATE
        */
        opacity: 0 !important;

        visibility: hidden !important;

        pointer-events: none !important;

        transform:
            translateY(-15px) !important;

        transition:
            opacity .25s ease,
            transform .25s ease,
            visibility .25s ease !important;

        z-index: 1000000 !important;
    }


    /* =====================================================
       OPEN STATE
    ===================================================== */

    .nav-links.show {

        display: flex !important;

        opacity: 1 !important;

        visibility: visible !important;

        pointer-events: auto !important;

        transform:
            translateY(0) !important;

        z-index: 1000000 !important;
    }


    /* =====================================================
       MOBILE NAV LINKS
    ===================================================== */

    .nav-links a {

        display: flex !important;

        align-items: center;

        width: 100% !important;

        min-height: 52px;

        padding:
            14px 4px !important;

        font-size: 14px !important;

        font-weight: 600;

        color: #bdbdbd !important;

        border-bottom:
            1px solid
            rgba(255,255,255,.08);

        position: relative;
    }

    .nav-links a:last-child {

        border-bottom: none;
    }

    .nav-links a:hover,
    .nav-links a.active {

        color:
            #ffffff !important;
    }


    /* Orange left indicator */

    .nav-links a::before {

        content: "";

        width: 0;

        height: 2px;

        background:
            var(--orange);

        position: absolute;

        left: 0;

        bottom: 0;

        transition: .25s ease;
    }

    .nav-links a:hover::before,
    .nav-links a.active::before {

        width: 45px;
    }


    /* Desktop underline remove */

    .nav-links a::after {

        display: none !important;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .hero {

        width: 100%;

        min-height: auto;

        padding:
            125px 5% 70px;

        grid-template-columns: 1fr;

        gap: 45px;

        text-align: center;

        z-index: 1;
    }

    .hero-content {

        max-width: 100%;

        text-align: center;
    }

    .eyebrow {

        justify-content: center;
    }

    .hero h1 {

        font-size:
            clamp(48px, 14vw, 75px);

        line-height: .92;

        letter-spacing: -4px;
    }

    .hero p {

        max-width: 600px;

        margin:
            0 auto 30px;

        font-size: 13px;
    }

    .hero-video {

        width: 100%;

        max-width: none;

        margin: 0 auto;

        border-radius: 14px;
    }


    /* =====================================================
       COLLECTION
    ===================================================== */

    .collection {

        padding:
            80px 5% 90px;
    }

    .section-top {

        display: block;
    }

    .section-heading {

        max-width: 100%;
    }

    .section-heading h2 {

        letter-spacing: -3px;
    }

    .filters {

        margin-top: 30px;
    }

    .video-grid {

        grid-template-columns: 1fr;

        gap: 28px;
