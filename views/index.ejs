<style>
/* Flash Message */
.flash-message.success {
    color: white;
    border-left: 5px solid #dc2626;
}

.flash-message.error {
    color: white;
    border-left: 5px solid #dc2626;
}




.flash-message {
    position: fixed;
    top: 90px;
    right: 25px;
    z-index: 99999;

    min-width: 280px;
    max-width: 380px;

    padding: 15px 20px;
    border-radius: 10px;

    background: #dc2626;
   
    color: #ffffff;
    border-left: 5px solid #dc2626;

    font-size: 15px;
    font-weight: 600;

    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.18);

    animation: flashIn 0.3s ease;
}

@keyframes flashIn {
    from {
        opacity: 0;
        transform: translateX(40px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}
</style>


























