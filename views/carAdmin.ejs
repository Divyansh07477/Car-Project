  <!-- ======================= JS =========================== -->
  <!-- ===================================================== -->

  <script>

    /* =====================================================
       GLOBAL VARIABLES
    ===================================================== */

    let carToEdit = null;

    let carToDelete = null;

    let isAddingCar = false;

    let isEditingCar = false;

    let isDeletingCar = false;


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const addCarForm =
      document.getElementById("addCarForm");

    const addCarBtn =
      document.getElementById("addCarBtn");

    const carImage =
      document.getElementById("carImage");

    const imagePreview =
      document.getElementById("imagePreview");

    const uploadPlaceholder =
      document.getElementById("uploadPlaceholder");


    const editCarForm =
      document.getElementById("editCarForm");

    const editCarImage =
      document.getElementById("editCarImage");

    const editImagePreview =
      document.getElementById("editImagePreview");

    const editImagePlaceholder =
      document.getElementById("editImagePlaceholder");

    const editImageLabel =
      document.getElementById("editImageLabel");

    const saveEditBtn =
      document.getElementById("saveEditBtn");


    const confirmDeleteBtn =
      document.getElementById("confirmDeleteBtn");


    const tableBody =
      document.getElementById("carsTableBody");


    /* =====================================================
       LUCIDE
    ===================================================== */

    lucide.createIcons();


    /* =====================================================
       FLASH MESSAGE
    ===================================================== */

    let flashTimer = null;


    function showFlash(
      message,
      type = "success"
    ) {

      // Remove existing flash

      const oldFlash =
        document.querySelector(
          ".flash-message"
        );

      if (oldFlash) {
        oldFlash.remove();
      }


      if (flashTimer) {
        clearTimeout(flashTimer);
      }


      const flash =
        document.createElement("div");


      flash.className =
        `flash-message ${type}`;


      flash.innerText =
        message;


      document.body.appendChild(
        flash
      );


      requestAnimationFrame(() => {

        flash.classList.add(
          "show"
        );

      });


      flashTimer =
        setTimeout(() => {

          flash.classList.remove(
            "show"
          );


          setTimeout(() => {

            if (flash.parentNode) {
              flash.remove();
            }

          }, 400);

        }, 1200);
    }



    /* =====================================================
       MODALS
    ===================================================== */

    function openModal(id) {

      const modal =
        document.getElementById(id);


      if (modal) {

        modal.classList.remove(
          "hidden"
        );

        lucide.createIcons();
      }
    }


    function closeModal(id) {

      const modal =
        document.getElementById(id);


      if (modal) {

        modal.classList.add(
          "hidden"
        );
      }
    }



    /* =====================================================
       ADD IMAGE PREVIEW
    ===================================================== */

    if (carImage) {

      carImage.addEventListener(
        "change",
        function () {

          const file =
            this.files[0];


          if (!file) {
            return;
          }


          if (
            !file.type.startsWith(
              "image/"
            )
          ) {

            showFlash(
              "Please select a valid image.",
              "error"
            );

            carImage.value = "";

            return;
          }


          if (
            file.size >
            5 * 1024 * 1024
          ) {

            showFlash(
              "Image size must be less than 5MB.",
              "error"
            );

            carImage.value = "";

            return;
          }


          imagePreview.src =
            URL.createObjectURL(
              file
            );


          imagePreview.classList.remove(
            "hidden"
          );


          uploadPlaceholder.classList.add(
            "hidden"
          );

        }
      );
    }



    /* =====================================================
       ADD CAR
       
       IMPORTANT:
       onsubmit + isAddingCar prevents duplicate requests.
    ===================================================== */

    if (addCarForm) {

      addCarForm.onsubmit =
        async function (e) {

          e.preventDefault();


          // HARD STOP

          if (isAddingCar) {
            return;
          }


          const imageFile =
            carImage.files[0];


          if (!imageFile) {

            showFlash(
              "Please select a car image.",
              "error"
            );

            return;
          }


          const name =
            document
              .getElementById("carName")
              .value
              .trim();


          const category =
            document
              .getElementById("carCategory")
              .value;


          const transmission =
            document
              .getElementById("carTransmission")
              .value;


          const price =
            document
              .getElementById("carPrice")
              .value;


          if (
            !name ||
            !category ||
            !transmission ||
            !price
          ) {

            showFlash(
              "Please fill all required fields.",
              "error"
            );

            return;
          }


          // LOCK IMMEDIATELY

          isAddingCar = true;


          addCarBtn.disabled = true;

          addCarBtn.innerText =
            "Adding...";

          addCarBtn.classList.add(
            "opacity-70",
            "cursor-not-allowed"
          );


          const formData =
            new FormData();


          formData.append(
            "name",
            name
          );


          formData.append(
            "category",
            category
          );


          formData.append(
            "transmission",
            transmission
          );


          formData.append(
            "pricePerDay",
            price
          );


          formData.append(
            "image",
            imageFile
          );


          try {

            const response =
              await fetch(
                "/api/cars",
                {
                  method: "POST",
                  body: formData,
                  credentials: "include"
                }
              );


            const data =
              await response.json();


            if (!response.ok) {

              throw new Error(
                data.message ||
                "Failed to add car."
              );
            }


            showFlash(
              "Car added successfully.",
              "success"
            );


            // Reset

            addCarForm.reset();


            imagePreview.src =
              "";

            imagePreview.classList.add(
              "hidden"
            );

            uploadPlaceholder.classList.remove(
              "hidden"
            );


            closeModal(
              "carModal"
            );


            // Reload

           loadMyCars();

          } catch (error) {

            console.error(
              "Add Car Error:",
              error
            );


            showFlash(
              error.message ||
              "Server error. Please try again.",
              "error"
            );

          } finally {

            isAddingCar =
              false;


            addCarBtn.disabled =
              false;


            addCarBtn.innerText =
              "Add Car";


            addCarBtn.classList.remove(
              "opacity-70",
              "cursor-not-allowed"
            );

          }

        };
    }



    /* =====================================================
       EDIT MODAL
    ===================================================== */

    function openEditModal(
      carId,
      name,
      category,
      transmission,
      price,
      image
    ) {

      carToEdit =
        carId;


      document.getElementById(
        "editCarName"
      ).value =
        name;


      document.getElementById(
        "editCarCategory"
      ).value =
        category;


      document.getElementById(
        "editCarTransmission"
      ).value =
        transmission;


      document.getElementById(
        "editCarPrice"
      ).value =
        price;


      // Clear NEW image

      editCarImage.value =
        "";


      // Show OLD image

      if (image) {

        editImagePreview.src =
          image;


        editImagePreview.classList.remove(
          "hidden"
        );


        editImagePlaceholder.classList.add(
          "hidden"
        );


        editImageLabel.innerText =
          "Change image (optional)";

      } else {

        editImagePreview.src =
          "";


        editImagePreview.classList.add(
          "hidden"
        );


        editImagePlaceholder.classList.remove(
          "hidden"
        );


        editImageLabel.innerText =
          "Upload image (optional)";
      }


      openModal(
        "editCarModal"
      );
    }



    /* =====================================================
       EDIT IMAGE PREVIEW
    ===================================================== */

    if (editCarImage) {

      editCarImage.addEventListener(
        "change",
        function () {

          const file =
            this.files[0];


          if (!file) {
            return;
          }


          if (
            !file.type.startsWith(
              "image/"
            )
          ) {

            showFlash(
              "Please select a valid image.",
              "error"
            );

            editCarImage.value =
              "";

            return;
          }


          if (
            file.size >
            5 * 1024 * 1024
          ) {

            showFlash(
              "Image size must be less than 5MB.",
              "error"
            );

            editCarImage.value =
              "";

            return;
          }


          // NEW IMAGE PREVIEW

          editImagePreview.src =
            URL.createObjectURL(
              file
            );


          editImagePreview.classList.remove(
            "hidden"
          );


          editImagePlaceholder.classList.add(
            "hidden"
          );


          editImageLabel.innerText =
            "New image selected";

        }
      );
    }



    /* =====================================================
       EDIT API
    ===================================================== */

    if (editCarForm) {

      editCarForm.onsubmit =
        async function (e) {

          e.preventDefault();


          // Prevent duplicate request

          if (isEditingCar) {
            return;
          }


          if (!carToEdit) {

            showFlash(
              "Car not selected.",
              "error"
            );

            return;
          }


          const name =
            document
              .getElementById(
                "editCarName"
              )
              .value
              .trim();


          const category =
            document
              .getElementById(
                "editCarCategory"
              )
              .value;


          const transmission =
            document
              .getElementById(
                "editCarTransmission"
              )
              .value;


          const price =
            document
              .getElementById(
                "editCarPrice"
              )
              .value;


          const imageFile =
            editCarImage.files[0];


          if (
            !name ||
            !category ||
            !transmission ||
            !price
          ) {

            showFlash(
              "Please fill all required fields.",
              "error"
            );

            return;
          }


          // LOCK

          isEditingCar =
            true;


          saveEditBtn.disabled =
            true;


          saveEditBtn.innerText =
            "Saving...";


          saveEditBtn.classList.add(
            "opacity-70",
            "cursor-not-allowed"
          );


          const formData =
            new FormData();


          formData.append(
            "name",
            name
          );


          formData.append(
            "category",
            category
          );


          formData.append(
            "transmission",
            transmission
          );


          formData.append(
            "pricePerDay",
            price
          );


          /*
            IMPORTANT:

            New image selected:
            send image.

            No new image:
            don't send image.

            Backend will keep old image.
          */

          if (imageFile) {

            formData.append(
              "image",
              imageFile
            );
          }


          try {

            const response =
              await fetch(
                `/api/cars/${carToEdit}`,
                {
                  method: "PUT",
                  body: formData,
                  credentials: "include"
                }
              );


            const data =
              await response.json();


            if (!response.ok) {

              throw new Error(
                data.message ||
                "Failed to update car."
              );
            }


            showFlash(
              "Car updated successfully.",
              "success"
            );


            closeModal(
              "editCarModal"
            );


            carToEdit =
              null;


            editCarForm.reset();


            editImagePreview.src =
              "";

            editImagePreview.classList.add(
              "hidden"
            );

            editImagePlaceholder.classList.remove(
              "hidden"
            );


            editImageLabel.innerText =
              "Change image (optional)";


            await loadMyCars();

          } catch (error) {

            console.error(
              "Update Car Error:",
              error
            );


            showFlash(
              error.message ||
              "Server error. Please try again.",
              "error"
            );

          } finally {

            isEditingCar =
              false;


            saveEditBtn.disabled =
              false;


            saveEditBtn.innerText =
              "Save Changes";


            saveEditBtn.classList.remove(
              "opacity-70",
              "cursor-not-allowed"
            );

          }

        };
    }



    /* =====================================================
       DELETE MODAL
    ===================================================== */

    function openDeleteModal(
      carId
    ) {

      carToDelete =
        carId;


      openModal(
        "deleteModal"
      );
    }



    /* =====================================================
       DELETE API
    ===================================================== */

    if (confirmDeleteBtn) {

      confirmDeleteBtn.onclick =
        async function () {

          if (isDeletingCar) {
            return;
          }


          if (!carToDelete) {

            showFlash(
              "Car not selected.",
              "error"
            );

            return;
          }


          isDeletingCar =
            true;


          confirmDeleteBtn.disabled =
            true;


          confirmDeleteBtn.innerText =
            "Deleting...";


          confirmDeleteBtn.classList.add(
            "opacity-70",
            "cursor-not-allowed"
          );


          try {

            const response =
              await fetch(
                `/api/cars/${carToDelete}`,
                {
                  method: "DELETE",
                  credentials: "include"
                }
              );


            const data =
              await response.json();


            if (!response.ok) {

              throw new Error(
                data.message ||
                "Failed to delete car."
              );
            }


            closeModal(
              "deleteModal"
            );


            showFlash(
              "Car deleted successfully.",
              "success"
            );


            carToDelete =
              null;


            await loadMyCars();

          } catch (error) {

            console.error(
              "Delete Car Error:",
              error
            );


            showFlash(
              error.message ||
              "Server error. Please try again.",
              "error"
            );

          } finally {

            isDeletingCar =
              false;


            confirmDeleteBtn.disabled =
              false;


            confirmDeleteBtn.innerText =
              "Delete";


            confirmDeleteBtn.classList.remove(
              "opacity-70",
              "cursor-not-allowed"
            );

          }

        };
    }



    /* =====================================================
       LOAD MY CARS
    ===================================================== */

    async function loadMyCars() {

      if (!tableBody) {
        return;
      }


      tableBody.innerHTML = `
        <tr>
          <td
            colspan="6"
            class="py-10 text-center text-slate-400"
          >
            Loading cars...
          </td>
        </tr>
      `;


      try {

        const response =
          await fetch(
            "/api/cars/my-cars",
            {
              method: "GET",
              credentials: "include"
            }
          );


        const data =
          await response.json();


        if (response.status === 401) {

          tableBody.innerHTML = `
            <tr>
              <td
                colspan="6"
                class="py-10 text-center text-slate-400"
              >
                Please login to manage your cars.
              </td>
            </tr>
          `;

          return;
        }


        if (!response.ok) {

          throw new Error(
            data.message ||
            "Failed to load cars."
          );
        }


        /*
          Backend normally returns:

          {
            cars: [...]
          }

          This also supports direct array
          response just in case.
        */

        const cars =
          Array.isArray(data)
            ? data
            : Array.isArray(data.cars)
              ? data.cars
              : [];


        if (cars.length === 0) {

          tableBody.innerHTML = `
            <tr>

              <td
                colspan="6"
                class="py-12 text-center"
              >

                <div
                  class="flex flex-col items-center"
                >

                  <i
                    data-lucide="car"
                    class="w-10 h-10 text-slate-300 mb-3"
                  ></i>

                  <p
                    class="text-sm font-semibold text-slate-500"
                  >
                    You have not added any rental cars yet.
                  </p>

                </div>

              </td>

            </tr>
          `;


          lucide.createIcons();

          return;
        }


        tableBody.innerHTML =
          "";


        cars.forEach(
          car => {

            const category =
              String(
                car.category || ""
              ).toLowerCase();


            const transmission =
              String(
                car.transmission || ""
              ).toLowerCase();


            const image =
              car.image || "";


            const row =
              document.createElement(
                "tr"
              );


            row.className =
              "hover:bg-slate-50/60 transition-colors";


            row.innerHTML = `

              <!-- IMAGE -->

              <td class="py-4 px-6">

                <img
                  src="${escapeAttribute(image)}"
                  alt="${escapeAttribute(car.name || "Car")}"
                  class="w-20 h-12 object-contain rounded-md bg-slate-50"
                  onerror="this.style.display='none'"
                >

              </td>


              <!-- NAME -->

              <td
                class="py-4 px-6 font-semibold text-[#08123B]"
              >

                ${escapeHTML(
                  car.name || "Unnamed Car"
                )}

              </td>


              <!-- CATEGORY -->

              <td class="py-4 px-6">

                <span
                  class="px-2.5 py-1 text-xs font-semibold text-[#FF532E] bg-[#FF532E]/10 rounded-full capitalize"
                >
                  ${escapeHTML(category)}
                </span>

              </td>


              <!-- TRANSMISSION -->

              <td class="py-4 px-6">

                <span
                  class="px-2.5 py-1 text-xs font-semibold text-blue-600 bg-blue-50 rounded-full capitalize"
                >
                  ${escapeHTML(transmission)}
                </span>

              </td>


              <!-- PRICE -->

              <td
                class="py-4 px-6 font-bold text-[#08123B]"
              >

                ₹${Number(
                  car.pricePerDay || 0
                ).toLocaleString("en-IN")}

                <span
                  class="text-xs font-normal text-slate-400"
                >
                  /day
                </span>

              </td>


              <!-- ACTIONS -->

              <td class="py-4 px-6">

                <div
                  class="flex items-center justify-center gap-2"
                >

                  <!-- EDIT -->

                  <button
                    type="button"
                    class="edit-car-btn p-1.5 text-blue-500 hover:bg-blue-50 rounded-lg transition-colors"
                    title="Edit Car"

                    data-id="${escapeAttribute(
                      car._id || ""
                    )}"

                    data-name="${encodeURIComponent(
                      car.name || ""
                    )}"

                    data-category="${escapeAttribute(
                      category
                    )}"

                    data-transmission="${escapeAttribute(
                      transmission
                    )}"

                    data-price="${escapeAttribute(
                      car.pricePerDay || ""
                    )}"

                    data-image="${escapeAttribute(
                      image
                    )}"
                  >

                    <i
                      data-lucide="edit-3"
                      class="w-4 h-4 pointer-events-none"
                    ></i>

                  </button>


                  <!-- DELETE -->

                  <button
                    type="button"
                    class="delete-car-btn p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors"
                    title="Delete Car"

                    data-id="${escapeAttribute(
                      car._id || ""
                    )}"
                  >

                    <i
                      data-lucide="trash-2"
                      class="w-4 h-4 pointer-events-none"
                    ></i>

                  </button>

                </div>

              </td>

            `;


            tableBody.appendChild(
              row
            );

          }
        );


        lucide.createIcons();

      } catch (error) {

        console.error(
          "Load My Cars Error:",
          error
        );


        tableBody.innerHTML = `
          <tr>

            <td
              colspan="6"
              class="py-10 text-center text-rose-500"
            >
              Server error. Unable to load your cars.
            </td>

          </tr>
        `;
      }
    }



    /* =====================================================
       ESCAPE HTML
    ===================================================== */

    function escapeHTML(
      value
    ) {

      return String(
        value
      )
        .replace(
          /&/g,
          "&amp;"
        )
        .replace(
          /</g,
          "&lt;"
        )
        .replace(
          />/g,
          "&gt;"
        )
        .replace(
          /"/g,
          "&quot;"
        )
        .replace(
          /'/g,
          "&#039;"
        );
    }


    function escapeAttribute(
      value
    ) {

      return escapeHTML(
        value
      );
    }



    /* =====================================================
       CAR ACTION EVENTS
       
       Event delegation:
       Edit/Delete buttons dynamic rows ke liye.
    ===================================================== */

    if (tableBody) {

      tableBody.onclick =
        function (e) {


          /* ================= EDIT ================= */

          const editButton =
            e.target.closest(
              ".edit-car-btn"
            );


          if (editButton) {

            openEditModal(

              editButton.dataset.id,

              decodeURIComponent(
                editButton.dataset.name ||
                ""
              ),

              editButton.dataset.category ||
              "",

              editButton.dataset.transmission ||
              "",

              editButton.dataset.price ||
              "",

              editButton.dataset.image ||
              ""
            );


            return;
          }



          /* ================= DELETE ================= */

          const deleteButton =
            e.target.closest(
              ".delete-car-btn"
            );


          if (deleteButton) {

            openDeleteModal(
              deleteButton.dataset.id
            );

          }

        };
    }



    /* =====================================================
       BACKDROP CLICK
    ===================================================== */

    window.addEventListener(
      "click",
      function (e) {

        if (
          e.target.classList.contains(
            "modal-backdrop"
          )
        ) {

          e.target.classList.add(
            "hidden"
          );

        }

      }
    );



    /* =====================================================
       ESC KEY
    ===================================================== */

    document.addEventListener(
      "keydown",
      function (e) {

        if (e.key === "Escape") {

          closeModal(
            "carModal"
          );

          closeModal(
            "editCarModal"
          );

          closeModal(
            "deleteModal"
          );

        }

      }
    );



    /* =====================================================
       PAGE LOAD
    ===================================================== */

    document.addEventListener(
      "DOMContentLoaded",
      function () {

        loadMyCars();

        lucide.createIcons();

      }
    );

  </script>

</body>

</html>
