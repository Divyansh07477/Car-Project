          Add a new rental car to your fleet
        </p>

      </div>


      <form id="addCarForm" class="space-y-3.5">


        <!-- CAR NAME -->

        <div class="relative">

          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">

            <i data-lucide="car" class="w-4 h-4"></i>

