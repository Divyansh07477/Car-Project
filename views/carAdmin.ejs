          </span>
          <input id="carName" type="text" name="name" placeholder="Car Name (e.g. Rolls-Royce)" class="w-full pl-10 pr-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] text-slate-700 transition" required>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
              <i data-lucide="layout-grid" class="w-4 h-4"></i>
            </span>
            <select id="carCategory" name="category" class="w-full pl-10 pr-8 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] text-slate-700 bg-white appearance-none cursor-pointer" required>
              <option value="sedan">Sedan</option>
              <option value="suv">SUV</option>
              <option value="hatchback">Hatchback</option>
              <option value="sports">Sports</option>
              <option value="luxury">Luxury</option>
            </select>
          </div>

          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
              <i data-lucide="settings" class="w-4 h-4"></i>
            </span>
            <select id="carTransmission" name="transmission" class="w-full pl-10 pr-8 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] text-slate-700 bg-white appearance-none cursor-pointer" required>
              <option value="automatic">Automatic</option>
              <option value="manual">Manual</option>
            </select>
          </div>
        </div>

        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            <i data-lucide="circle-dollar-sign" class="w-4 h-4"></i>
          </span>
          <input id="carPrice" type="number" name="pricePerDay" placeholder="Price per day (e.g. 299)" class="w-full pl-10 pr-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] text-slate-700 transition" min="0" required>
        </div>

        <label class="relative flex flex-col items-center justify-center w-full h-28 border-2 border-dashed border-slate-200 rounded-xl cursor-pointer hover:border-[#FF462D]/60 bg-slate-50/50 hover:bg-orange-50/20 transition group overflow-hidden">
