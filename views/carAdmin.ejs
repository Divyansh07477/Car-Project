            required />

        </div>


        <!-- CATEGORY + TRANSMISSION -->

        <div class="grid grid-cols-2 gap-3">

          <div class="relative">

            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">

              <i data-lucide="layout-grid" class="w-4 h-4"></i>

            </span>

            <select
              id="carCategory"
