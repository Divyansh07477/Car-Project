    /* ================= FLASH MESSAGE ================= */

    .flash-message {

      position: fixed;

      top: 25px;
      right: 25px;

      min-width: 280px;
      max-width: 380px;

      padding: 15px 20px;

      border-radius: 10px;

      color: #ffffff;

      font-size: 15px;
      font-weight: 600;

      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);

      z-index: 999999;

      opacity: 0;
      visibility: hidden;

      transform: translateX(120%);

      transition:
        opacity 0.35s ease,
        transform 0.35s ease,
        visibility 0.35s ease;

      display: flex;
      align-items: center;
    }


    .flash-message.success {
      background: #16a34a;
    }


    .flash-message.error {
      background: #dc2626;
    }


    .flash-message.show {

      opacity: 1;

      visibility: visible;

      transform: translateX(0);
    }


    .flash-message::before {

      content: "✓";

      display: inline-flex;

      align-items: center;
      justify-content: center;

      width: 25px;
      height: 25px;

      min-width: 25px;

      margin-right: 10px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.2);

      font-size: 15px;
    }


    .flash-message.error::before {
      content: "!";
    }


    @media (max-width: 500px) {

      .flash-message {

        top: 15px;

        left: 15px;
        right: 15px;

        min-width: auto;
        max-width: none;

        width: auto;

        font-size: 14px;

        padding: 14px 16px;
      }

    }

  </style>

