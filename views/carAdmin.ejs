            class="w-full pl-10 pr-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF532E] focus:ring-1 focus:ring-[#FF532E] text-slate-700 transition" />

        </div>


        <!-- EDIT IMAGE -->

        <label
          class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-slate-200 rounded-xl cursor-pointer hover:border-[#FF532E]/60 bg-slate-50/50 hover:bg-orange-50/20 transition group">

          <div class="flex flex-col items-center justify-center py-2">

            <i
              data-lucide="cloud-upload"
              class="w-6 h-6 text-slate-400 group-hover:text-[#FF532E] transition-colors mb-1">
            </i>

            <p class="text-xs font-semibold text-slate-700">
              Change image (optional)
            </p>

            <p class="text-[10px] text-slate-400">
              Leave blank to keep existing image
            </p>

          </div>

          <input
            type="file"
            class="hidden"
            accept="image/png, image/jpeg, image/webp" />

        </label>


        <div class="flex gap-3 pt-2">

          <button
            type="button"
            onclick="closeModal('editCarModal')"
            class="w-1/2 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-sm transition">

            Cancel

          </button>

          <button
            type="submit"
            class="w-1/2 py-2.5 bg-[#FF532E] hover:bg-[#e04522] text-white font-semibold rounded-xl text-sm shadow-md shadow-[#FF532E]/25 transition">

            Save Changes

          </button>

        </div>

      </form>

    </div>

  </div>


  <!-- ================= DELETE MODAL ================= -->

  <div
    id="deleteModal"
    class="modal-backdrop fixed inset-0 z-50 hidden bg-[#08123B]/60 backdrop-blur-sm flex items-center justify-center p-4">

    <div
      class="w-full max-w-[360px] bg-white rounded-2xl shadow-2xl p-6 text-center border border-slate-100">

      <div class="w-12 h-12 rounded-full bg-[#FF532E]/10 flex items-center justify-center mx-auto mb-4 text-[#FF532E]">

        <i data-lucide="trash-2" class="w-6 h-6"></i>

      </div>

      <h3 class="text-lg font-bold text-[#08123B]">
        Delete Rental Car?
      </h3>

      <p class="text-xs text-slate-500 mt-2 px-2 leading-relaxed">
        This action cannot be undone. The car will be permanently removed.
      </p>

      <div class="flex gap-3 mt-6">

        <button
          type="button"
          onclick="closeModal('deleteModal')"
          class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-sm transition">

          Cancel

        </button>

        <button
          type="button"
          onclick="confirmDelete()"
          class="flex-1 py-2.5 rounded-xl bg-[#FF532E] hover:bg-[#e04522] text-white font-semibold text-sm shadow-md shadow-[#FF532E]/20 transition">

          Delete

        </button>

      </div>

    </div>

  </div>

<!-- ================= JAVASCRIPT ================= -->

<script>

  /* ================= LUCIDE ICONS ================= */

  lucide.createIcons();


  /* ================= ADD CAR FORM ================= */

  const addCarForm =
    document.getElementById("addCarForm");

  const carImage =
    document.getElementById("carImage");

  const imagePreview =
    document.getElementById("imagePreview");

  const uploadPlaceholder =
    document.getElementById("uploadPlaceholder");


  /* ================= FLASH MESSAGE ================= */

  function showFlash(message, type = "success") {

    const flash =
      document.createElement("div");

    flash.className =
      `flash-message ${type}`;

    flash.innerText = message;

    document.body.appendChild(flash);


    /* Show immediately */

    requestAnimationFrame(() => {

      flash.classList.add("show");

    });


    /* Remove after 3 seconds */

    setTimeout(() => {

      flash.classList.remove("show");

      setTimeout(() => {

        flash.remove();

      }, 400);

    }, 2000);

  }



































  /* ================= IMAGE PREVIEW ================= */

  if (carImage) {

    carImage.addEventListener("change", function () {

      const file = this.files[0];


      if (!file) {

        return;

      }


      /* ================= FILE TYPE CHECK ================= */

      if (!file.type.startsWith("image/")) {

        showFlash(
          "Please select a valid image.",
          "error"
        );

        carImage.value = "";

        return;

      }


      /* ================= FILE SIZE CHECK ================= */

      if (file.size > 5 * 1024 * 1024) {

        showFlash(
          "Image size must be less than 5MB.",
          "error"
        );

        carImage.value = "";

        return;

      }


      /* ================= IMAGE PREVIEW ================= */

      const imageURL =
        URL.createObjectURL(file);

      imagePreview.src = imageURL;


      /* Hide upload text */

      uploadPlaceholder.classList.add("hidden");


      /* Show preview */

      imagePreview.classList.remove("hidden");

    });

  }


  /* ================= ADD CAR TO BACKEND ================= */

  if (addCarForm) {

    addCarForm.addEventListener(
      "submit",
      async (e) => {

        e.preventDefault();


        /* ================= GET IMAGE ================= */

        const imageFile =
          document.getElementById(
            "carImage"
          ).files[0];


        /* ================= IMAGE REQUIRED ================= */

        if (!imageFile) {

          showFlash(
            "Please select a car image.",
            "error"
          );

          return;

        }


        /* ================= FORM DATA ================= */

        const formData =
          new FormData();


        formData.append(
          "name",
          document
            .getElementById("carName")
            .value
            .trim()
        );


        formData.append(
          "category",
          document
            .getElementById("carCategory")
            .value
        );


        formData.append(
          "transmission",
          document
            .getElementById("carTransmission")
            .value
        );


        formData.append(
          "pricePerDay",
          document
            .getElementById("carPrice")
            .value
        );


        /* ================= IMAGE ================= */

        formData.append(
          "image",
          imageFile
        );


        /* ================= SEND TO BACKEND ================= */

        try {

          const response =
            await fetch(
              "/api/cars",
              {

                method: "POST",

                body: formData,

                credentials: "include"

              }
            );


          const data =
            await response.json();


          /* ================= ERROR ================= */

          if (!response.ok) {

            showFlash(
              data.message ||
              "Failed to add car.",
              "error"
            );

            return;

          }


          /* ================= SUCCESS ================= */

          showFlash(
            "Car added successfully ",
            "success"
          );


          /* ================= RESET FORM ================= */

          addCarForm.reset();


          /* ================= RESET IMAGE ================= */

          imagePreview.src = "";

          imagePreview.classList.add(
            "hidden"
          );

          uploadPlaceholder.classList.remove(
            "hidden"
          );


          /* ================= CLOSE MODAL ================= */

          closeModal("carModal");


        } catch (error) {

          console.error(
            "Add car error:",
            error
          );


          showFlash(
            "Server error. Please try again.",
            "error"
          );

        }

      }
    );

  }


  /* ================= MODAL FUNCTIONS ================= */

  function openModal(id) {

    document
      .getElementById(id)
      .classList.remove("hidden");

  }


  function closeModal(id) {

    document
      .getElementById(id)
      .classList.add("hidden");

  }


  /* ================= EDIT MODAL ================= */

  function openEditModal(
    name,
    category,
    transmission,
    price
  ) {

    document.getElementById(
      "editCarName"
    ).value = name;


    document.getElementById(
      "editCarCategory"
    ).value = category;


    document.getElementById(
      "editCarTransmission"
    ).value = transmission;


    document.getElementById(
      "editCarPrice"
    ).value = price;


    openModal(
      "editCarModal"
    );

  }


  /* ================= DELETE MODAL ================= */

  function openDeleteModal() {

    openModal(
      "deleteModal"
    );

  }


  function confirmDelete() {

    /* Backend delete API can be added here later */

    closeModal(
      "deleteModal"
    );

  }


  /* ================= BACKDROP CLICK ================= */

  window.addEventListener(
    "click",
    (e) => {

      if (
        e.target.classList.contains(
          "modal-backdrop"
        )
      ) {

        e.target.classList.add(
          "hidden"
        );

      }

    }
  );

</script>

</body>
</html>
