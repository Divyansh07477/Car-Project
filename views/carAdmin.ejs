<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RideWave Admin - Rental Cars</title>
  <link rel="icon" type="image/png" href="/images/title.png.jpeg">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
 <link
        rel="stylesheet"
        href="/css/style.css"
    >
  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      min-height: 100%;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .sidebar-link {
      transition: all 0.2s ease;
    }

    .sidebar-link:hover {
      transform: translateX(2px);
    }

    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      width: 256px;
      overflow-y: auto;
      overflow-x: hidden;
      z-index: 50;
    }

    .main-content {
      margin-left: 256px;
      min-height: 100vh;
    }

    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }

    ::-webkit-scrollbar-track {
      background: #f8fafc;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 20px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    .sidebar::-webkit-scrollbar-track {
      background: #0B1536;
    }

    .sidebar::-webkit-scrollbar-thumb {
      background: #24345e;
    }

    @media (max-width: 900px) {
      .sidebar {
        width: 220px;
      }
      .main-content {
        margin-left: 220px;
      }
    }

    @media (max-width: 700px) {
      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
      }
      .main-content {
        margin-left: 0;
      }
    }

    /* Flash Message */
    .flash-message {
      position: fixed;
      top: 25px;
      right: 25px;
      min-width: 280px;
      max-width: 380px;
      padding: 15px 20px;
      border-radius: 10px;
      color: #ffffff;
      font-size: 15px;
      font-weight: 600;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
      z-index: 999999;
      opacity: 0;
      visibility: hidden;
      transform: translateX(120%);
      transition: opacity 0.35s ease, transform 0.35s ease, visibility 0.35s ease;
      display: flex;
      align-items: center;
    }

    .flash-message.success {
      background: #16a34a;
    }

    .flash-message.error {
      background: #dc2626;
    }

    .flash-message.show {
      opacity: 1;
      visibility: visible;
      transform: translateX(0);
    }

    .flash-message::before {
      content: "✓";
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 25px;
      height: 25px;
      min-width: 25px;
      margin-right: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      font-size: 15px;
    }

    .flash-message.error::before {
      content: "!";
    }

       







  </style>
</head>

<body class="bg-[#F8FAFC] text-slate-800">

  <!-- ================= FIXED SIDEBAR ================= -->
  <aside class="sidebar bg-[#0B1536] text-white flex flex-col justify-between p-6">
    <div>
      <!-- LOGO -->
      <div class="flex items-center gap-2 mb-10">
        <span class="text-2xl font-bold tracking-tight text-white">
          Ride<span class="text-[#FF462D]">Wave</span>
        </span>
        <span class="bg-[#FF462D]/15 text-[#FF462D] text-[10px] font-bold px-2 py-0.5 rounded tracking-wider uppercase">
          ADMIN
        </span>
      </div>

      <!-- NAVIGATION -->
      <div class="space-y-6">
        <div>
          <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">
            Main
          </p>

          <nav class="space-y-1.5">
            <!-- DASHBOARD -->
            <a href="/admin" class="sidebar-link flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium">
              <i data-lucide="layout-grid" class="w-5 h-5"></i>
