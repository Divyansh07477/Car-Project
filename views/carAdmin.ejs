  <!-- ================= MAIN CONTENT ================= -->
  <main class="main-content flex-1 p-8 lg:p-10 overflow-y-auto">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold text-[#08123B]">Rental Cars</h1>
        <p class="text-sm text-slate-500 mt-0.5">Manage your fleet of rental vehicles.</p>
      </div>

      <button type="button" onclick="openModal('carModal')" class="inline-flex items-center justify-center gap-2 bg-[#FF462D] hover:bg-[#e03e27] text-white font-medium px-5 py-2.5 rounded-xl transition-all shadow-md shadow-[#FF462D]/25">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Add New Car</span>
      </button>
    </div>

    <!-- CAR TABLE -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
