      <button type="button" onclick="closeModal('editCarModal')" class="absolute top-5 right-5 w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 transition">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-[#08123B]">Edit <span class="text-[#FF462D]">Car</span></h2>
        <p class="text-xs text-slate-400 mt-1">Update rental car details and pricing</p>
      </div>

      <form id="editCarForm" class="space-y-3.5">
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            <i data-lucide="car" class="w-4 h-4"></i>
          </span>
          <input id="editCarName" type="text" placeholder="Car Name" class="w-full pl-10 pr-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] text-slate-700 transition" required>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <select id="editCarCategory" class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] text-slate-700 bg-white" required>
            <option value="sedan">Sedan</option>
            <option value="suv">SUV</option>
            <option value="hatchback">Hatchback</option>
            <option value="sports">Sports</option>
            <option value="luxury">Luxury</option>
          </select>

          <select id="editCarTransmission" class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] text-slate-700 bg-white" required>
            <option value="automatic">Automatic</option>
            <option value="manual">Manual</option>
          </select>
        </div>

        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            <i data-lucide="circle-dollar-sign" class="w-4 h-4"></i>
          </span>
          <input id="editCarPrice" type="number" min="0" placeholder="Price per day" class="w-full pl-10 pr-3.5 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] text-slate-700 transition" required>
        </div>

        <div class="relative w-full h-32 rounded-xl overflow-hidden bg-slate-50 border border-slate-200">
          <img id="editImagePreview" src="" alt="Current Car Image" class="hidden w-full h-full object-cover">
          <div id="editImagePlaceholder" class="absolute inset-0 flex flex-col items-center justify-center text-slate-400">
            <i data-lucide="image" class="w-7 h-7 mb-1"></i>
            <span class="text-xs">Current image</span>
          </div>
        </div>

        <label class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-slate-200 rounded-xl cursor-pointer hover:border-[#FF462D]/60 bg-slate-50/50 hover:bg-orange-50/20 transition group">
          <div class="flex flex-col items-center justify-center py-2">
            <i data-lucide="cloud-upload" class="w-6 h-6 text-slate-400 group-hover:text-[#FF462D] transition-colors mb-1"></i>
            <p id="editImageLabel" class="text-xs font-semibold text-slate-700">Change image (optional)</p>
            <p class="text-[10px] text-slate-400">Leave blank to keep existing image</p>
          </div>
          <input id="editCarImage" type="file" class="hidden" accept="image/png, image/jpeg, image/webp">
        </label>

        <div class="flex gap-3 pt-2">
          <button type="button" onclick="closeModal('editCarModal')" class="w-1/2 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-sm transition">Cancel</button>
          <button id="saveEditBtn" type="submit" class="w-1/2 py-2.5 bg-[#FF462D] hover:bg-[#e03e27] text-white font-semibold rounded-xl text-sm shadow-md shadow-[#FF462D]/25 transition">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= DELETE MODAL ================= -->
  <div id="deleteModal" class="modal-backdrop fixed inset-0 z-50 hidden bg-[#08123B]/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-[360px] bg-white rounded-2xl shadow-2xl p-6 text-center border border-slate-100">
      <div class="w-12 h-12 rounded-full bg-[#FF462D]/10 flex items-center justify-center mx-auto mb-4 text-[#FF462D]">
        <i data-lucide="trash-2" class="w-6 h-6"></i>
      </div>
      <h3 class="text-lg font-bold text-[#08123B]">Delete Rental Car?</h3>
      <p class="text-xs text-slate-500 mt-2 px-2 leading-relaxed">This action cannot be undone. The car will be permanently removed.</p>
      <div class="flex gap-3 mt-6">
        <button type="button" onclick="closeModal('deleteModal')" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-sm transition">Cancel</button>
        <button id="confirmDeleteBtn" type="button" class="flex-1 py-2.5 rounded-xl bg-[#FF462D] hover:bg-[#e03e27] text-white font-semibold text-sm shadow-md shadow-[#FF462D]/20 transition">Delete</button>
      </div>
    </div>
  </div>

  <!-- ================= JS ================= -->
  <script>
    let carToEdit = null;
    let carToDelete = null;
    let isAddingCar = false;
    let isEditingCar = false;
    let isDeletingCar = false;

    const addCarForm = document.getElementById("addCarForm");
    const addCarBtn = document.getElementById("addCarBtn");
    const carImage = document.getElementById("carImage");
    const imagePreview = document.getElementById("imagePreview");
    const uploadPlaceholder = document.getElementById("uploadPlaceholder");

    const editCarForm = document.getElementById("editCarForm");
    const editCarImage = document.getElementById("editCarImage");
    const editImagePreview = document.getElementById("editImagePreview");
    const editImagePlaceholder = document.getElementById("editImagePlaceholder");
    const editImageLabel = document.getElementById("editImageLabel");
    const saveEditBtn = document.getElementById("saveEditBtn");

    const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
    const tableBody = document.getElementById("carsTableBody");

    lucide.createIcons();

    let flashTimer = null;
    function showFlash(message, type = "success") {
      const oldFlash = document.querySelector(".flash-message");
      if (oldFlash) oldFlash.remove();
      if (flashTimer) clearTimeout(flashTimer);

      const flash = document.createElement("div");
      flash.className = `flash-message ${type}`;
      flash.innerText = message;
      document.body.appendChild(flash);

      requestAnimationFrame(() => flash.classList.add("show"));
      flashTimer = setTimeout(() => {
        flash.classList.remove("show");
        setTimeout(() => { if (flash.parentNode) flash.remove(); }, 400);
      }, 1200);
    }

    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove("hidden");
        lucide.createIcons();
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.add("hidden");
    }

    if (carImage) {
      carImage.addEventListener("change", function () {
        const file = this.files[0];
        if (!file) return;

        if (!file.type.startsWith("image/")) {
          showFlash("Please select a valid image.", "error");
          carImage.value = "";
          return;
        }

        if (file.size > 5 * 1024 * 1024) {
          showFlash("Image size must be less than 5MB.", "error");
          carImage.value = "";
          return;
        }

        imagePreview.src = URL.createObjectURL(file);
        imagePreview.classList.remove("hidden");
        uploadPlaceholder.classList.add("hidden");
      });
    }

    if (addCarForm) {
      addCarForm.onsubmit = async function (e) {
        e.preventDefault();
        if (isAddingCar) return;

        const imageFile = carImage.files[0];
        if (!imageFile) {
          showFlash("Please select a car image.", "error");
          return;
        }

        const name = document.getElementById("carName").value.trim();
        const category = document.getElementById("carCategory").value;
        const transmission = document.getElementById("carTransmission").value;
        const price = document.getElementById("carPrice").value;

        if (!name || !category || !transmission || !price) {
          showFlash("Please fill all required fields.", "error");
          return;
        }

        isAddingCar = true;
        addCarBtn.disabled = true;
        addCarBtn.innerText = "Adding...";
        addCarBtn.classList.add("opacity-70", "cursor-not-allowed");

        const formData = new FormData();
        formData.append("name", name);
        formData.append("category", category);
        formData.append("transmission", transmission);
        formData.append("pricePerDay", price);
        formData.append("image", imageFile);

        try {
          const response = await fetch("/api/cars", {
            method: "POST",
            body: formData,
            credentials: "include"
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.message || "Failed to add car.");

          showFlash("Car added successfully.", "success");
          addCarForm.reset();
          imagePreview.src = "";
          imagePreview.classList.add("hidden");
          uploadPlaceholder.classList.remove("hidden");
          closeModal("carModal");
          loadMyCars();
        } catch (error) {
          console.error("Add Car Error:", error);
          showFlash(error.message || "Server error. Please try again.", "error");
        } finally {
          isAddingCar = false;
          addCarBtn.disabled = false;
          addCarBtn.innerText = "Add Car";
          addCarBtn.classList.remove("opacity-70", "cursor-not-allowed");
        }
      };
    }

    function openEditModal(carId, name, category, transmission, price, image) {
      carToEdit = carId;
      document.getElementById("editCarName").value = name;
      document.getElementById("editCarCategory").value = category;
      document.getElementById("editCarTransmission").value = transmission;
      document.getElementById("editCarPrice").value = price;
      editCarImage.value = "";

      if (image) {
        editImagePreview.src = image;
        editImagePreview.classList.remove("hidden");
        editImagePlaceholder.classList.add("hidden");
        editImageLabel.innerText = "Change image (optional)";
      } else {
        editImagePreview.src = "";
        editImagePreview.classList.add("hidden");
        editImagePlaceholder.classList.remove("hidden");
        editImageLabel.innerText = "Upload image (optional)";
      }
      openModal("editCarModal");
    }

    if (editCarImage) {
      editCarImage.addEventListener("change", function () {
        const file = this.files[0];
        if (!file) return;

        if (!file.type.startsWith("image/")) {
          showFlash("Please select a valid image.", "error");
          editCarImage.value = "";
          return;
        }

        if (file.size > 5 * 1024 * 1024) {
          showFlash("Image size must be less than 5MB.", "error");
          editCarImage.value = "";
          return;
        }

        editImagePreview.src = URL.createObjectURL(file);
        editImagePreview.classList.remove("hidden");
        editImagePlaceholder.classList.add("hidden");
        editImageLabel.innerText = "New image selected";
      });
    }

    if (editCarForm) {
      editCarForm.onsubmit = async function (e) {
        e.preventDefault();
        if (isEditingCar) return;
        if (!carToEdit) {
          showFlash("Car not selected.", "error");
          return;
        }

        const name = document.getElementById("editCarName").value.trim();
        const category = document.getElementById("editCarCategory").value;
        const transmission = document.getElementById("editCarTransmission").value;
        const price = document.getElementById("editCarPrice").value;
        const imageFile = editCarImage.files[0];

        if (!name || !category || !transmission || !price) {
          showFlash("Please fill all required fields.", "error");
          return;
        }

        isEditingCar = true;
        saveEditBtn.disabled = true;
        saveEditBtn.innerText = "Saving...";
        saveEditBtn.classList.add("opacity-70", "cursor-not-allowed");

        const formData = new FormData();
        formData.append("name", name);
        formData.append("category", category);
        formData.append("transmission", transmission);
        formData.append("pricePerDay", price);
        if (imageFile) formData.append("image", imageFile);

        try {
          const response = await fetch(`/api/cars/${carToEdit}`, {
            method: "PUT",
            body: formData,
            credentials: "include"
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.message || "Failed to update car.");

          showFlash("Car updated successfully.", "success");
          closeModal("editCarModal");
          carToEdit = null;
          editCarForm.reset();
          editImagePreview.src = "";
          editImagePreview.classList.add("hidden");
          editImagePlaceholder.classList.remove("hidden");
          editImageLabel.innerText = "Change image (optional)";
          await loadMyCars();
        } catch (error) {
          console.error("Update Car Error:", error);
          showFlash(error.message || "Server error. Please try again.", "error");
        } finally {
          isEditingCar = false;
          saveEditBtn.disabled = false;
          saveEditBtn.innerText = "Save Changes";
          saveEditBtn.classList.remove("opacity-70", "cursor-not-allowed");
        }
      };
    }

    function openDeleteModal(carId) {
      carToDelete = carId;
      openModal("deleteModal");
    }

    if (confirmDeleteBtn) {
      confirmDeleteBtn.onclick = async function () {
        if (isDeletingCar) return;
        if (!carToDelete) {
          showFlash("Car not selected.", "error");
          return;
        }

        isDeletingCar = true;
        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.innerText = "Deleting...";
        confirmDeleteBtn.classList.add("opacity-70", "cursor-not-allowed");

        try {
          const response = await fetch(`/api/cars/${carToDelete}`, {
            method: "DELETE",
            credentials: "include"
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.message || "Failed to delete car.");

          closeModal("deleteModal");
          showFlash("Car deleted successfully.", "success");
          carToDelete = null;
          await loadMyCars();
        } catch (error) {
          console.error("Delete Car Error:", error);
          showFlash(error.message || "Server error. Please try again.", "error");
        } finally {
          isDeletingCar = false;
          confirmDeleteBtn.disabled = false;
          confirmDeleteBtn.innerText = "Delete";
          confirmDeleteBtn.classList.remove("opacity-70", "cursor-not-allowed");
        }
      };
    }

    async function loadMyCars() {
      if (!tableBody) return;
      tableBody.innerHTML = `<tr><td colspan="6" class="py-10 text-center text-slate-400">Loading cars...</td></tr>`;

      try {
        const response = await fetch("/api/cars/my-cars", {
          method: "GET",
          credentials: "include"
        });
        const data = await response.json();

        if (response.status === 401) {
          tableBody.innerHTML = `<tr><td colspan="6" class="py-10 text-center text-slate-400">Please login to manage your cars.</td></tr>`;
          return;
        }

        if (!response.ok) throw new Error(data.message || "Failed to load cars.");

        const cars = Array.isArray(data) ? data : Array.isArray(data.cars) ? data.cars : [];

        if (cars.length === 0) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="6" class="py-12 text-center">
                <div class="flex flex-col items-center">
                  <i data-lucide="car" class="w-10 h-10 text-slate-300 mb-3"></i>
                  <p class="text-sm font-semibold text-slate-500">You have not added any rental cars yet.</p>
                </div>
              </td>
            </tr>`;
          lucide.createIcons();
          return;
        }

        tableBody.innerHTML = "";
        cars.forEach(car => {
          const category = String(car.category || "").toLowerCase();
          const transmission = String(car.transmission || "").toLowerCase();
          const image = car.image || "";

          const row = document.createElement("tr");
          row.className = "hover:bg-slate-50/60 transition-colors";
          row.innerHTML = `
            <td class="py-4 px-6">
              <img src="${escapeAttribute(image)}" alt="${escapeAttribute(car.name || "Car")}" class="w-20 h-12 object-contain rounded-md bg-slate-50" onerror="this.style.display='none'">
            </td>
            <td class="py-4 px-6 font-semibold text-[#08123B]">${escapeHTML(car.name || "Unnamed Car")}</td>
            <td class="py-4 px-6">
              <span class="px-2.5 py-1 text-xs font-semibold text-[#FF462D] bg-[#FF462D]/10 rounded-full capitalize">${escapeHTML(category)}</span>
            </td>
            <td class="py-4 px-6">
              <span class="px-2.5 py-1 text-xs font-semibold text-blue-600 bg-blue-50 rounded-full capitalize">${escapeHTML(transmission)}</span>
            </td>
            <td class="py-4 px-6 font-bold text-[#08123B]">
              ₹${Number(car.pricePerDay || 0).toLocaleString("en-IN")}
              <span class="text-xs font-normal text-slate-400">/day</span>
            </td>
            <td class="py-4 px-6">
              <div class="flex items-center justify-center gap-2">
                <button type="button" class="edit-car-btn p-1.5 text-blue-500 hover:bg-blue-50 rounded-lg transition-colors" title="Edit Car"
                  data-id="${escapeAttribute(car._id || "")}"
                  data-name="${encodeURIComponent(car.name || "")}"
                  data-category="${escapeAttribute(category)}"
                  data-transmission="${escapeAttribute(transmission)}"
                  data-price="${escapeAttribute(car.pricePerDay || "")}"
                  data-image="${escapeAttribute(image)}">
                  <i data-lucide="edit-3" class="w-4 h-4 pointer-events-none"></i>
                </button>
                <button type="button" class="delete-car-btn p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors" title="Delete Car"
                  data-id="${escapeAttribute(car._id || "")}">
                  <i data-lucide="trash-2" class="w-4 h-4 pointer-events-none"></i>
                </button>
              </div>
            </td>`;
          tableBody.appendChild(row);
        });
        lucide.createIcons();
      } catch (error) {
        console.error("Load My Cars Error:", error);
        tableBody.innerHTML = `<tr><td colspan="6" class="py-10 text-center text-rose-500">Server error. Unable to load your cars.</td></tr>`;
      }
    }

    function escapeHTML(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function escapeAttribute(value) {
      return escapeHTML(value);
    }

    if (tableBody) {
      tableBody.onclick = function (e) {
        const editButton = e.target.closest(".edit-car-btn");
        if (editButton) {
          openEditModal(
            editButton.dataset.id,
            decodeURIComponent(editButton.dataset.name || ""),
            editButton.dataset.category || "",
            editButton.dataset.transmission || "",
            editButton.dataset.price || "",
            editButton.dataset.image || ""
          );
          return;
        }

        const deleteButton = e.target.closest(".delete-car-btn");
        if (deleteButton) {
          openDeleteModal(deleteButton.dataset.id);
        }
      };
    }

    window.addEventListener("click", function (e) {
      if (e.target.classList.contains("modal-backdrop")) {
        e.target.classList.add("hidden");
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        closeModal("carModal");
        closeModal("editCarModal");
        closeModal("deleteModal");
      }
    });

    document.addEventListener("DOMContentLoaded", function () {
      loadMyCars();
      lucide.createIcons();
    });
  </script>
</body>
</html>