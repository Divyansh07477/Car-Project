<!-- ================= TEAM MODAL ================= -->

<div id="teamModal" class="team-modal">

    <div class="team-modal-box">

        <button
            type="button"
            id="closeTeamModal"
            class="team-modal-close">

            <i class="bx bx-x"></i>

        </button>


        <div class="team-modal-image">

            <img
                id="modalTeamImage"
                src=""
                alt="">

        </div>


        <div class="team-modal-content">

            <span
                id="modalTeamRole"
                class="modal-role">
            </span>


            <h2 id="modalTeamName"></h2>


            <p id="modalTeamDescription"></p>


            <div class="modal-details">

                <div>

                    <i class="bx bx-briefcase"></i>

                    <span id="modalTeamPosition"></span>

                </div>


                <div>

                    <i class="bx bx-car"></i>

                    <span>RideWave</span>

                </div>

            </div>


            <!-- =========================
                 MODAL SOCIAL LINKS
            ========================== -->

            <div class="modal-social">

                <a
                    id="modalFacebook"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer">

                    <i class="bx bxl-facebook"></i>

                </a>


                <a
                    id="modalGithub"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer">

                    <i class="bx bxl-github"></i>

                </a>


                <a
                    id="modalInstagram"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer">

                    <i class="bx bxl-instagram"></i>

                </a>


                <!-- TWITTER -->

                <a
                    id="modalTwitter"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer">

                    <i class="bx bxl-twitter"></i>

                </a>


                <a
                    id="modalLinkedin"
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer">

                    <i class="bx bxl-linkedin"></i>

                </a>

            </div>







            

        </div>

    </div>

</div>


<script>

const teamMembers = {

    // =========================
    // DIVYANSH
    // =========================

    divyansh: {

        name: "Divyansh Singh",

        role: "CEO",

        position: "Chief Executive Officer",

        image: "/images/ceo.png.png",

        description:
            "Divyansh Singh is leading RideWave toward a smarter, more convenient, and customer-focused future in car rental mobility.",

        social: {

            facebook: "https://www.facebook.com/",

            github: "https://github.com/Divyansh07477",

            twitter: "https://twitter.com/",

            linkedin:
                "https://www.linkedin.com/in/divyansh-singh-b48198345?utm_source=share_via&utm_content=profile&utm_medium=member_android"

        }

    },


    // =========================
    // NIKHIL
    // =========================

    nikhil: {

        name: "Nikhil Dhakad",

        role: "Owner & Founder",

        position: "Founder & Business Head",

        image: "/images/manager.png",

        description:
            "Nikhil Dhakad is the Owner & Founder of RideWave, driving the company’s vision with a strong focus on trust, innovation, and delivering a seamless car rental experience for every customer.",

        social: {

            facebook: "https://www.facebook.com/",

            github: "https://github.com/NikhilDhakad14",

            twitter: "https://twitter.com/"

        }

    }

};


// =========================
// OPEN MODAL
// =========================

function openTeamModal(memberName) {

    const member = teamMembers[memberName];

    if (!member) {

        console.log("Member not found");

        return;

    }


    // =========================
    // IMAGE
    // =========================

    document.getElementById("modalTeamImage").src =
        member.image;

    document.getElementById("modalTeamImage").alt =
        member.name;


    // =========================
    // BASIC DETAILS
    // =========================

    document.getElementById("modalTeamName").textContent =
        member.name;

    document.getElementById("modalTeamRole").textContent =
        member.role;

    document.getElementById("modalTeamPosition").textContent =
        member.position;

    document.getElementById("modalTeamDescription").textContent =
        member.description;


    // =========================
    // SOCIAL LINKS
    // =========================

    document.getElementById("modalFacebook").href =
        member.social.facebook;

    document.getElementById("modalGithub").href =
        member.social.github;


    // =========================
    // INSTAGRAM
    // =========================

    const instagramBtn =
        document.getElementById("modalInstagram");

    if (member.social.instagram) {

        instagramBtn.href =
            member.social.instagram;

        instagramBtn.style.display =
            "flex";

    } else {

        instagramBtn.style.display =
            "none";

    }


    // =========================
    // TWITTER
    // =========================

    const twitterBtn =
        document.getElementById("modalTwitter");

    if (member.social.twitter) {

        twitterBtn.href =
            member.social.twitter;

        twitterBtn.style.display =
            "flex";

    } else {

        twitterBtn.style.display =
            "none";

    }


    // =========================
    // LINKEDIN
    // =========================

    const linkedinBtn =
        document.getElementById("modalLinkedin");

    if (member.social.linkedin) {

        linkedinBtn.href =
            member.social.linkedin;

        linkedinBtn.style.display =
            "flex";

    } else {

        linkedinBtn.style.display =
            "none";

    }


    // =========================
    // OPEN MODAL
    // =========================

    const modal =
        document.getElementById("teamModal");

    modal.classList.add("active");

    document.body.style.overflow =
        "hidden";

}


// =========================
// CLOSE MODAL
// =========================

function closeTeamModal() {

    const modal =
        document.getElementById("teamModal");

    modal.classList.remove("active");

    document.body.style.overflow =
        "";

}


// =========================
// CLOSE BUTTON
// =========================

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const closeBtn =
            document.getElementById(
                "closeTeamModal"
            );


        if (closeBtn) {

            closeBtn.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    closeTeamModal();

                }
            );

        }


        // =========================
        // CLICK OUTSIDE MODAL
        // =========================

        const modal =
            document.getElementById("teamModal");


        if (modal) {

            modal.addEventListener(
                "click",
                function (event) {

                    if (event.target === modal) {

                        closeTeamModal();

                    }

                }
            );

        }

    }
);


// =========================
// ESC KEY
// =========================

document.addEventListener(
    "keydown",
    function (event) {

        if (event.key === "Escape") {

            closeTeamModal();

        }

    }
);

</script>


</body>
</html>