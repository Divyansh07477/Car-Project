<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Payment Successful - RideWave</title>

    <link
        rel="icon"
        type="image/png"
        href="/images/title.png.jpeg"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {

            font-family: "Segoe UI", Arial, sans-serif;

            min-height: 100vh;

            background:
                linear-gradient(
                    135deg,
                    #f0fdf4,
                    #ffffff,
                    #f8fafc
                );

            color: #0f172a;

            display: flex;

            flex-direction: column;

        }


        /* =========================
           NAVBAR
        ========================== */

        .navbar {

            height: 72px;

            width: 100%;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 6%;

            background: rgba(255,255,255,0.96);

            backdrop-filter: blur(12px);

            border-bottom: 1px solid #e5e7eb;

        }


        .logo {

            text-decoration: none;

        }


        .ridewave-logo {

            width: 125px;

            height: 70px;

            object-fit: contain;

            display: block;

        }


        .nav-links {

            display: flex;

            gap: 30px;

        }


        .nav-links a {

            text-decoration: none;

            color: #334155;

            font-size: 15px;

            font-weight: 600;

            transition: 0.3s;

        }


        .nav-links a:hover {

            color: #f97316;

        }


        /* =========================
           SUCCESS PAGE
        ========================== */

        .success-page {

            flex: 1;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 50px 20px;

        }


        .success-card {

            width: 100%;

            max-width: 520px;

            background: white;

            border: 1px solid #dcfce7;

            border-radius: 22px;

            padding: 45px 35px;

            text-align: center;

            box-shadow:
                0 20px 60px rgba(15,23,42,0.10);

            animation: cardIn 0.5s ease;

        }


        @keyframes cardIn {

            from {

                opacity: 0;

                transform: translateY(25px) scale(0.97);

            }

            to {

                opacity: 1;

                transform: translateY(0) scale(1);

            }

        }


        /* =========================
           SUCCESS ICON
        ========================== */

        .success-icon {

            width: 90px;

            height: 90px;

            margin: 0 auto 22px;

            border-radius: 50%;

            background: #dcfce7;

            display: flex;

            align-items: center;

            justify-content: center;

            animation: pop 0.5s ease 0.2s both;

        }


        @keyframes pop {

            0% {

                transform: scale(0);

            }

            70% {

                transform: scale(1.12);

            }

            100% {

                transform: scale(1);

            }

        }


        .success-icon svg {

            width: 48px;

            height: 48px;

            color: #16a34a;

            stroke-width: 2.5;

        }


        /* =========================
           TEXT
        ========================== */

        .success-card h1 {

            font-size: 30px;

            color: #15803d;

            margin-bottom: 10px;

            font-weight: 800;

        }


        .success-card .subtitle {

            color: #64748b;

            font-size: 15px;

            margin-bottom: 28px;

        }


        /* =========================
           DETAILS
        ========================== */

        .details {

            background: #f8fafc;

            border: 1px solid #e2e8f0;

            border-radius: 14px;

            padding: 18px;

            margin-bottom: 25px;

            text-align: left;

        }


        .detail-row {

            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 9px 0;

            font-size: 14px;

        }


        .detail-row:not(:last-child) {

            border-bottom: 1px solid #e5e7eb;

        }


        .detail-row span:first-child {

            color: #64748b;

        }


        .detail-row span:last-child {

            color: #111827;

            font-weight: 700;

        }


        .payment-status {

            color: #16a34a !important;

        }


        /* =========================
           BUTTON
        ========================== */

        .confirm-btn {

            width: 100%;

            height: 52px;

            border: none;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    #22c55e,
                    #16a34a
                );

            color: white;

            font-size: 15px;

            font-weight: 800;

            cursor: pointer;

            text-decoration: none;

            display: flex;

            align-items: center;

            justify-content: center;

            box-shadow:
                0 8px 20px rgba(22,163,74,0.22);

            transition: 0.3s;

        }


        .confirm-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 12px 25px rgba(22,163,74,0.30);

        }


        .booking-btn {

            display: block;

            margin-top: 15px;

            color: #64748b;

            text-decoration: none;

            font-size: 13px;

            font-weight: 600;

        }


        .booking-btn:hover {

            color: #f97316;

        }


        /* =========================
           MOBILE
        ========================== */

        @media (max-width: 600px) {

            .navbar {

                height: 64px;

                padding: 0 18px;

            }


            .ridewave-logo {

                width: 105px;

                height: 60px;

            }


            .nav-links {

                gap: 12px;

            }


            .nav-links a:nth-child(2) {

                display: none;

            }


            .success-page {

                padding: 30px 15px;

            }


            .success-card {

                padding: 35px 20px;

            }


            .success-card h1 {

                font-size: 25px;

            }


            .success-icon {

                width: 78px;

                height: 78px;

            }


            .success-icon svg {

                width: 42px;

                height: 42px;

            }

        }

    </style>

</head>


<body>

