<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Payment Successful - RideWave</title>
 <link
        rel="stylesheet"
        href="/css/style.css"
    >
    <link
        rel="icon"
        type="image/png"
        href="/images/title.png.jpeg"
    >

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {

            font-family: "Segoe UI", Arial, sans-serif;

            min-height: 100vh;

            background:
                linear-gradient(
                    135deg,
                    #f0fdf4,
                    #ffffff,
                    #f8fafc
                );

            color: #0f172a;

            display: flex;

            flex-direction: column;

        }


        /* =========================
           SUCCESS PAGE
        ========================== */

        .success-page {

            flex: 1;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 50px 20px;

        }


        .success-card {

            width: 100%;

            max-width: 540px;

            background: #ffffff;

            border: 1px solid #dcfce7;

            border-radius: 22px;

            padding: 45px 35px;

            text-align: center;

            box-shadow:
                0 20px 60px rgba(15,23,42,0.10);

            animation: cardIn 0.5s ease;

        }


        @keyframes cardIn {

            from {

                opacity: 0;

                transform:
                    translateY(25px)
                    scale(0.97);

            }

            to {

                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);

            }

        }


        /* =========================
           SUCCESS ICON
        ========================== */

        .success-icon {

            width: 90px;

            height: 90px;

            margin: 0 auto 22px;

            border-radius: 50%;

            background: #dcfce7;

            display: flex;

            align-items: center;

            justify-content: center;

            animation:
                pop 0.5s ease 0.2s both;

        }


        @keyframes pop {

            0% {
                transform: scale(0);
            }

            70% {
                transform: scale(1.12);
            }

            100% {
                transform: scale(1);
            }

        }


        .success-icon svg {

            width: 48px;

            height: 48px;

            color: #16a34a;

            stroke-width: 2.5;

        }


        /* =========================
           HEADING
        ========================== */

        .success-card h1 {

            font-size: 30px;

            color: #15803d;

            margin-bottom: 10px;

            font-weight: 800;

        }


        .subtitle {

            color: #64748b;

            font-size: 15px;

            margin-bottom: 28px;

        }


        /* =========================
           RECEIPT
        ========================== */

        .receipt {

            background: #ffffff;

            border: 1px solid #e2e8f0;

            border-radius: 15px;

            overflow: hidden;

            margin-bottom: 25px;

            text-align: left;

        }


        .receipt-header {

            background: #f8fafc;

            padding: 16px 20px;

            border-bottom: 1px solid #e2e8f0;

            display: flex;

            justify-content: space-between;

            align-items: center;

        }


        .receipt-title {

            font-size: 15px;

            font-weight: 800;

            color: #0f172a;

        }


        .receipt-paid {

            color: #16a34a;

            font-size: 12px;

            font-weight: 800;

            background: #dcfce7;

            padding: 6px 10px;

            border-radius: 20px;

        }


        .receipt-body {

            padding: 18px 20px;

        }


        /* =========================
           DETAIL ROW
        ========================== */

        .detail-row {

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 20px;

            padding: 11px 0;

            font-size: 14px;

        }


        .detail-row:not(:last-child) {

            border-bottom: 1px solid #eef2f7;

        }


        .detail-row span:first-child {

            color: #64748b;

        }


        .detail-row span:last-child {

            color: #111827;

            font-weight: 700;

            text-align: right;

        }


        .payment-status {

            color: #16a34a !important;

        }


        /* =========================
           FARE BREAKDOWN
        ========================== */

        .fare-section {

            margin-top: 12px;

            padding-top: 12px;

            border-top: 1px dashed #cbd5e1;

        }


        .fare-title {

            font-size: 13px;

            font-weight: 800;

            color: #334155;

            margin-bottom: 5px;

        }


        .fare-row {

            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 8px 0;

            font-size: 14px;

        }


        .fare-row span:first-child {

            color: #64748b;

        }


        .fare-row span:last-child {

            color: #111827;

            font-weight: 700;

        }


        /* =========================
           FINAL TOTAL
        ========================== */

        .total-row {

            margin-top: 8px;

            padding-top: 14px;

            border-top: 2px solid #e2e8f0;

            display: flex;

            justify-content: space-between;

            align-items: center;

        }


        .total-label {

            font-size: 16px;

            font-weight: 800;

            color: #0f172a;

        }


        .total-value {

            font-size: 21px;

            font-weight: 900;

            color: #16a34a;

        }


        /* =========================
           RECEIPT BUTTON
        ========================== */

        .receipt-actions {

            margin-top: 18px;

            display: flex;

            gap: 10px;

        }


        .print-btn {

            flex: 1;

            height: 48px;

            border: 1px solid #cbd5e1;

            border-radius: 10px;

            background: #ffffff;

            color: #334155;

            font-size: 14px;

            font-weight: 700;

            cursor: pointer;

            transition: 0.3s;

        }


        .print-btn:hover {

            background: #f8fafc;

            border-color: #94a3b8;

            transform: translateY(-1px);

        }


        /* =========================
           HOME BUTTON
        ========================== */

        .confirm-btn {

            width: 100%;

            height: 52px;

            border: none;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    #22c55e,
                    #16a34a
                );

            color: white;

            font-size: 15px;

            font-weight: 800;

            cursor: pointer;

            text-decoration: none;

            display: flex;

            align-items: center;

            justify-content: center;

            box-shadow:
                0 8px 20px rgba(22,163,74,0.22);

            transition: 0.3s;

        }


        .confirm-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 12px 25px rgba(22,163,74,0.30);

        }


        .booking-btn {

            display: block;

            margin-top: 15px;

            color: #64748b;

            text-decoration: none;

            font-size: 13px;

            font-weight: 600;

        }


        .booking-btn:hover {

            color: #f97316;

        }


        /* =========================
           PRINT CSS
        ========================== */

        @media print {

            body {

                background: white;

            }


            .success-page {

                padding: 0;

            }


            .success-card {

                max-width: 100%;

                border: none;

                box-shadow: none;

                padding: 20px;

            }


            .success-icon {

                animation: none;

            }


            .confirm-btn,

            .booking-btn,

            .receipt-actions {

                display: none !important;

            }


            .subtitle {

                margin-bottom: 20px;

            }


            .receipt {

                border: 1px solid #999;

            }

        }


        /* =========================
           MOBILE
        ========================== */

        @media (max-width: 600px) {

            .success-page {

                padding: 25px 14px;

            }


            .success-card {

                padding: 32px 18px;

                border-radius: 18px;

            }


            .success-card h1 {

                font-size: 25px;

            }


            .success-icon {

                width: 78px;

                height: 78px;

            }


            .success-icon svg {

                width: 42px;

                height: 42px;

            }


            .receipt-header {

                padding: 14px 15px;

            }


            .receipt-body {

                padding: 15px;

            }


            .detail-row,

            .fare-row {

                font-size: 13px;

            }


            .total-value {

                font-size: 18px;

            }

        }

    </style>

</head>


<body>


    <!-- =========================
         SUCCESS
    ========================== -->

    <main class="success-page">

        <div class="success-card">


            <!-- =========================
                 SUCCESS ICON
            ========================== -->

            <div class="success-icon">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                    />

                </svg>

            </div>


            <h1>
                Payment Successful!
            </h1>


            <p class="subtitle">

                Your payment has been successfully completed.

            </p>


            <!-- =========================
                 RECEIPT
            ========================== -->

            <div class="receipt">


                <!-- RECEIPT HEADER -->

                <div class="receipt-header">

                    <span class="receipt-title">
                        Payment Receipt
                    </span>

                    <span class="receipt-paid">
                        PAID
                    </span>

                </div>


                <!-- RECEIPT BODY -->

                <div class="receipt-body">


                    <!-- BOOKING ID -->

                    <div class="detail-row">

                        <span>
                            Booking ID
                        </span>

                        <span>
                            <%= bookingId || "Not Available" %>
                        </span>

                    </div>


                    <!-- PAYMENT METHOD -->

                    <div class="detail-row">

                        <span>
                            Payment Method
                        </span>

                        <span>
                            <%= paymentMethod || "Online" %>
                        </span>

                    </div>


                    <!-- PAYMENT STATUS -->

                    <div class="detail-row">

                        <span>
                            Payment Status
                        </span>

                        <span class="payment-status">
                            ✓ Paid
                        </span>

                    </div>


                    <!-- =========================
                         FARE BREAKDOWN
                    ========================== -->

                    <div class="fare-section">

                        <div class="fare-title">
                            Fare Breakdown
                        </div>


                        <div class="fare-row">

                            <span>
                                Base Rental
                            </span>

                            <span id="baseAmount">
                                ₹0
                            </span>

                        </div>


                        <div class="fare-row">

                            <span>
                                GST (18%)
                            </span>

                            <span id="gstAmount">
                                ₹0
                            </span>

                        </div>


                        <div class="fare-row">

                            <span>
                                Security Deposit
                            </span>

                            <span id="securityDeposit">
                                ₹3,000
                            </span>

                        </div>


                        <!-- FINAL TOTAL -->

                        <div class="total-row">

                            <span class="total-label">
                                Total Amount
                            </span>

                            <span
                                class="total-value"
                                id="totalAmount"
                            >
                                ₹0
                            </span>

                        </div>

                    </div>


                    <!-- PRINT -->

                    <div class="receipt-actions">

                        <button
                            type="button"
                            onclick="window.print()"
                            class="print-btn"
                        >

                            🖨 Print Receipt

                        </button>

                    </div>

                </div>

            </div>


            <!-- =========================
                 THANK YOU BUTTON
            ========================== -->

            <a
                href="/"
                class="confirm-btn"
            >

                Thank You for Booking with RideWave

            </a>


            <a
                href="/Mybookings"
                class="booking-btn"
            >

                View My Bookings

            </a>


        </div>

    </main>


    <!-- =========================
         CALCULATION
    ========================== -->
<script>

    // =====================================================
    // BACKEND VALUES
    // =====================================================

    const bookingBaseAmount =
        Number("<%= typeof baseAmount !== 'undefined' ? baseAmount : 0 %>") || 0;

    const bookingGstAmount =
        Number("<%= typeof gstAmount !== 'undefined' ? gstAmount : 0 %>") || 0;

    const bookingSecurityDeposit =
        Number("<%= typeof securityDeposit !== 'undefined' ? securityDeposit : 0 %>") || 0;

    const bookingTotalAmount =
        Number("<%= typeof totalAmount !== 'undefined' ? totalAmount : 0 %>") || 0;

    const oldAmount =
        Number("<%= amount || 0 %>") || 0;

    const totalDays =
        Number("<%= typeof totalDays !== 'undefined' ? totalDays : 1 %>") || 1;

    const pricePerDay =
        Number("<%= typeof pricePerDay !== 'undefined' ? pricePerDay : 0 %>") || 0;


    // =====================================================
    // TOTAL DAYS
    // =====================================================

    const days = Math.max(1, totalDays);


    // =====================================================
    // BASE RENTAL
    // =====================================================

    let baseAmount = 0;

    /*
     * Priority:
     * 1. Backend baseAmount
     * 2. pricePerDay × days
     * 3. old amount
     */

    if (bookingBaseAmount > 0) {

        baseAmount = bookingBaseAmount;

    } else if (pricePerDay > 0) {

        baseAmount = pricePerDay * days;

    } else if (oldAmount > 0) {

        baseAmount = oldAmount;

    }


    // =====================================================
    // GST 18%
    // =====================================================

    /*
     * GST MUST be calculated ONLY on rental amount.
     * Security deposit par GST nahi lagana.
     */

    const calculatedGst =
        Math.round(baseAmount * 18 / 100);


    /*
     * Backend GST agar available hai to use it.
     * Otherwise calculated GST use hoga.
     */

    const gstAmount =
        bookingGstAmount > 0
            ? bookingGstAmount
            : calculatedGst;


    // =====================================================
    // SECURITY DEPOSIT
    // =====================================================

    const securityDeposit =
        bookingSecurityDeposit > 0
            ? bookingSecurityDeposit
            : 3000;


    // =====================================================
    // FINAL TOTAL
    // =====================================================

    /*
     * IMPORTANT:
     *
     * Do NOT use bookingTotalAmount here.
     *
     * Because old totalAmount may contain:
     * - only rental
     * - rental + GST
     * - or some other amount
     *
     * So calculate fresh.
     */

    const finalTotal =
        baseAmount +
        gstAmount +
        securityDeposit;


    // =====================================================
    // FORMAT INR
    // =====================================================

    function formatINR(value) {

        return new Intl.NumberFormat(
            "en-IN",
            {
                style: "currency",
                currency: "INR",
                maximumFractionDigits: 0
            }
        ).format(Number(value) || 0);

    }


    // =====================================================
    // DISPLAY
    // =====================================================

    const baseElement =
        document.getElementById("baseAmount");

    const gstElement =
        document.getElementById("gstAmount");

    const securityElement =
        document.getElementById("securityDeposit");

    const totalElement =
        document.getElementById("totalAmount");


    if (baseElement) {

        baseElement.textContent =
            formatINR(baseAmount);

    }


    if (gstElement) {

        gstElement.textContent =
            formatINR(gstAmount);

    }


    if (securityElement) {

        securityElement.textContent =
            formatINR(securityDeposit);

    }


    if (totalElement) {

        totalElement.textContent =
            formatINR(finalTotal);

    }


    // =====================================================
    // DEBUG
    // =====================================================

    console.log("RideWave Booking Calculation");

    console.log("Price Per Day:", pricePerDay);

    console.log("Total Days:", days);

    console.log("Base Rental:", baseAmount);

    console.log("GST 18%:", gstAmount);

    console.log("Security Deposit:", securityDeposit);

    console.log("Final Total:", finalTotal);

</script>


</body>

</html>