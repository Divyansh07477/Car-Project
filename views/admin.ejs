          >

            <i
              data-lucide="car"
              class="w-6 h-6"
            ></i>

          </div>


          <div>

            <div
              id="totalCars"
              class="text-2xl font-extrabold text-[#0B1536]"
            >
              0
            </div>

            <div
              class="text-xs font-medium text-slate-400"
            >
              Total Cars
            </div>

          </div>

        </div>



        <!-- CATEGORIES -->

        <div
          class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4"
        >

          <div
            class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-500"
          >

            <i
              data-lucide="grid-2x2"
              class="w-6 h-6"
            ></i>

          </div>


          <div>

            <div
              id="totalCategories"
              class="text-2xl font-extrabold text-[#0B1536]"
            >
              0
            </div>

            <div
              class="text-xs font-medium text-slate-400"
            >
              Categories
            </div>

          </div>

        </div>



        <!-- AVG PRICE -->

        <div
          class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4"
        >

          <div
            class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500"
          >

            <i
              data-lucide="dollar-sign"
              class="w-6 h-6"
            ></i>

          </div>


          <div>

            <div
              id="avgPrice"
              class="text-2xl font-extrabold text-[#0B1536]"
            >
              $0
            </div>

            <div
              class="text-xs font-medium text-slate-400"
            >
              Avg Price/Day
            </div>

          </div>

        </div>



        <!-- PENDING -->

        <div
          class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4"
        >

          <div
            class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-500"
          >

            <i
              data-lucide="clock-3"
              class="w-6 h-6"
            ></i>

          </div>


          <div>

            <div
              id="pendingBookingsCount"
              class="text-2xl font-extrabold text-[#0B1536]"
            >
              0
            </div>

            <div
              class="text-xs font-medium text-slate-400"
            >
              Pending Bookings
            </div>

          </div>

        </div>

      </div>



      <!-- =====================================================
           RECENT BOOKINGS
      ===================================================== -->

      <div>

        <div
          class="flex justify-between items-center mb-4"
        >

          <div>

            <h2
              class="text-lg font-bold text-[#0B1536]"
            >
              Recent Bookings
            </h2>

            <p
              class="text-xs text-slate-400 mt-1"
            >
              Latest customer booking requests
            </p>

          </div>


          <a
            href="/Customerbooking"
            class="text-xs font-semibold text-[#FF462D] hover:underline flex items-center gap-1"
          >

            View All

            <i
              data-lucide="arrow-right"
              class="w-3.5 h-3.5"
            ></i>

          </a>

        </div>



        <!-- LOADING -->

        <div
          id="loadingState"
          class="bg-white p-10 rounded-2xl border border-slate-100 text-center"
        >

          <div class="flex justify-center mb-3">

            <i
              data-lucide="loader-circle"
              class="w-7 h-7 text-[#FF462D] animate-spin"
            ></i>

          </div>

          <p
            class="text-sm text-slate-400"
          >
            Loading bookings...
          </p>

        </div>



        <!-- ERROR -->

        <div
          id="errorState"
          class="hidden bg-white p-8 rounded-2xl border border-rose-100 text-center"
        >

          <i
            data-lucide="alert-circle"
            class="w-8 h-8 text-rose-500 mx-auto mb-3"
          ></i>

          <p
            id="errorMessage"
            class="text-sm text-rose-500 font-medium"
          >
            Failed to load bookings.
          </p>

          <button
            id="retryBtn"
            type="button"
            class="mt-4 px-4 py-2 bg-[#FF462D] text-white rounded-lg text-xs font-bold"
          >
            Try Again
          </button>

        </div>



        <!-- EMPTY -->

        <div
          id="emptyState"
          class="hidden bg-white p-10 rounded-2xl border border-slate-100 text-center"
        >

          <i
            data-lucide="calendar-x"
            class="w-10 h-10 text-slate-300 mx-auto mb-3"
          ></i>

          <p
            class="text-sm text-slate-400"
          >
            No bookings found.
          </p>

        </div>



        <!-- BOOKINGS -->

        <div
          id="bookingsContainer"
          class="hidden space-y-3"
        ></div>

      </div>

    </div>

  </main>



  <!-- =====================================================
       UPDATE MODAL
  ===================================================== -->

  <div
    id="updateModal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-[#0B1536]/40 backdrop-blur-sm hidden p-4"
  >

    <div
      class="bg-white w-full max-w-[520px] max-h-[90vh] rounded-3xl shadow-2xl relative border border-slate-100 overflow-hidden"
    >


      <!-- CLOSE -->

      <button
        id="closeModalBtn"
        type="button"
        class="absolute top-5 right-5 z-10 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-700"
      >

        <i
          data-lucide="x"
          class="w-4 h-4"
        ></i>

      </button>



      <div
        class="p-7 modal-scroll overflow-y-auto max-h-[90vh]"
      >


        <!-- TITLE -->

        <div class="text-center mb-6">

          <h2
            class="text-2xl font-extrabold text-[#FF462D]"
          >
            Update Booking
          </h2>

          <p
            id="modalBookingId"
            class="text-xs font-semibold text-slate-400 mt-1"
          >
            Booking ID
          </p>

        </div>



        <!-- BOOKING INFO -->

        <div
          id="modalBookingInfo"
          class="bg-slate-50 rounded-2xl p-4 mb-6"
        ></div>



        <!-- STATUS -->

        <div class="mb-6">

          <label
            class="text-xs font-bold text-slate-700 block mb-3"
          >
            Booking Status
          </label>


          <div
            class="grid grid-cols-2 sm:grid-cols-4 gap-3"
          >


            <!-- CONFIRMED -->

            <button
              type="button"
              class="status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition"
              data-status="confirmed"
            >

              <i
                data-lucide="check-circle-2"
                class="w-5 h-5"
              ></i>

              <span class="text-xs font-bold">
                Confirm
              </span>

            </button>



            <!-- COMPLETED -->

            <button
              type="button"
              class="status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition"
              data-status="completed"
            >

              <i
                data-lucide="check-check"
                class="w-5 h-5"
              ></i>

              <span class="text-xs font-bold">
                Complete
              </span>

            </button>



            <!-- CANCELLED -->

            <button
              type="button"
              class="status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition"
              data-status="cancelled"
            >

              <i
                data-lucide="x-circle"
                class="w-5 h-5"
              ></i>

              <span class="text-xs font-bold">
                Cancel
              </span>

            </button>



            <!-- PENDING -->

            <button
              type="button"
              class="status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition"
              data-status="pending"
            >

              <i
                data-lucide="clock"
                class="w-5 h-5"
              ></i>

              <span class="text-xs font-bold">
                Pending
              </span>

            </button>

          </div>

        </div>



        <!-- NOTE -->

        <form id="statusUpdateForm">

          <div class="space-y-2 mb-6">

            <label
              class="text-xs font-bold text-slate-700 block"
            >
              Reason / Note

              <span
                class="font-normal text-slate-400"
              >
                (optional)
              </span>

            </label>


            <textarea
              id="modalNoteInput"
              rows="3"
              placeholder="Add a reason or note..."
              class="w-full border border-slate-200 rounded-2xl p-3.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] resize-none"
            ></textarea>

          </div>



          <button
            type="submit"
            id="submitUpdateBtn"
            class="w-full py-3.5 bg-[#FF462D] hover:bg-[#e03a22] text-white font-bold rounded-2xl text-sm shadow-md transition"
          >
            Update Status
          </button>

        </form>

      </div>

    </div>

  </div>



  <!-- =====================================================
       JAVASCRIPT
  ===================================================== -->

  <script>

    /* =====================================================
       LUCIDE
    ===================================================== */

    lucide.createIcons();



    /* =====================================================
       ELEMENTS
    ===================================================== */

    const bookingsContainer =
      document.getElementById("bookingsContainer");

    const loadingState =
      document.getElementById("loadingState");

    const errorState =
      document.getElementById("errorState");

    const errorMessage =
      document.getElementById("errorMessage");

    const emptyState =
      document.getElementById("emptyState");

    const refreshBtn =
      document.getElementById("refreshBtn");

    const refreshIcon =
      document.getElementById("refreshIcon");

    const retryBtn =
      document.getElementById("retryBtn");

    const sidebarPendingCount =
      document.getElementById("sidebarPendingCount");

    const pendingBookingsCount =
      document.getElementById("pendingBookingsCount");

    const totalCars =
      document.getElementById("totalCars");

    const totalCategories =
      document.getElementById("totalCategories");

    const avgPrice =
      document.getElementById("avgPrice");



    /* =====================================================
       MODAL
    ===================================================== */

    const modal =
      document.getElementById("updateModal");

    const closeModalBtn =
      document.getElementById("closeModalBtn");

    const modalBookingId =
      document.getElementById("modalBookingId");

    const modalBookingInfo =
      document.getElementById("modalBookingInfo");

    const statusBtns =
      document.querySelectorAll(".status-btn");

    const statusForm =
      document.getElementById("statusUpdateForm");

    const modalNoteInput =
      document.getElementById("modalNoteInput");

    const submitBtn =
      document.getElementById("submitUpdateBtn");



    /* =====================================================
       FLASH ELEMENTS
    ===================================================== */

    const flashMessage =
      document.getElementById("flashMessage");

    const flashIcon =
      document.getElementById("flashIcon");

    const flashTitle =
      document.getElementById("flashTitle");

    const flashText =
      document.getElementById("flashText");

    let flashTimer = null;



    /* =====================================================
       SHOW FLASH
    ===================================================== */

    function showFlash(
      type,
      title,
      message
    ) {

      clearTimeout(flashTimer);


      flashMessage.classList.remove(
        "success",
        "error",
        "show"
      );


      if (type === "success") {

        flashMessage.classList.add(
          "success"
        );

        flashTitle.textContent =
          title || "Success";

        flashText.textContent =
          message ||
          "Operation completed successfully.";

        flashIcon.setAttribute(
          "data-lucide",
          "check-circle-2"
        );

      } else {

        flashMessage.classList.add(
          "error"
        );

        flashTitle.textContent =
          title || "Error";

        flashText.textContent =
          message ||
          "Something went wrong.";

        flashIcon.setAttribute(
          "data-lucide",
          "alert-circle"
        );

      }


      lucide.createIcons();


      requestAnimationFrame(() => {

        flashMessage.classList.add(
          "show"
        );

      });


      flashTimer = setTimeout(() => {

        flashMessage.classList.remove(
          "show"
        );

      }, 1500);

    }



    /* =====================================================
       STATUS FLASH MESSAGE
    ===================================================== */

    function getStatusFlash(status) {

      switch (status) {

        case "confirmed":

          return {
            title: "Booking Confirmed",
            message: "Booking has been confirmed successfully."
          };


        case "completed":

          return {
            title: "Booking Completed",
            message: "Booking has been marked as completed."
          };


        case "cancelled":

          return {
            title: "Booking Cancelled",
            message: "Booking has been cancelled successfully."
          };


        case "pending":

          return {
            title: "Booking Pending",
            message: "Booking has been moved to pending."
          };


        default:

          return {
            title: "Booking Updated",
            message: "Booking status updated successfully."
          };

      }

    }



    /* =====================================================
       VARIABLES
    ===================================================== */

    let allBookings = [];

    let currentSelectedBookingId = null;

    let selectedStatus = null;



    /* =====================================================
       FORMAT DATE
    ===================================================== */

    function formatDate(date) {

      if (!date) {
        return "N/A";
      }


      const d =
        new Date(date);


      if (isNaN(d.getTime())) {
        return "N/A";
      }


      return d.toLocaleDateString(
        "en-US",
        {
          month: "short",
          day: "numeric",
          year: "numeric"
        }
      );

    }



    /* =====================================================
       FORMAT MONEY
    ===================================================== */

    function formatMoney(amount) {

      const number =
        Number(amount);


      if (isNaN(number)) {
        return "$0";
      }


      return "$" +
        number.toLocaleString(
          "en-US",
          {
            maximumFractionDigits: 2
          }
        );

    }



    /* =====================================================
       ESCAPE HTML
    ===================================================== */

    function escapeHtml(value) {

      if (
        value === null ||
        value === undefined
      ) {
        return "";
      }


      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }



    /* =====================================================
       STATUS UI
    ===================================================== */

    function getStatusHTML(status) {

      const currentStatus =
        String(
          status || "pending"
        ).toLowerCase();


      if (
        currentStatus === "pending"
      ) {

        return `

          <span
            class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-600 text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase"
          >

            <span
              class="w-1.5 h-1.5 rounded-full bg-amber-500"
            ></span>

            Pending

          </span>

        `;

      }


      if (
        currentStatus === "confirmed"
      ) {

        return `

          <span
            class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-600 text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase"
          >

            <span
              class="w-1.5 h-1.5 rounded-full bg-emerald-500"
            ></span>

            Confirmed

          </span>

        `;

      }


      if (
        currentStatus === "completed"
      ) {

        return `

          <span
            class="inline-flex items-center gap-1.5 bg-sky-50 text-sky-600 text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase"
          >

            <span
              class="w-1.5 h-1.5 rounded-full bg-sky-500"
            ></span>

            Completed

          </span>

        `;

      }


      return `

        <span
          class="inline-flex items-center gap-1.5 bg-rose-50 text-rose-500 text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase"
        >

          <span
            class="w-1.5 h-1.5 rounded-full bg-rose-500"
          ></span>

          Cancelled

        </span>

      `;

    }



    /* =====================================================
       PAYMENT UI
       ADDED ONLY FOR PAYMENT STATUS
    ===================================================== */

    function getPaymentHTML(booking) {

      const paymentStatus =
        booking.payment &&
        booking.payment.status
          ? String(
              booking.payment.status
            ).toLowerCase()
          : "pending";


      if (paymentStatus === "paid") {

        return `

          <span
            class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-600 border border-emerald-100 text-[10px] font-extrabold px-2.5 py-1 rounded-lg uppercase"
          >

            <i
              data-lucide="badge-check"
              class="w-3.5 h-3.5"
            ></i>

            Paid

          </span>

        `;

      }


      return `

        <span
          class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-600 border border-amber-100 text-[10px] font-extrabold px-2.5 py-1 rounded-lg uppercase"
        >

          <i
            data-lucide="clock-3"
            class="w-3.5 h-3.5"
          ></i>

          Payment Pending

        </span>

      `;

    }



    /* =====================================================
       RENDER BOOKINGS
    ===================================================== */

    function renderBookings() {

      bookingsContainer.innerHTML = "";


      if (!allBookings.length) {

        bookingsContainer.classList.add(
          "hidden"
        );

        emptyState.classList.remove(
          "hidden"
        );

        return;

      }


      emptyState.classList.add(
        "hidden"
      );

      bookingsContainer.classList.remove(
        "hidden"
      );


      const recentBookings =
        allBookings.slice(0, 5);


      recentBookings.forEach(
        booking => {

          const car =
            booking.car || {};


          const carImage =
            car.image ||
            "/images/car-default.png";


          const carName =
            car.name ||
            "Rental Vehicle";


          const status =
            String(
              booking.status ||
              "pending"
            ).toLowerCase();


          const bookingHTML = `

            <div
              class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-sm hover:border-slate-200 transition-all"
            >

              <div
                class="flex flex-col lg:flex-row lg:items-center justify-between gap-5"
              >


                <!-- LEFT -->

                <div
                  class="flex items-start gap-4"
                >


                  <!-- CAR IMAGE -->

                  <div
                    class="w-28 h-20 bg-slate-50 rounded-xl flex items-center justify-center p-2 shrink-0 border border-slate-100 overflow-hidden"
                  >

                    <img
                      src="${escapeHtml(carImage)}"
                      alt="${escapeHtml(carName)}"
                      class="max-h-full max-w-full object-contain"
                      onerror="this.onerror=null;this.src='/images/car-default.png';"
                    />

                  </div>



                  <!-- DETAILS -->

                  <div
                    class="space-y-1.5 min-w-0"
                  >

                    <h3
                      class="font-bold text-[#0B1536] text-base leading-tight"
                    >
                      ${escapeHtml(carName)}
                    </h3>


                    <div
                      class="text-[10px] text-slate-400 font-medium"
                    >

                      Booking ID:

                      <span
                        class="text-slate-500 font-semibold"
                      >
                        ${escapeHtml(booking._id)}
                      </span>

                    </div>


                    <div
                      class="flex items-center gap-1.5 text-xs text-slate-400"
                    >

                      <i
                        data-lucide="user"
                        class="w-3.5 h-3.5"
                      ></i>

                      <span>

                        ${escapeHtml(booking.name)}

                        <span
                          class="text-slate-500"
                        >
                          (${escapeHtml(booking.email)})
                        </span>

                      </span>

                    </div>


                    <div
                      class="flex items-center gap-1.5 text-xs text-slate-400"
                    >

                      <i
                        data-lucide="phone"
                        class="w-3.5 h-3.5"
                      ></i>

                      <span>
                        ${escapeHtml(
                          booking.phone ||
                          "N/A"
                        )}
                      </span>

                    </div>


                    <div
                      class="flex flex-wrap items-center gap-3 text-xs text-slate-400 pt-0.5"
                    >

                      <span
                        class="flex items-center gap-1"
                      >

                        <i
                          data-lucide="calendar"
                          class="w-3.5 h-3.5"
                        ></i>

                        ${formatDate(
                          booking.startDate
                        )}

                        <span
                          class="text-slate-300"
                        >
                          →
                        </span>

                        ${formatDate(
                          booking.endDate
                        )}

                      </span>


                      <span
                        class="flex items-center gap-1"
                      >

                        <i
                          data-lucide="map-pin"
                          class="w-3.5 h-3.5"
                        ></i>

                        ${escapeHtml(
                          booking.pickupLocation ||
                          "N/A"
                        )}

                      </span>

                    </div>


                    <div
                      class="flex flex-wrap items-center gap-3 text-[11px] text-slate-400"
                    >

                      <span>
                        ${booking.totalDays || 1}
                        day(s)
                      </span>

                      <span>
                        ${formatMoney(
                          booking.pricePerDay
                        )}/day
                      </span>

                    </div>

                  </div>

                </div>



                <!-- RIGHT -->

                <div
                  class="flex lg:flex-col items-center lg:items-end justify-between gap-3 border-t lg:border-t-0 pt-4 lg:pt-0"
                >

                  <div
                    class="text-right"
                  >

                    <div
                      class="text-lg font-bold text-[#FF462D]"
                    >
                      ${formatMoney(
                        booking.totalAmount
                      )}
                    </div>


                    <div class="mt-1">

                      ${getStatusHTML(status)}

                    </div>


                    <!-- PAYMENT STATUS -->

                    <div class="mt-2">

                      ${getPaymentHTML(booking)}

                    </div>

                  </div>



                  <!-- UPDATE -->

                  <button
                    type="button"
                    data-booking-id="${escapeHtml(booking._id)}"
                    class="open-modal-btn flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors"
                  >

                    <i
                      data-lucide="edit-3"
                      class="w-3.5 h-3.5"
                    ></i>

                    Update

                  </button>

                </div>

              </div>

            </div>

          `;


          bookingsContainer.insertAdjacentHTML(
            "beforeend",
            bookingHTML
          );

        }
      );


      lucide.createIcons();



      /* RE-BIND MODAL BUTTONS */

      document
        .querySelectorAll(
          ".open-modal-btn"
        )
        .forEach(btn => {

          btn.addEventListener(
            "click",
            () => {

              openModal(
                btn.getAttribute(
                  "data-booking-id"
                )
              );

            }
          );

        });

    }



    /* =====================================================
       LOAD BOOKINGS
    ===================================================== */

    async function loadBookings() {

      loadingState.classList.remove(
        "hidden"
      );

      errorState.classList.add(
        "hidden"
      );

      emptyState.classList.add(
        "hidden"
      );

      bookingsContainer.classList.add(
        "hidden"
      );

      refreshIcon.classList.add(
        "animate-spin"
      );


      try {

        const response =
          await fetch(
            "/api/bookings/owner-bookings",
            {
              method: "GET",

              headers: {
                "Accept":
                  "application/json"
              }
            }
          );


        const contentType =
          response.headers.get(
            "content-type"
          ) || "";


        if (
          !contentType.includes(
            "application/json"
          )
        ) {

          throw new Error(
            "Server returned HTML instead of JSON. Please check login/session."
          );

        }


        const result =
          await response.json();


        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.message ||
            "Failed to fetch bookings."
          );

        }


        allBookings =
          Array.isArray(
            result.bookings
          )
            ? result.bookings
            : [];



        /* BOOKING STATS */

        const pendingCount =
          allBookings.filter(
            booking =>
              String(
                booking.status
              ).toLowerCase() ===
              "pending"
          ).length;


        pendingBookingsCount.textContent =
          pendingCount;


        sidebarPendingCount.textContent =
          pendingCount;


        renderBookings();

      }

      catch (error) {

        console.error(
          "Bookings Fetch Error:",
          error
        );


        loadingState.classList.add(
          "hidden"
        );

        errorState.classList.remove(
          "hidden"
        );


        errorMessage.textContent =
          error.message ||
          "Unable to load bookings.";

      }

      finally {

        loadingState.classList.add(
          "hidden"
        );

        refreshIcon.classList.remove(
          "animate-spin"
        );

      }

    }



    /* =====================================================
       LOAD CAR STATS
    ===================================================== */

    async function loadCarStats() {

      try {

        const response =
          await fetch(
            "/api/cars/my-cars",
            {
              headers: {
                "Accept":
                  "application/json"
              }
            }
          );


        if (!response.ok) {
          return;
        }


        const result =
          await response.json();


        if (!result.success) {
          return;
        }


        const cars =
          Array.isArray(
            result.cars
          )
            ? result.cars
            : [];


        totalCars.textContent =
          cars.length;


        const categories =
          new Set(
            cars
              .map(
                car =>
                  car.category
              )
              .filter(Boolean)
          );


        totalCategories.textContent =
          categories.size;


        const prices =
          cars
            .map(
              car =>
                Number(
                  car.pricePerDay
                )
            )
            .filter(
              price =>
                !isNaN(price)
            );


        const average =
          prices.length
            ? prices.reduce(
                (sum, price) =>
                  sum + price,
                0
              ) / prices.length
            : 0;


        avgPrice.textContent =
          formatMoney(
            Math.round(
              average
            )
          );

      }

      catch (error) {

        console.error(
          "Car Stats Error:",
          error
        );

      }

    }



    /* =====================================================
       OPEN MODAL
    ===================================================== */

    function openModal(
      bookingId
    ) {

      const booking =
        allBookings.find(
          item =>
            String(
              item._id
            ) ===
            String(
              bookingId
            )
        );


      if (!booking) {

        showFlash(
          "error",
          "Booking Not Found",
          "Booking details could not be found."
        );

        return;

      }


      currentSelectedBookingId =
        booking._id;


      const car =
        booking.car || {};


      modalBookingId.textContent =
        `Booking #${booking._id}`;


      modalNoteInput.value = "";


      /* MODAL DETAILS */

      modalBookingInfo.innerHTML = `

        <div class="flex gap-4">

          <div
            class="w-24 h-20 bg-white rounded-xl border border-slate-200 flex items-center justify-center p-2 shrink-0 overflow-hidden"
          >

            <img
              src="${escapeHtml(
                car.image ||
                "/images/car-default.png"
              )}"
              alt="${escapeHtml(
                car.name ||
                "Car"
              )}"
              class="max-h-full max-w-full object-contain"
              onerror="this.onerror=null;this.src='/images/car-default.png';"
            />

          </div>


          <div
            class="flex-1 min-w-0"
          >

            <h3
              class="font-bold text-[#0B1536]"
            >
              ${escapeHtml(
                car.name ||
                "Rental Vehicle"
              )}
            </h3>


            <p
              class="text-[10px] text-slate-400 mt-1 break-all"
            >

              Booking ID:

              <span
                class="text-slate-500 font-semibold"
              >
                ${escapeHtml(
                  booking._id
                )}
              </span>

            </p>


            <div
              class="grid grid-cols-2 gap-x-4 gap-y-2 mt-3"
            >

              <div>

                <p
                  class="text-[10px] text-slate-400"
                >
                  Customer
                </p>

                <p
                  class="text-xs font-semibold text-slate-700"
                >
                  ${escapeHtml(
                    booking.name
                  )}
                </p>

              </div>


              <div>

                <p
                  class="text-[10px] text-slate-400"
                >
                  Phone
                </p>

                <p
                  class="text-xs font-semibold text-slate-700"
                >
                  ${escapeHtml(
                    booking.phone ||
                    "N/A"
                  )}
                </p>

              </div>


              <div>

                <p
                  class="text-[10px] text-slate-400"
                >
                  Pickup
                </p>

                <p
                  class="text-xs font-semibold text-slate-700"
                >
                  ${formatDate(
                    booking.startDate
                  )}
                </p>

              </div>


              <div>

                <p
                  class="text-[10px] text-slate-400"
                >
                  Return
                </p>

                <p
                  class="text-xs font-semibold text-slate-700"
                >
                  ${formatDate(
                    booking.endDate
                  )}
                </p>

              </div>


              <div>

                <p
                  class="text-[10px] text-slate-400"
                >
                  Location
                </p>

                <p
                  class="text-xs font-semibold text-slate-700"
                >
                  ${escapeHtml(
                    booking.pickupLocation ||
                    "N/A"
                  )}
                </p>

              </div>


              <div>

                <p
                  class="text-[10px] text-slate-400"
                >
                  Total
                </p>

                <p
                  class="text-xs font-bold text-[#FF462D]"
                >
                  ${formatMoney(
                    booking.totalAmount
                  )}
                </p>

              </div>

            </div>

          </div>

        </div>

      `;


      /* CURRENT STATUS */

      selectedStatus =
        String(
          booking.status ||
          "pending"
        ).toLowerCase();


      setSelectedStatus(
        selectedStatus
      );


      modal.classList.remove(
        "hidden"
      );


      lucide.createIcons();

    }



    /* =====================================================
       SET STATUS
    ===================================================== */

    function setSelectedStatus(
      status
    ) {

      selectedStatus =
        status;


      statusBtns.forEach(
        btn => {

          btn.className =
            "status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition";


          const btnStatus =
            btn.getAttribute(
              "data-status"
            );


          if (
            btnStatus ===
            status
          ) {

            if (
              status ===
              "confirmed"
            ) {

              btn.className =
                "status-btn border-2 border-emerald-500 bg-emerald-50 text-emerald-600 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition shadow-sm";

            }

            else if (
              status ===
              "completed"
            ) {

              btn.className =
                "status-btn border-2 border-sky-500 bg-sky-50 text-sky-600 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition shadow-sm";

            }

            else if (
              status ===
              "cancelled"
            ) {

              btn.className =
                "status-btn border-2 border-rose-500 bg-rose-50 text-rose-600 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition shadow-sm";

            }

            else {

              btn.className =
                "status-btn border-2 border-amber-500 bg-amber-50 text-amber-600 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition shadow-sm";

            }

          }

        }
      );

    }



    /* =====================================================
       STATUS BUTTONS
    ===================================================== */

    statusBtns.forEach(
      btn => {

        btn.addEventListener(
          "click",
          () => {

            const status =
              btn.getAttribute(
                "data-status"
              );


            setSelectedStatus(
              status
            );

          }
        );

      }
    );



    /* =====================================================
       CLOSE MODAL
    ===================================================== */

    function closeModal() {

      modal.classList.add(
        "hidden"
      );


      currentSelectedBookingId =
        null;

    }


    closeModalBtn.addEventListener(
      "click",
      closeModal
    );


    modal.addEventListener(
      "click",
      event => {

        if (
          event.target ===
          modal
        ) {

          closeModal();

        }

      }
    );



    /* =====================================================
       ESC KEY
    ===================================================== */

    document.addEventListener(
      "keydown",
      event => {

        if (
          event.key ===
            "Escape" &&
          !modal.classList.contains(
            "hidden"
          )
        ) {

          closeModal();

        }

      }
    );



    /* =====================================================
       UPDATE BOOKING STATUS
    ===================================================== */

    statusForm.addEventListener(
      "submit",
      async event => {

        event.preventDefault();


        if (
          !currentSelectedBookingId
        ) {

          showFlash(
            "error",
            "Booking ID Missing",
            "Booking ID is required."
          );

          return;

        }


        if (!selectedStatus) {

          showFlash(
            "error",
            "Status Required",
            "Please select a booking status."
          );

          return;

        }


        submitBtn.disabled =
          true;


        submitBtn.textContent =
          "Updating...";


        try {

          const response =
            await fetch(
              "/api/bookings/update-status",
              {
                method: "POST",

                headers: {
                  "Content-Type":
                    "application/json",

                  "Accept":
                    "application/json"
                },

                body:
                  JSON.stringify({
                    bookingId:
                      currentSelectedBookingId,

                    status:
                      selectedStatus,

                    note:
                      modalNoteInput
                        .value
                        .trim()
                  })
              }
            );


          const contentType =
            response.headers.get(
              "content-type"
            ) || "";


          if (
            !contentType.includes(
              "application/json"
            )
          ) {

            throw new Error(
              "Server returned HTML instead of JSON. Check the API route."
            );

          }


          const result =
            await response.json();


          if (
            !response.ok ||
            !result.success
          ) {

            throw new Error(
              result.message ||
              "Status update failed."
            );

          }



          /* =================================================
             SUCCESS FLASH
          ================================================= */

          const flash =
            getStatusFlash(
              selectedStatus
            );


          showFlash(
            "success",
            flash.title,
            result.message ||
              flash.message
          );


          closeModal();



          /* =================================================
             FRESH DATABASE DATA
          ================================================= */

          await loadBookings();

        }

        catch (error) {

          console.error(
            "Status Update Error:",
            error
          );


          showFlash(
            "error",
            "Update Failed",
            error.message ||
              "Server communication error."
          );

        }

        finally {

          submitBtn.disabled =
            false;


          submitBtn.textContent =
            "Update Status";

        }

      }
    );



    /* =====================================================
       REFRESH
    ===================================================== */

    refreshBtn.addEventListener(
      "click",
      async () => {

        await loadBookings();

        await loadCarStats();

      }
    );



    /* =====================================================
       RETRY
    ===================================================== */

    retryBtn.addEventListener(
      "click",
      async () => {

        await loadBookings();

      }
    );



    /* =====================================================
       INITIAL LOAD
    ===================================================== */

    loadBookings();

    loadCarStats();



    /* =====================================================
       AUTO REFRESH
       ADDED ONLY FOR PAYMENT STATUS
    ===================================================== */

    setInterval(
      async () => {

        /*
         * Refresh booking data every 5 seconds.
         * This allows admin/owner to see
         * Confirmed -> Paid automatically
         * after customer completes payment.
         */

        if (
          modal.classList.contains("hidden")
        ) {

          await loadBookings();

        }

      },
      5000
    );

  </script>

</body>

