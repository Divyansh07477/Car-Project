  <script>

    lucide.createIcons();


    /* =====================================================
       DOM ELEMENTS
    ===================================================== */

    const currentDate =
      document.getElementById("currentDate");

    const totalCars =
      document.getElementById("totalCars");

    const totalBookings =
      document.getElementById("totalBookings");

    const pendingBookings =
      document.getElementById("pendingBookings");

    const confirmedBookings =
      document.getElementById("confirmedBookings");

    const pendingSidebarCount =
      document.getElementById("pendingSidebarCount");

    const recentBookings =
      document.getElementById("recentBookings");

    const bookingLoading =
      document.getElementById("bookingLoading");

    const bookingEmpty =
      document.getElementById("bookingEmpty");

    const myCarsContainer =
      document.getElementById("myCarsContainer");

    const lastUpdated =
      document.getElementById("lastUpdated");


    /* =====================================================
       DATE
    ===================================================== */

    function updateDate() {

      if (!currentDate) return;

      currentDate.textContent =
        new Date().toLocaleDateString("en-IN", {
          day: "numeric",
          month: "short",
          year: "numeric"
        });

    }

    updateDate();


    /* =====================================================
       ESCAPE HTML
    ===================================================== */

    function escapeHtml(value) {

      if (
        value === null ||
        value === undefined
      ) {
        return "";
      }

      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }


    /* =====================================================
       MONEY FORMAT
    ===================================================== */

    function formatMoney(value) {

      const number = Number(value);

      if (isNaN(number)) {
        return "0";
      }

      return number.toLocaleString("en-IN", {
        maximumFractionDigits: 2
      });

    }


    /* =====================================================
       DATE FORMAT
    ===================================================== */

    function formatDate(value) {

      if (!value) {
        return "N/A";
      }

      const date = new Date(value);

      if (isNaN(date.getTime())) {
        return "N/A";
      }

      return date.toLocaleDateString("en-IN", {
        day: "numeric",
        month: "short",
        year: "numeric"
      });

    }


    /* =====================================================
       CAR IMAGE
    ===================================================== */

    function getCarImage(car) {

      if (!car) {
        return "";
      }

      if (
        typeof car.image === "string" &&
        car.image.trim()
      ) {
        return car.image;
      }

      if (
        car.image &&
        typeof car.image === "object"
      ) {

        if (
          car.image.url &&
          String(car.image.url).trim()
        ) {
          return car.image.url;
        }

        if (
          car.image.secure_url &&
          String(car.image.secure_url).trim()
        ) {
          return car.image.secure_url;
        }

      }

      if (
        car.imageUrl &&
        typeof car.imageUrl === "string"
      ) {
        return car.imageUrl;
      }

      if (
        car.photo &&
        typeof car.photo === "string"
      ) {
        return car.photo;
      }

      return "";

    }


    /* =====================================================
       FALLBACK IMAGE
    ===================================================== */

    const fallbackImage =
      "data:image/svg+xml;charset=UTF-8," +
      encodeURIComponent(`

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="500"
          height="300"
          viewBox="0 0 500 300"
        >

          <rect
            width="500"
            height="300"
            fill="#f8fafc"
          />

          <text
            x="250"
            y="145"
            text-anchor="middle"
            font-family="Arial"
            font-size="24"
            fill="#94a3b8"
          >
            No Image
          </text>

          <text
            x="250"
            y="180"
            text-anchor="middle"
            font-family="Arial"
            font-size="15"
            fill="#cbd5e1"
          >
            RideWave
          </text>

        </svg>

      `);


    /* =====================================================
       STATUS CONFIG
    ===================================================== */

    const statusConfig = {

      pending: {
        label: "Pending",
        bg: "bg-amber-50",
        text: "text-amber-600",
        icon: "clock-3"
      },

      confirmed: {
        label: "Confirmed",
        bg: "bg-emerald-50",
        text: "text-emerald-600",
        icon: "badge-check"
      },

      completed: {
        label: "Completed",
        bg: "bg-sky-50",
        text: "text-sky-600",
        icon: "check-check"
      },

      cancelled: {
        label: "Cancelled",
        bg: "bg-rose-50",
        text: "text-rose-600",
        icon: "x-circle"
      }

    };


    /* =====================================================
       PAYMENT STATUS
    ===================================================== */

    function getPaymentStatus(booking) {

      const bookingStatus =
        String(
          booking?.status || ""
        )
          .toLowerCase()
          .trim();

      const rawPaymentStatus =
        booking?.payment?.status ??
        booking?.paymentStatus ??
        "";

      const paymentStatus =
        String(rawPaymentStatus)
          .toLowerCase()
          .trim();


      if (paymentStatus === "paid") {
        return "paid";
      }

      if (paymentStatus === "refunded") {
        return "refunded";
      }

      if (paymentStatus === "failed") {
        return "failed";
      }


      if (
        bookingStatus === "confirmed" ||
        bookingStatus === "completed"
      ) {
        return "pending";
      }


      return "not_required";

    }


    /* =====================================================
       CURRENT USER
    ===================================================== */

    let currentUser = null;


    async function getCurrentUser() {

      try {

        const response =
          await fetch(
            "/api/auth/me",
            {
              credentials: "include",
              headers: {
                "Accept": "application/json"
              }
            }
          );


        if (!response.ok) {
          return null;
        }


        const data =
          await response.json();


        return (
          data.user ||
          data.data ||
          data
        );

      } catch (error) {

        console.error(
          "Current user error:",
          error
        );

        return null;

      }

    }


    /* =====================================================
       OWNER ID
    ===================================================== */

    function getOwnerId(car) {

      if (!car) {
        return "";
      }


      if (
        car.owner &&
        typeof car.owner === "object"
      ) {

        return String(
          car.owner._id ||
          car.owner.id ||
          ""
        );

      }


      return String(
        car.owner || ""
      );

    }


    /* =====================================================
       CALCULATE BOOKING TOTAL
       
       BASE RENTAL
       +
       GST 18%
       +
       SECURITY DEPOSIT
    ===================================================== */

    function calculateBookingTotal(
      booking,
      car = null
    ) {

      /* ===============================
         TOTAL DAYS
      =============================== */

      let days =
        Number(
          booking?.totalDays
        );


      if (
        !Number.isFinite(days) ||
        days <= 0
      ) {

        if (
          booking?.startDate &&
          booking?.endDate
        ) {

          const start =
            new Date(
              booking.startDate
            );

          const end =
            new Date(
              booking.endDate
            );


          const difference =
            Math.ceil(
              (
                end - start
              ) /
              (
                1000 *
                60 *
                60 *
                24
              )
            );


          days =
            Math.max(
              1,
              difference
            );

        } else {

          days = 1;

        }

      }


      /* ===============================
         PRICE PER DAY
      =============================== */

      const pricePerDay =
        Number(
          booking?.pricePerDay ??
          car?.pricePerDay ??
          0
        ) || 0;


      /* ===============================
         BASE RENTAL
      =============================== */

      const storedBaseAmount =
        Number(
          booking?.baseAmount
        );


      const baseAmount =
        Number.isFinite(
          storedBaseAmount
        ) &&
        storedBaseAmount > 0

          ? storedBaseAmount

          : (
              pricePerDay *
              days
            );


      /* ===============================
         GST 18%
      =============================== */

      const storedGstAmount =
        Number(
          booking?.gstAmount
        );


      const gstAmount =
        Number.isFinite(
          storedGstAmount
        ) &&
        storedGstAmount > 0

          ? storedGstAmount

          : Math.round(
              (
                baseAmount *
                18
              ) / 100
            );


      /* ===============================
         SECURITY DEPOSIT
      =============================== */

      const storedSecurityDeposit =
        Number(
          booking?.securityDeposit
        );


      const securityDeposit =
        Number.isFinite(
          storedSecurityDeposit
        ) &&
        storedSecurityDeposit > 0

          ? storedSecurityDeposit

          : 3000;


      /* ===============================
         FINAL TOTAL
      =============================== */

      const totalAmount =
        baseAmount +
        gstAmount +
        securityDeposit;


      return {

        days,

        pricePerDay,

        baseAmount,

        gstAmount,

        securityDeposit,

        totalAmount

      };

    }


    /* =====================================================
       LOAD MY CARS
    ===================================================== */

    async function loadMyCars() {

      try {

        if (!currentUser) {

          currentUser =
            await getCurrentUser();

        }


        if (!currentUser) {

          totalCars.textContent = "0";


          myCarsContainer.innerHTML = `

            <div class="py-10 text-center">

              <div
                class="w-12 h-12 mx-auto rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center mb-3">

                <i
                  data-lucide="log-in"
                  class="w-6 h-6">
                </i>

              </div>

              <p class="text-sm font-bold text-slate-600">
                Please login again
              </p>

            </div>

          `;


          lucide.createIcons();

          return;

        }


        const response =
          await fetch(
            "/api/cars",
            {
              credentials: "include",
              headers: {
                "Accept": "application/json"
              }
            }
          );


        if (!response.ok) {
          throw new Error(
            "Failed to load cars"
          );
        }


        const result =
          await response.json();


        let allCars = [];


        if (Array.isArray(result)) {

          allCars = result;

        } else if (
          Array.isArray(
            result.cars
          )
        ) {

          allCars =
            result.cars;

        }


        const myId =
          String(
            currentUser._id ||
            currentUser.id ||
            ""
          );


        const myCars =
          allCars.filter(
            car =>
              getOwnerId(car) === myId
          );


        totalCars.textContent =
          myCars.length;


        renderMyCars(
          myCars
        );


      } catch (error) {

        console.error(
          "Cars error:",
          error
        );


        totalCars.textContent =
          "0";


        myCarsContainer.innerHTML = `

          <div class="py-10 text-center">

            <div
              class="w-12 h-12 mx-auto rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center mb-3">

              <i
                data-lucide="alert-circle"
                class="w-6 h-6">
              </i>

            </div>

            <p class="text-sm font-bold text-slate-600">
              Unable to load cars
            </p>

            <p class="text-xs text-slate-400 mt-1">
              Please try again.
            </p>

          </div>

        `;


        lucide.createIcons();

      }

    }


    /* =====================================================
       RENDER MY CARS
    ===================================================== */

    function renderMyCars(cars) {

      if (
        !cars ||
        cars.length === 0
      ) {

        myCarsContainer.innerHTML = `

          <div class="py-12 text-center">

            <div
              class="w-14 h-14 mx-auto rounded-2xl bg-slate-50 text-slate-400 flex items-center justify-center mb-3">

              <i
                data-lucide="car-front"
                class="w-7 h-7">
              </i>

            </div>

            <p class="text-sm font-bold text-slate-600">
              No cars added yet
            </p>

            <p class="text-xs text-slate-400 mt-1">
              Add your first rental car from Rental Cars.
            </p>

            <a
              href="/carAdmin"
              class="inline-flex items-center gap-2 mt-4 bg-[#FF462D] text-white text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-[#e83d28] transition">

              <i
                data-lucide="plus"
                class="w-4 h-4">
              </i>

              Add Car

            </a>

          </div>

        `;


        lucide.createIcons();

        return;

      }


      myCarsContainer.innerHTML = `

        <div
          class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">

          ${cars.map(car => {

            const image =
              getCarImage(car) ||
              fallbackImage;


            const name =
              car.name ||
              "Rental Car";


            const category =
              car.category ||
              "Car";


            const transmission =
              car.transmission ||
              "N/A";


            const price =
              car.pricePerDay ??
              0;


            const available =
              car.isAvailable !== false;


            const seats =
              car.seats ||
              car.capacity ||
              "N/A";


            const fuel =
              car.fuelType ||
              car.fuel ||
              "N/A";


            return `

              <div
                class="car-card border border-slate-100 rounded-2xl overflow-hidden bg-white">

                <div
                  class="h-[190px] bg-slate-50 flex items-center justify-center overflow-hidden">

                  <img
                    src="${escapeHtml(image)}"
                    alt="${escapeHtml(name)}"
                    class="car-image"
                    onerror="this.onerror=null;this.src='${fallbackImage}'"
                  >

                </div>


                <div class="p-5">

                  <div
                    class="flex items-start justify-between gap-3">

                    <div class="min-w-0">

                      <h3
                        class="text-base font-extrabold text-[#0B1536] truncate">

                        ${escapeHtml(name)}

                      </h3>

                      <p
                        class="text-xs text-slate-400 mt-1">

                        ${escapeHtml(category)}

                      </p>

                    </div>


                    <span class="${
                      available
                        ? "bg-emerald-50 text-emerald-600"
                        : "bg-rose-50 text-rose-600"
                    }
                    text-[9px]
                    font-extrabold
                    px-2.5
                    py-1.5
                    rounded-lg
                    shrink-0">

                      ${
                        available
                          ? "AVAILABLE"
                          : "UNAVAILABLE"
                      }

                    </span>

                  </div>


                  <div
                    class="grid grid-cols-2 gap-3 mt-5">


                    <!-- TRANSMISSION -->
                    <div
                      class="bg-slate-50 rounded-xl p-3">

                      <div
                        class="flex items-center gap-1.5 text-slate-400 mb-1">

                        <i
                          data-lucide="gauge"
                          class="w-3.5 h-3.5">
                        </i>

                        <span
                          class="text-[10px] font-semibold">

                          Transmission

                        </span>

                      </div>

                      <p
                        class="text-xs font-bold text-[#0B1536]">

                        ${escapeHtml(transmission)}

                      </p>

                    </div>


                    <!-- SEATS -->
                    <div
                      class="bg-slate-50 rounded-xl p-3">

                      <div
                        class="flex items-center gap-1.5 text-slate-400 mb-1">

                        <i
                          data-lucide="users"
                          class="w-3.5 h-3.5">
                        </i>

                        <span
                          class="text-[10px] font-semibold">

                          Seats

                        </span>

                      </div>

                      <p
                        class="text-xs font-bold text-[#0B1536]">

                        ${escapeHtml(seats)}

                      </p>

                    </div>


                    <!-- FUEL -->
                    <div
                      class="bg-slate-50 rounded-xl p-3">

                      <div
                        class="flex items-center gap-1.5 text-slate-400 mb-1">

                        <i
                          data-lucide="fuel"
                          class="w-3.5 h-3.5">
                        </i>

                        <span
                          class="text-[10px] font-semibold">

                          Fuel

                        </span>

                      </div>

                      <p
                        class="text-xs font-bold text-[#0B1536]">

                        ${escapeHtml(fuel)}

                      </p>

                    </div>


                    <!-- PRICE -->
                    <div
                      class="bg-orange-50 rounded-xl p-3">

                      <div
                        class="flex items-center gap-1.5 text-[#FF462D] mb-1">

                        <i
                          data-lucide="indian-rupee"
                          class="w-3.5 h-3.5">
                        </i>

                        <span
                          class="text-[10px] font-semibold">

                          Price / Day

                        </span>

                      </div>

                      <p
                        class="text-sm font-extrabold text-[#FF462D]">

                        ₹${formatMoney(price)}

                      </p>

                    </div>

                  </div>


                  <!-- MANAGE -->
                  <a
                    href="/carAdmin"
                    class="mt-4 w-full inline-flex items-center justify-center gap-2 bg-[#0B1536] text-white text-xs font-bold px-4 py-3 rounded-xl hover:bg-[#15234f] transition">

                    <i
                      data-lucide="settings-2"
                      class="w-4 h-4">
                    </i>

                    Manage Car

                  </a>

                </div>

              </div>

            `;

          }).join("")}

        </div>

      `;


      lucide.createIcons();

    }


    /* =====================================================
       LOAD BOOKINGS
    ===================================================== */

    async function loadBookings() {

      try {

        const response =
          await fetch(
            "/api/bookings/owner-bookings",
            {
              credentials: "include",
              headers: {
                "Accept": "application/json"
              }
            }
          );


        if (!response.ok) {

          throw new Error(
            "Unable to load bookings"
          );

        }


        const result =
          await response.json();


        let bookings = [];


        if (
          Array.isArray(
            result.bookings
          )
        ) {

          bookings =
            result.bookings;

        } else if (
          Array.isArray(result)
        ) {

          bookings = result;

        }


        /* ===============================
           STATUS COUNTS
        =============================== */

        const pending =
          bookings.filter(
            booking =>
              String(
                booking.status || ""
              )
                .toLowerCase()
                .trim() ===
              "pending"
          ).length;


        const confirmed =
          bookings.filter(
            booking =>
              String(
                booking.status || ""
              )
                .toLowerCase()
                .trim() ===
              "confirmed"
          ).length;


        totalBookings.textContent =
          bookings.length;


        pendingBookings.textContent =
          pending;


        confirmedBookings.textContent =
          confirmed;


        pendingSidebarCount.textContent =
          pending;


        /* ===============================
           RENDER
        =============================== */

        renderRecentBookings(
          bookings
        );


        lastUpdated.textContent =
          "Updated " +
          new Date().toLocaleTimeString(
            "en-IN",
            {
              hour: "2-digit",
              minute: "2-digit"
            }
          );


      } catch (error) {

        console.error(
          "Bookings error:",
          error
        );


        bookingLoading.classList.add(
          "hidden"
        );


        if (
          recentBookings.children.length === 0
        ) {

          bookingEmpty.classList.remove(
            "hidden"
          );

        }

      }

    }


    /* =====================================================
       RENDER RECENT BOOKINGS
    ===================================================== */

    function renderRecentBookings(
      bookings
    ) {

      bookingLoading.classList.add(
        "hidden"
      );


      if (
        !bookings ||
        bookings.length === 0
      ) {

        recentBookings.classList.add(
          "hidden"
        );

        bookingEmpty.classList.remove(
          "hidden"
        );

        return;

      }


      bookingEmpty.classList.add(
        "hidden"
      );


      recentBookings.classList.remove(
        "hidden"
      );


      const sortedBookings =
        [...bookings]
          .sort(
            (a, b) =>
              new Date(
                b.createdAt || 0
              ) -
              new Date(
                a.createdAt || 0
              )
          )
          .slice(0, 8);


      recentBookings.innerHTML =
        sortedBookings
          .map(
            booking =>
              createRecentBooking(
                booking
              )
          )
          .join("");


      lucide.createIcons();

    }


    /* =====================================================
       CREATE RECENT BOOKING
    ===================================================== */

    function createRecentBooking(
      booking
    ) {

      const status =
        String(
          booking.status ||
          "pending"
        )
          .toLowerCase()
          .trim();


      const config =
        statusConfig[status] ||
        statusConfig.pending;


      /* ===============================
         CAR
      =============================== */

      const car =
        booking.car &&
        typeof booking.car === "object"
          ? booking.car
          : null;


      const carName =
        car?.name ||
        (
          typeof booking.car === "string"
            ? booking.car
            : "Rental Vehicle"
        );


      const carImage =
        getCarImage(car) ||
        fallbackImage;


      const category =
        car?.category ||
        "Car";


      const transmission =
        car?.transmission ||
        "N/A";


      /* ===============================
         CUSTOMER
      =============================== */

      const customerName =
        booking.name ||
        booking.renter?.name ||
        "Customer";


      const customerEmail =
        booking.email ||
        booking.renter?.email ||
        "";


      /* ===============================
         IMPORTANT:
         FINAL FARE CALCULATION
      =============================== */

      const fare =
        calculateBookingTotal(
          booking,
          car
        );


      const days =
        fare.days;


      const pricePerDay =
        fare.pricePerDay;


      const baseAmount =
        fare.baseAmount;


      const gstAmount =
        fare.gstAmount;


      const securityDeposit =
        fare.securityDeposit;


      const totalAmount =
        fare.totalAmount;


      /* ===============================
         PAYMENT
      =============================== */

      const paymentStatus =
        getPaymentStatus(
          booking
        );


      const paymentLabel =
        paymentStatus === "paid"

          ? "Paid"

          : paymentStatus === "refunded"

            ? "Refunded"

            : paymentStatus === "failed"

              ? "Failed"

              : "Pending";


      const paymentClass =
        paymentStatus === "paid" ||
        paymentStatus === "refunded"

          ? "bg-emerald-50 text-emerald-600 border border-emerald-200"

          : paymentStatus === "failed"

            ? "bg-rose-50 text-rose-600"

            : "bg-amber-50 text-amber-600";


      const bookingId =
        booking._id || "";


      /* =================================================
         BOOKING CARD
      ================================================= */

      return `

        <div class="booking-card p-5">

          <div
            class="flex flex-col lg:flex-row lg:items-center gap-5">


            <!-- =========================================
                 CAR IMAGE
            ========================================== -->

            <div class="shrink-0">

              <img
                src="${escapeHtml(carImage)}"
                alt="${escapeHtml(carName)}"
                class="booking-car-image"
                onerror="this.onerror=null;this.src='${fallbackImage}'"
              >

            </div>


            <!-- =========================================
                 BOOKING DETAILS
            ========================================== -->

            <div class="flex-1 min-w-0">


              <!-- CAR NAME -->
              <div
                class="flex flex-wrap items-center gap-2">

                <h3
                  class="text-sm font-extrabold text-[#0B1536]">

                  ${escapeHtml(carName)}

                </h3>


                <span
                  class="text-[9px] bg-slate-100 text-slate-500 font-bold px-2 py-1 rounded-lg">

                  ${escapeHtml(category)}

                </span>


                <span
                  class="text-[9px] bg-slate-100 text-slate-500 font-bold px-2 py-1 rounded-lg">

                  ${escapeHtml(transmission)}

                </span>

              </div>


              <!-- CUSTOMER -->
              <div
                class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2">


                <span
                  class="text-[11px] text-slate-500 flex items-center gap-1.5">

                  <i
                    data-lucide="user"
                    class="w-3.5 h-3.5 text-slate-400">
                  </i>

                  <span class="font-semibold">

                    ${escapeHtml(
                      customerName
                    )}

                  </span>

                </span>


                ${
                  customerEmail
                    ? `

                      <span
                        class="text-[11px] text-slate-400 flex items-center gap-1.5">

                        <i
                          data-lucide="mail"
                          class="w-3.5 h-3.5">
                        </i>

                        ${escapeHtml(
                          customerEmail
                        )}

                      </span>

                    `
                    : ""
                }

              </div>


              <!-- DATES -->
              <div
                class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-3">


                <span
                  class="text-[10px] text-slate-400 flex items-center gap-1.5">

                  <i
                    data-lucide="calendar-days"
                    class="w-3.5 h-3.5 text-[#FF462D]">
                  </i>

                  ${formatDate(
                    booking.startDate
                  )}

                  <span>→</span>

                  ${formatDate(
                    booking.endDate
                  )}

                </span>


                <span
                  class="text-[10px] text-slate-400 flex items-center gap-1.5">

                  <i
                    data-lucide="clock-3"
                    class="w-3.5 h-3.5">
                  </i>

                  ${escapeHtml(
                    days
                  )} day(s)

                </span>


                ${
                  booking.pickupLocation
                    ? `

                      <span
                        class="text-[10px] text-slate-400 flex items-center gap-1.5">

                        <i
                          data-lucide="map-pin"
                          class="w-3.5 h-3.5">
                        </i>

                        ${escapeHtml(
                          booking.pickupLocation
                        )}

                      </span>

                    `
                    : ""
                }

              </div>


              <!-- =======================================
                   PAYMENT BADGE
              ======================================== -->

              <div
                class="flex flex-wrap items-center gap-2 mt-3">


                ${
                  paymentStatus !==
                  "not_required"

                    ? `

                      <span
                        class="${paymentClass} text-[9px] font-extrabold px-2.5 py-1.5 rounded-lg">

                        Payment:
                        ${paymentLabel}

                      </span>

                    `

                    : ""
                }


                ${
                  booking.note
                    ? `

                      <span
                        class="bg-slate-50 text-slate-500 text-[9px] font-semibold px-2.5 py-1.5 rounded-lg">

                        ${escapeHtml(
                          booking.note
                        )}

                      </span>

                    `
                    : ""
                }

              </div>


            </div>


            <!-- =========================================
                 RIGHT SIDE
            ========================================== -->

            <div
              class="lg:min-w-[190px] lg:text-right shrink-0">


              <!-- FINAL TOTAL -->
              <p
                class="text-lg font-extrabold text-[#FF462D]">

                ₹${formatMoney(
                  totalAmount
                )}

              </p>


              <p
                class="text-[9px] text-slate-400 mt-0.5">

                Total booking amount

              </p>


              <!-- =======================================
                   FARE BREAKDOWN
              ======================================== -->

              <div
                class="mt-2 text-[9px] text-slate-400 lg:text-right leading-relaxed">

                <div>
                  Base: ₹${formatMoney(
                    baseAmount
                  )}
                </div>

                <div>
                  GST 18%: ₹${formatMoney(
                    gstAmount
                  )}
                </div>

                <div>
                  Security: ₹${formatMoney(
                    securityDeposit
                  )}
                </div>

              </div>


              <!-- STATUS -->
              <div
                class="flex lg:justify-end mt-3">

                <span
                  class="inline-flex items-center gap-1.5
                  ${config.bg}
                  ${config.text}
                  text-[9px]
                  font-extrabold
                  px-2.5
                  py-1.5
                  rounded-lg
                  uppercase">


                  <i
                    data-lucide="${config.icon}"
                    class="w-3.5 h-3.5">
                  </i>


                  ${config.label}


                </span>

              </div>


              <!-- =======================================
                   UPDATE BUTTON
              ======================================== -->

              ${
                status !== "cancelled" &&
                status !== "completed"

                  ? `

                    <a
                      href="/Customerbooking"
                      class="mt-3 inline-flex items-center justify-center gap-1.5 w-full lg:w-auto bg-[#FF7A00] hover:bg-[#E66E00] text-white text-[10px] font-bold px-4 py-2.5 rounded-lg transition shadow-sm shadow-[#FF7A00]/25">

                      <i
                        data-lucide="edit-3"
                        class="w-3.5 h-3.5">
                      </i>

                      Update

                    </a>

                  `

                  : ""
              }


              <!-- BOOKING ID -->
              ${
                bookingId

                  ? `

                    <p
                      class="text-[8px] text-slate-300 mt-2">

                      Booking #
                      ${escapeHtml(
                        String(
                          bookingId
                        ).slice(-8)
                      )}

                    </p>

                  `

                  : ""
              }


            </div>


          </div>

        </div>

      `;

    }


    /* =====================================================
       REFRESH DASHBOARD
    ===================================================== */

    let refreshing = false;


    async function refreshDashboard() {

      if (refreshing) {
        return;
      }


      refreshing = true;


      try {

        await Promise.all([
          loadMyCars(),
          loadBookings()
        ]);

      } catch (error) {

        console.error(
          "Dashboard refresh error:",
          error
        );

      } finally {

        refreshing = false;

      }

    }


    /* =====================================================
       INITIAL LOAD
    ===================================================== */

    refreshDashboard();


    /* =====================================================
       AUTO REFRESH
    ===================================================== */

    setInterval(
      refreshDashboard,
      5000
    );


    setInterval(
      updateDate,
      60000
    );


    /* =====================================================
       REFRESH WHEN TAB BECOMES ACTIVE
    ===================================================== */

    document.addEventListener(
      "visibilitychange",
      () => {

        if (
          document.visibilityState ===
          "visible"
        ) {

          refreshDashboard();

        }

      }
    );

  </script>

</body>

</html>