<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>RideWave Admin Dashboard</title>

  <link rel="icon" type="image/png" href="/images/title.png.jpeg">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>

    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .modal-scroll::-webkit-scrollbar {
      width: 5px;
    }

    .modal-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }


    /* =====================================================
       FLASH MESSAGE
    ===================================================== */

    #flashMessage {
      position: fixed;
      top: 25px;
      right: 25px;
      z-index: 9999;

      min-width: 320px;
      max-width: 400px;

      padding: 15px 18px;

      border-radius: 14px;

      display: flex;
      align-items: center;
      gap: 12px;

      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);

      transform: translateX(450px);
      opacity: 0;

      transition: all 0.35s ease;

      pointer-events: none;
    }


    #flashMessage.show {
      transform: translateX(0);
      opacity: 1;
    }


    /* SUCCESS */

    #flashMessage.success {
      background: green;
      border: 1px solid #a7f3d0;
      color: white;
    }


    #flashMessage.success .flash-icon {
      background: green;
      color: white;
    }


    /* ERROR */

    #flashMessage.error {
      background: #be123c;
      border: 1px solid #fecdd3;
      color: white;
    }


    #flashMessage.error .flash-icon {
      background: #be123c;
      color: white;
    }


    .flash-icon {
      width: 38px;
      height: 38px;

      border-radius: 10px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;
    }


    .flash-content {
      flex: 1;
    }


    .flash-title {
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 2px;
    }


    .flash-text {
      font-size: 11px;
      font-weight: 500;
      opacity: 0.85;
      line-height: 1.4;
    }


    /* MOBILE FLASH */

    @media (max-width: 640px) {

      #flashMessage {
        top: 15px;
        left: 15px;
        right: 15px;

        min-width: auto;
        max-width: none;

        transform: translateY(-150px);
      }


      #flashMessage.show {
        transform: translateY(0);
      }

    }

  </style>

</head>


<body class="bg-[#F8FAFC] text-slate-800 flex min-h-screen relative">


  <!-- =====================================================
       FLASH MESSAGE
  ===================================================== -->

  <div id="flashMessage">

    <div class="flash-icon">

      <i
        id="flashIcon"
        data-lucide="check-circle-2"
        class="w-5 h-5"
      ></i>

    </div>


    <div class="flash-content">

      <div
        id="flashTitle"
        class="flash-title"
      >
        Success
      </div>


      <div
        id="flashText"
        class="flash-text"
      >
        Booking updated successfully.
      </div>

    </div>

  </div>



  <!-- =====================================================
       SIDEBAR
  ===================================================== -->

  <aside
    class="w-64 bg-[#0B1536] text-white flex flex-col justify-between p-6 shrink-0"
  >

    <div>

      <!-- LOGO -->

      <div class="flex items-center gap-2 mb-10">

        <span
          class="text-2xl font-bold tracking-tight text-white"
        >
          Ride<span class="text-[#FF462D]">Wave</span>
        </span>


        <span
          class="bg-[#FF462D]/15 text-[#FF462D] text-[10px] font-bold px-2 py-0.5 rounded tracking-wider uppercase"
        >
          ADMIN
        </span>

      </div>



      <!-- NAVIGATION -->

      <div class="space-y-6">

        <div>

          <p
            class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3"
          >
            Main
          </p>


          <nav class="space-y-1.5">

            <!-- DASHBOARD -->

            <a
              href="/admin"
              class="flex items-center gap-3.5 px-4 py-3 bg-[#FF462D] text-white rounded-xl font-medium shadow-md shadow-[#FF462D]/20"
            >

              <i
                data-lucide="layout-grid"
                class="w-5 h-5"
              ></i>

              <span>Dashboard</span>

            </a>



            <!-- CARS -->

            <a
              href="/carAdmin"
              class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition"
            >

              <i
                data-lucide="car"
                class="w-5 h-5"
              ></i>

              <span>Rental Cars</span>

            </a>



            <!-- BOOKINGS -->

            <a
              href="/Customerbooking"
              class="flex items-center justify-between px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition"
            >

              <div class="flex items-center gap-3.5">

                <i
                  data-lucide="calendar"
                  class="w-5 h-5"
                ></i>

                <span>Bookings</span>

              </div>


              <span
                id="sidebarPendingCount"
                class="bg-[#FF9F1C] text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center"
              >
                0
              </span>

            </a>

          </nav>

        </div>



        <!-- OTHER -->

        <div>

          <p
            class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3"
          >
            Other
          </p>


          <nav class="space-y-1.5">

            <a
              href="/"
              class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition"
            >

              <i
                data-lucide="arrow-left"
                class="w-5 h-5"
              ></i>

              <span>Back to Site</span>

            </a>

          </nav>

        </div>

      </div>

    </div>



    <!-- FOOTER -->

    <div
      class="pt-6 border-t border-slate-800 flex items-center gap-2 text-xs text-slate-500"
    >

      <i
        data-lucide="shield"
        class="w-4 h-4 text-[#FF462D]"
      ></i>

      <span>Admin Panel</span>

    </div>

  </aside>



  <!-- =====================================================
       MAIN
  ===================================================== -->

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">


    <!-- HEADER -->

    <header class="p-8 pb-4 flex justify-between items-start">

      <div>

        <h1
