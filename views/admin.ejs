<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RideWave Admin Dashboard</title>
  <link rel="icon" type="image/png" href="/images/title.png.jpeg">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
</head>
<body class="bg-[#F8FAFC] text-slate-800 flex min-h-screen relative">

  <aside class="w-64 bg-[#0B1536] text-white flex flex-col justify-between p-6 shrink-0">
    <div>
      <div class="flex items-center gap-2 mb-10">
        <span class="text-2xl font-bold tracking-tight text-white">Ride<span class="text-[#FF462D]">Wave</span></span>
        <span class="bg-[#FF462D]/15 text-[#FF462D] text-[10px] font-bold px-2 py-0.5 rounded tracking-wider uppercase">ADMIN</span>
      </div>

      <div class="space-y-6">
        <div>
          <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">Main</p>
          <nav class="space-y-1.5">
            <a href="/admin" class="flex items-center gap-3.5 px-4 py-3 bg-[#FF462D] text-white rounded-xl font-medium shadow-md shadow-[#FF462D]/20 transition-all duration-200">
              <i data-lucide="layout-grid" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
            
            <a href="/carAdmin" class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">
              <i data-lucide="car" class="w-5 h-5"></i>
              <span>Rental Cars</span>
            </a>

            <a href="/Customerbooking" class="flex items-center justify-between px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">
              <div class="flex items-center gap-3.5">
                <i data-lucide="calendar" class="w-5 h-5"></i>
                <span>Bookings</span>
              </div>
              <span class="bg-[#FF9F1C] text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">
                <%= typeof pendingBookingsCount !== 'undefined' ? pendingBookingsCount : 0 %>
              </span>
            </a>
          </nav>
        </div>

        <div>
          <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">Other</p>
          <nav class="space-y-1.5">
            <a href="/" class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">
              <i data-lucide="arrow-left" class="w-5 h-5"></i>
              <span>Back to Site</span>
            </a>
          </nav>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-slate-800 flex items-center gap-2 text-xs text-slate-500">
      <i data-lucide="shield" class="w-4 h-4 text-[#FF462D]"></i>
      <span>Admin Panel</span>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <header class="p-8 pb-4 flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-[#0B1536]">Dashboard</h1>
      </div>
      <p class="text-sm text-slate-400 font-normal">Welcome back! Here's an overview of your fleet.</p>
    </header>

    <div class="p-8 pt-2 space-y-8">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center text-[#FF462D] shrink-0">
            <i data-lucide="car" class="w-6 h-6"></i>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-[#0B1536]">
              <%= typeof totalCars !== 'undefined' ? totalCars : 0 %>
            </div>
            <div class="text-xs font-medium text-slate-400">Total Cars</div>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-500 shrink-0">
            <i data-lucide="grid-2x2" class="w-6 h-6"></i>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-[#0B1536]">
              <%= typeof totalCategories !== 'undefined' ? totalCategories : 0 %>
            </div>
            <div class="text-xs font-medium text-slate-400">Categories</div>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500 shrink-0">
            <i data-lucide="dollar-sign" class="w-6 h-6"></i>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-[#0B1536]">
              $<%= typeof avgPrice !== 'undefined' ? avgPrice : 0 %>
            </div>
            <div class="text-xs font-medium text-slate-400">Avg Price/Day</div>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-500 shrink-0">
            <i data-lucide="clock-3" class="w-6 h-6"></i>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-[#0B1536]">
              <%= typeof pendingBookingsCount !== 'undefined' ? pendingBookingsCount : 0 %>
            </div>
            <div class="text-xs font-medium text-slate-400">Pending Bookings</div>
          </div>
        </div>
      </div>

      <div>
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg font-bold text-[#0B1536]">Recent Bookings</h2>
          <a href="/Customerbooking" class="text-xs font-semibold text-[#FF462D] hover:underline flex items-center gap-1">
            View All <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
          </a>
        </div>

        <div class="space-y-3">
          <% if (typeof recentBookings !== 'undefined' && recentBookings.length > 0) { %>
            <% recentBookings.forEach(booking => { %>
              <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-slate-200 transition-all">
                <div class="flex items-center gap-5">
                  <div class="w-24 h-16 bg-slate-50 rounded-xl flex items-center justify-center p-2 shrink-0 border border-slate-100">
                    <img src="<%= (booking.car && booking.car.image) ? booking.car.image : 'https://purepng.com/public/uploads/large/purepng.com-green-porsche-macan-carcarvehicletransportporsche-9615246473185h93i.png' %>" alt="<%= booking.car ? booking.car.name : 'Car' %>" class="max-h-full object-contain" />
                  </div>
                  <div class="space-y-1">
                    <h3 class="font-bold text-[#0B1536] text-base leading-tight"><%= booking.car ? booking.car.name : 'Rental Vehicle' %></h3>
                    <div class="flex items-center gap-1.5 text-xs text-slate-400">
                      <i data-lucide="user" class="w-3.5 h-3.5"></i>
                      <span><%= booking.name %> (<span class="text-slate-500"><%= booking.email %></span>)</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 pt-0.5">
                      <span class="flex items-center gap-1">
                        <i data-lucide="calendar" class="w-3.5 h-3.5"></i> 
                        <%= new Date(booking.pickupDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> &rarr; <%= new Date(booking.returnDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                      </span>
                      <span class="flex items-center gap-1">
                        <i data-lucide="map-pin" class="w-3.5 h-3.5"></i> <%= booking.pickupLocation %>
                      </span>
                    </div>
                  </div>
                </div>

                <div class="flex md:flex-col items-end justify-between w-full md:w-auto gap-2 self-stretch md:self-auto">
                  <div class="text-right">
                    <div class="text-base font-bold text-[#FF462D]">$<%= booking.totalPrice %></div>
                    <% if (booking.status === 'Pending') { %>
                      <span class="inline-block bg-amber-50 text-amber-600 text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">Pending</span>
                    <% } else if (booking.status === 'Confirm') { %>
                      <span class="inline-block bg-emerald-50 text-emerald-600 text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">Confirmed</span>
                    <% } else if (booking.status === 'Complete') { %>
                      <span class="inline-block bg-sky-50 text-sky-600 text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">Completed</span>
                    <% } else { %>
                      <span class="inline-block bg-rose-50 text-rose-500 text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">Cancelled</span>
                    <% } %>
                  </div>
                  <button data-booking-id="<%= booking._id %>" class="open-modal-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Update
                  </button>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="bg-white p-8 rounded-2xl border border-slate-100 text-center text-sm text-slate-400">
              No recent bookings found.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <div id="updateModal" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0B1536]/40 backdrop-blur-sm hidden transition-all duration-200 p-4">
    <div class="bg-white w-full max-w-[480px] rounded-3xl p-8 shadow-2xl relative border border-slate-100">
      
      <button id="closeModalBtn" type="button" class="absolute top-6 right-6 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-700 transition">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="text-center mb-7">
        <h2 class="text-2xl font-extrabold text-[#FF462D]">Update Status</h2>
        <p id="modalBookingId" class="text-xs font-semibold text-slate-400 mt-1">Booking #</p>
      </div>

      <div class="grid grid-cols-4 gap-3 mb-6">
        <button type="button" class="status-btn border-2 border-emerald-500 bg-emerald-50 text-emerald-600 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all hover:shadow-md" data-status="Confirm">
          <i data-lucide="check-circle-2" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Confirm</span>
        </button>

        <button type="button" class="status-btn border border-slate-200 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-600 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all" data-status="Complete">
          <i data-lucide="check-check" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Complete</span>
        </button>

        <button type="button" class="status-btn border border-slate-200 hover:border-rose-400 hover:bg-rose-50 hover:text-rose-600 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all" data-status="Cancel">
          <i data-lucide="x-circle" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Cancel</span>
        </button>

        <button type="button" class="status-btn border border-slate-200 hover:border-amber-400 hover:bg-amber-50 hover:text-amber-600 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all" data-status="Pending">
          <i data-lucide="clock" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Pending</span>
        </button>
      </div>

      <form id="statusUpdateForm">
        <div class="space-y-2 mb-6">
          <label class="text-xs font-bold text-slate-700 block">Reason / Note <span class="font-normal text-slate-400">(optional)</span></label>
          <textarea 
            id="modalNoteInput"
            rows="3" 
            placeholder="Add a reason or note for the customer..." 
            class="w-full border border-slate-200 rounded-2xl p-3.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] transition resize-none"></textarea>
        </div>

        <button type="submit" id="submitUpdateBtn" class="w-full py-3.5 bg-[#FF462D] hover:bg-[#e03a22] text-white font-bold rounded-2xl text-sm shadow-md shadow-[#FF462D]/25 transition active:scale-[0.99]">
          Update Status
        </button>
      </form>

    </div>
  </div>

  <script>
    lucide.createIcons();

    const modal = document.getElementById('updateModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const modalBookingId = document.getElementById('modalBookingId');
    const statusBtns = document.querySelectorAll('.status-btn');
    const statusForm = document.getElementById('statusUpdateForm');
    const modalNoteInput = document.getElementById('modalNoteInput');
    const submitBtn = document.getElementById('submitUpdateBtn');

    let currentSelectedBookingId = null;
    let selectedStatus = 'Confirm';

    const statusStyles = {
      Confirm: { border: 'border-emerald-500', bg: 'bg-emerald-50', text: 'text-emerald-600' },
      Complete: { border: 'border-sky-500', bg: 'bg-sky-50', text: 'text-sky-600' },
      Cancel: { border: 'border-rose-500', bg: 'bg-rose-50', text: 'text-rose-600' },
      Pending: { border: 'border-amber-500', bg: 'bg-amber-50', text: 'text-amber-600' }
    };

    // Open Modal Event
    document.querySelectorAll('.open-modal-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentSelectedBookingId = btn.getAttribute('data-booking-id');
        modalBookingId.textContent = `Booking #${currentSelectedBookingId}`;
        modalNoteInput.value = '';
        
        // Reset to Confirm status by default
        selectedStatus = 'Confirm';
        statusBtns.forEach(b => {
          b.className = 'status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all';
        });
        const defaultBtn = document.querySelector('.status-btn[data-status="Confirm"]');
        if (defaultBtn) {
          defaultBtn.className = 'status-btn border-2 border-emerald-500 bg-emerald-50 text-emerald-600 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all shadow-sm';
        }

        modal.classList.remove('hidden');
      });
    });

    // Close Modal
    function closeModal() {
      modal.classList.add('hidden');
      currentSelectedBookingId = null;
    }

    closeModalBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Status Tab Switcher
    statusBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        statusBtns.forEach(b => {
          b.className = 'status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all';
        });

        selectedStatus = btn.getAttribute('data-status');
        const style = statusStyles[selectedStatus];
        btn.className = `status-btn border-2 ${style.border} ${style.bg} ${style.text} rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all shadow-sm`;
      });
    });

    // Handle Form Submit to Backend API
    statusForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!currentSelectedBookingId) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Updating...';

      try {
        const response = await fetch('/Customerbooking/update-status', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            bookingId: currentSelectedBookingId,
            status: selectedStatus,
            note: modalNoteInput.value
          })
        });

        const result = await response.json();

        if (result.success) {
          closeModal();
          window.location.reload();
        } else {
          alert(result.message || 'Status update failed.');
        }
      } catch (err) {
        console.error('Fetch Error:', err);
        alert('Server communication error.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Update Status';
      }
    });
  </script>
</body>
</html>