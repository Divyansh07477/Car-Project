    </header>



    <div class="p-8 pt-2 space-y-8">


      <!-- =====================================================
           STATS
      ===================================================== -->

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5"
      >


        <!-- TOTAL CARS -->

        <div
          class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4"
        >

          <div
