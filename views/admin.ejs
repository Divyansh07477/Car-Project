<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RideWave Admin Dashboard</title>
     <link rel="icon" type="image/png" href="images/title.png.jpeg">
    <!-- Yahi wo line hai jisse saari styling aayegi -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #fafafa; }
    </style>
</head>
<body class="text-gray-800">

    <!-- Top Navigation -->
    <div class="bg-white border-b border-gray-100 px-8 py-4 flex justify-between items-center">
        <!-- Logo -->
        <div class="text-xl font-bold">
            <span class="text-slate-800">Ride</span><span class="text-orange-500">Wave</span>
        </div>
        
        <!-- Admin Badge -->
        <div class="bg-red-50 text-red-500 px-4 py-1.5 rounded-full flex items-center gap-2 text-sm font-medium">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.642 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.358-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"></path></svg>
            Admin Dashboard
        </div>

        <!-- Back to Site -->
        <a href="/" class="text-gray-400 text-sm font-medium flex items-center gap-1 hover:text-gray-600">
            &larr; Back to Site
        </a>
    </div>

    <!-- Main Content -->
    <div class="max-w-6xl mx-auto p-8">
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <!-- Card 1 -->
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-center gap-4">
                <div class="bg-red-50 p-3 rounded-lg text-red-500">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m8 0h1M5 15h2a2 2 0 002-2v-4a2 2 0 012-2h4a2 2 0 012 2v4a2 2 0 002 2h2M5 15v2a2 2 0 002 2h10a2 2 0 002-2v-2"></path></svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-slate-800">6</div>
                    <div class="text-xs text-gray-400 font-medium">Total Cars</div>
                </div>
            </div>
            
            <!-- Card 2 -->
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-center gap-4">
                <div class="bg-green-50 p-3 rounded-lg text-green-500">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-slate-800">1</div>
                    <div class="text-xs text-gray-400 font-medium">Categories</div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-center gap-4">
                <div class="bg-blue-50 p-3 rounded-lg text-blue-500">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-slate-800">$299</div>
                    <div class="text-xs text-gray-400 font-medium">Avg Price/Day</div>
                </div>
            </div>
        </div>

        <!-- Section Header -->
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-slate-800">Rental Cars</h2>
            <button class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2 rounded-lg text-sm font-medium flex items-center gap-2 transition-colors">
                <span>+</span> Add New Car
            </button>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white border-b border-gray-100 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                        <th class="px-6 py-4">Image</th>
                        <th class="px-6 py-4">Name</th>
                        <th class="px-6 py-4 text-center">Category</th>
                        <th class="px-6 py-4 text-center">Transmission</th>
                        <th class="px-6 py-4 text-center">Price/Day</th>
                        <th class="px-6 py-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-sm font-medium text-slate-700">
                    
                    <!-- Row 1 -->
                    <tr class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <!-- Image sizing yaha fix hai -->
                            <div class="w-16 h-10 bg-gray-100 rounded flex items-center justify-center overflow-hidden">
                                <img src="/images/your-car-image.jpg" alt="Car" class="w-full h-full object-contain">
                            </div>
                        </td>
                        <td class="px-6 py-4">Rolls-Royce</td>
                        <td class="px-6 py-4 text-center">
                            <span class="bg-red-50 text-red-500 px-3 py-1 rounded-full text-xs">Sedan</span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="bg-blue-50 text-blue-500 px-3 py-1 rounded-full text-xs">Automatic</span>
                        </td>
                        <td class="px-6 py-4 text-center text-slate-800 font-bold">$299<span class="text-gray-400 font-normal text-xs">/day</span></td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex justify-center gap-2">
                                <button class="bg-blue-50 text-blue-500 p-2 rounded-md hover:bg-blue-100"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                                <button class="bg-red-50 text-red-500 p-2 rounded-md hover:bg-red-100"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                            </div>
                        </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="w-16 h-10 bg-gray-100 rounded flex items-center justify-center overflow-hidden">
                                <img src="/images/your-car-image.jpg" alt="Car" class="w-full h-full object-contain">
                            </div>
                        </td>
                        <td class="px-6 py-4">Macan 4</td>
                        <td class="px-6 py-4 text-center">
                            <span class="bg-red-50 text-red-500 px-3 py-1 rounded-full text-xs">Sedan</span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="bg-blue-50 text-blue-500 px-3 py-1 rounded-full text-xs">Automatic</span>
                        </td>
                        <td class="px-6 py-4 text-center text-slate-800 font-bold">$299<span class="text-gray-400 font-normal text-xs">/day</span></td>
                        <td class="px-6 py-4 text-center">
                            <div class="flex justify-center gap-2">
                                <button class="bg-blue-50 text-blue-500 p-2 rounded-md hover:bg-blue-100"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                                <button class="bg-red-50 text-red-500 p-2 rounded-md hover:bg-red-100"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
</body>
</html>