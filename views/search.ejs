
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RideWave - Search Cars</title>

    <link rel="icon" type="image/png" href="/images/title.png.jpeg">

    <!-- Boxicons -->
    <link
        href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
        rel="stylesheet"
    >

    <!-- Google Font - SAME AS STYLE.CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
        rel="stylesheet"
    >

    <style>

        /* =====================================================
           ROOT / RESET
        ===================================================== */

        * {
            font-family: "Outfit", sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        :root {
            --main-color: #e53f28;
            --text-color: #071344;
            --bg-color: #fff;
            --hover-color: hsl(7, 78%, 48%);
            --container-color: #6c7283;
        }

        html::-webkit-scrollbar {
            width: 0.5rem;
            background: transparent;
        }

        html::-webkit-scrollbar-thumb {
            background: var(--main-color);
        }

        body {
            color: var(--text-color);
            background: #fff;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
        }

        img {
            width: 100%;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        header {
            width: 100%;
            height: 90px;
            background: #fff;
            border-bottom: 1px solid #eee;
            box-shadow: 0 1px 4px hsl(0deg 4% 15% / 10%);
            position: sticky;
            top: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
        }

        .nav {
            max-width: 1200px;
            height: 90px;
            margin-left: -20px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            width: 200px;
            height: 90px;
            flex-shrink: 0;
        }

        .logo img {
            width: 100%;
            height: 90px;
            object-fit: contain;
            display: block;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 17px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .back-btn i {
            font-size: 18px;
            transition: transform 0.3s ease;
        }

        .back-btn:hover {
            color: var(--main-color);
            border-color: var(--main-color);
            transform: translateX(-3px);
        }

        .back-btn:hover i {
            transform: translateX(-4px);
        }


        /* =====================================================
           HERO
        ===================================================== */

        .hero {
            width: 100%;
            max-width: 1060px;
            margin: auto;
            padding: 55px 20px 35px;
            text-align: center;
        }

        .hero-small {
            color: var(--main-color);
            font-size: 0.875rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .hero h1 {
            font-size: 2.5rem;
            line-height: 1.2;
            color: var(--text-color);
            font-weight: 700;
        }

        .hero h1 span {
            color: var(--main-color);
        }

        .hero p {
            max-width: 650px;
            margin: 15px auto 0;
            color: var(--container-color);
            font-size: 0.95rem;
            line-height: 1.6;
        }


        /* =====================================================
           SEARCH
        ===================================================== */

        .search-wrapper {
            width: 100%;
            max-width: 1060px;
            margin: auto;
            padding: 0 20px 35px;
        }

        .search-box {
            width: 100%;
            min-height: 62px;
            display: flex;
            align-items: center;
            padding: 6px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
            transition: all 0.3s ease;
        }

        .search-box:focus-within {
            border-color: var(--main-color);
            box-shadow: 0 10px 30px rgba(229, 63, 40, 0.12);
        }

        .search-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            flex-shrink: 0;
        }

        .search-icon i {
            font-size: 23px;
        }

        .search-box:focus-within .search-icon {
            color: var(--main-color);
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            height: 50px;
            border: none;
            outline: none;
            background: transparent;
            color: var(--text-color);
            font-size: 14px;
        }

        .search-box input::placeholder {
            color: #94a3b8;
        }

        .search-btn {
            height: 50px;
            padding: 0 27px;
            border: none;
            border-radius: 9px;
            background: var(--main-color);
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .search-btn:hover {
            background: var(--hover-color);
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(229, 63, 40, 0.22);
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .main-container {
            width: 100%;
            max-width: 1060px;
            margin: auto;
            padding: 0 0 70px;
        }


        /* =====================================================
           TOP BAR
        ===================================================== */

        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
        }

        .results-title {
            color: var(--text-color);
            font-size: 1.8rem;
            font-weight: 700;
        }

        .results-title span {
            color: var(--main-color);
        }

        .sort-box {
            min-width: 190px;
            padding: 11px 14px;
            border-radius: 9px;
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #475569;
            outline: none;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }


        /* =====================================================
           FILTERS
        ===================================================== */

        .filters {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .filter-btn {
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #64748b;
            padding: 9px 17px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .filter-btn:hover {
            border-color: var(--main-color);
            color: var(--main-color);
        }

        .filter-btn.active {
            background: var(--main-color);
            border-color: var(--main-color);
            color: #fff;
            box-shadow: 0 5px 15px rgba(229, 63, 40, 0.20);
        }


        /* =====================================================
           CAR GRID
           SAME AS HOME
        ===================================================== */

        .cars-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }


        /* =====================================================
           RENTAL CARD
           EXACT HOME STYLE
        ===================================================== */

        .rental-box {
            position: relative;
            padding: 20px;
            display: flex;
            flex-direction: column;

            background: #f6f6f6;

            border-radius: 0.4rem;

            overflow: hidden;

            transform-style: preserve-3d;

            border: 1px solid transparent;

            transition:
                transform 0.45s cubic-bezier(.2,.8,.2,1),
                box-shadow 0.45s ease,
                border-color 0.3s ease;
        }


        /* =====================================================
           ORANGE GLOW
        ===================================================== */

        .rental-box::before {
            content: "";

            position: absolute;

            width: 180px;
            height: 180px;

            border-radius: 50%;

            background: rgba(255, 85, 0, 0.18);

            filter: blur(60px);

            top: -80px;
            right: -80px;

            opacity: 0;

            transition: opacity 0.4s ease;

            pointer-events: none;
        }


        /* =====================================================
           CARD HOVER
        ===================================================== */

        .rental-box:hover {
            transform: translateY(-14px) scale(1.025);

            box-shadow:
                0 25px 45px rgba(0, 0, 0, 0.25),
                0 0 25px rgba(255, 85, 0, 0.18);

            border-color: rgba(255, 85, 0, 0.35);
        }

        .rental-box:hover::before {
            opacity: 1;
        }


        /* =====================================================
           RENTAL TOP
        ===================================================== */

        .rental-top {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 0.5rem;
        }

        .rental-top h4 {
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--container-color);

            transition: color 0.3s ease;
        }

        .rental-box:hover h4 {
            color: #ff5500;
        }

        .rental-top .bx {
            font-size: 1.3rem;
            cursor: pointer;
            color: var(--main-color);
        }


        /* =====================================================
           HEART ANIMATION
        ===================================================== */

        .rental-box .bx-heart {
            transition:
                transform 0.35s ease,
                color 0.3s ease;
        }

        .rental-box:hover .bx-heart {
            transform: scale(1.2) rotate(-8deg);
            color: #ff5500;
        }


        /* =====================================================
           CAR IMAGE
           EXACT HOME SIZE
        ===================================================== */

        .rental-box img {
            width: 100%;
            height: 150px;

            object-fit: contain;
            object-position: center;

            margin-bottom: 1rem;

            border-radius: 1rem;

            transition:
                transform 0.55s cubic-bezier(.2,.8,.2,1),
                filter 0.4s ease;
        }


        /* =====================================================
           IMAGE HOVER
        ===================================================== */

        .rental-box:hover img {
            transform: translateY(-8px) scale(1.08);

            filter:
                drop-shadow(0 15px 15px rgba(0,0,0,.25))
                drop-shadow(0 0 12px rgba(255,85,0,.25));
        }


        /* =====================================================
           CAR NAME
        ===================================================== */

        .rental-box h3 {
            font-size: 1.125rem;
            font-weight: 600;

            transition:
                transform 0.35s ease,
                color 0.35s ease;
        }

        .rental-box:hover h3 {
            transform: translateX(5px);
            color: #ff5500;
        }


        /* =====================================================
           TRANSMISSION
        ===================================================== */

        .car-transmission {
            font-size: 0.8rem;
            font-weight: 500;

            margin-bottom: 0.5rem;

            color: var(--container-color);

            display: block;
        }


        /* =====================================================
           AVAILABILITY
        ===================================================== */

        .car-availability {
            margin: 12px 0;
            padding: 10px 12px;

            border-radius: 10px;

            font-size: 13px;

            line-height: 1.4;
        }

        .car-availability i {
            font-size: 16px;
            margin-right: 5px;
            vertical-align: middle;
        }

        .car-availability.available {
            background: #ecfdf5;
            color: #047857;
        }

        .car-availability.booked {
            background: #fff7ed;
            color: #c2410c;
        }

        .car-availability.booked div {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .car-availability.booked small {
            display: block;

            margin-top: 4px;
            margin-left: 21px;

            font-size: 11px;

            color: #9a3412;
        }

        .car-availability.unavailable {
            background: #fef2f2;
            color: #dc2626;
        }


        /* =====================================================
           BOTTOM
           EXACT HOME STYLE
        ===================================================== */

        .rental-btn-wrapper {
            width: 100%;

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-top: 1rem;
        }

        .rental-btn-wrapper .price {
            font-size: 1.125rem;
            font-weight: 600;

            color: var(--text-color);
        }

        .rental-btn-wrapper .price span {
            font-size: 0.8rem;
            font-weight: 400;

            color: var(--text-color);
        }


        /* =====================================================
           RENT BUTTON
        ===================================================== */

        .rental-btn {
            padding: 8px 20px;

            background: var(--main-color);

            color: var(--bg-color);

            font-weight: 400;

            border-radius: 0;

            display: inline-block;

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                background 0.3s ease;
        }

        .rental-btn:hover {
            background: var(--hover-color);
        }

        .rental-box:hover .rental-btn {
            transform: translateY(-3px);

            box-shadow:
                0 8px 18px rgba(255, 85, 0, 0.25);
        }


        /* =====================================================
           EMPTY STATE
        ===================================================== */

        .empty-state {
            display: none;

            width: 100%;

            text-align: center;

            padding: 70px 20px;

            color: var(--container-color);
        }

        .empty-state i {
            font-size: 50px;
            color: var(--main-color);
            margin-bottom: 12px;
        }

        .empty-state h3 {
            font-size: 1.3rem;
            margin-bottom: 6px;
        }


        /* =====================================================
           LOADER
        ===================================================== */

        .loader {
            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            padding: 60px 20px;

            color: var(--container-color);

            font-size: 14px;
        }

        .loader i {
            font-size: 40px;

            color: var(--main-color);

            margin-bottom: 10px;

            animation: rotate 1s linear infinite;
        }

        @keyframes rotate {

            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }

        }


        /* =====================================================
           FLASH MESSAGE
        ===================================================== */

        .flash-message {
            position: fixed;

            top: 90px;
            right: 25px;

            min-width: 280px;
            max-width: 400px;

            padding: 15px 22px;

            background: #22c55e;

            color: white;

            font-size: 15px;
            font-weight: 600;

            border-radius: 10px;

            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);

            opacity: 0;
            visibility: hidden;

            transform: translateX(120%);

            transition: all 0.3s ease;

            z-index: 99999;
        }

        .flash-message.show {
            opacity: 1;
            visibility: visible;
            transform: translateX(0);
        }

        .flash-message.error {
            background: #ef4444;
        }


        /* =====================================================
           RESPONSIVE
           SAME HOME CARD BREAKPOINTS
        ===================================================== */

        @media (max-width: 1150px) {

            .main-container {
                padding-left: 20px;
                padding-right: 20px;
            }

        }


        @media (max-width: 980px) {

            .cars-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
            }

        }


        @media (max-width: 880px) {

            .cars-grid {
                grid-template-columns: repeat(2, 271px);
                justify-content: center;
            }

        }


        @media (max-width: 740px) {

            .hero h1 {
                font-size: 2rem;
            }

            .top-bar {
                flex-direction: column;
                align-items: flex-start;
            }

            .sort-box {
                width: 100%;
            }

        }


        @media (max-width: 600px) {

            .nav {
                height: 70px;
                padding: 8px 15px;
            }

            header {
                height: 70px;
            }

            .logo {
                width: 125px;
                height: 60px;
            }

            .logo img {
                width: 125px;
                height: 60px;
            }

            .hero {
                padding: 45px 15px 30px;
            }

            .hero h1 {
                font-size: 1.9rem;
            }

            .search-wrapper {
                padding-left: 15px;
                padding-right: 15px;
            }

            .search-box {
                min-height: auto;
            }

            .search-box input {
                width: 100%;
            }

            .search-btn {
                padding: 0 15px;
            }

            .main-container {
                padding-left: 15px;
                padding-right: 15px;
            }

            .cars-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .rental-box {
                width: 100%;
            }

            .flash-message {
                top: 80px;
                right: 15px;
                left: 15px;
                min-width: auto;
                max-width: none;
                text-align: center;
            }

        }


        @media (max-width: 400px) {

            .hero h1 {
                font-size: 1.7rem;
            }

            .search-btn {
                padding: 0 12px;
            }

        }

    </style>

</head>


<body>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header>

        <div class="nav">

            <a href="/" class="logo">

                <img
                    src="/images/logo.png"
                    alt="RideWave"
                    onerror="this.style.display='none';"
                >

            </a>


            <a href="/" class="back-btn">

                <i class="bx bx-arrow-back"></i>

                Back to Home

            </a>

        </div>

    </header>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">

        <div class="hero-small">
            RideWave
        </div>

        <h1>
            Find Your
            <span>Perfect Ride</span>
        </h1>

        <p>
            Explore our collection of rental cars and find
            the perfect vehicle for your next journey.
        </p>

    </section>


    <!-- =====================================================
         SEARCH
    ====================================================== -->

    <div class="search-wrapper">

        <div class="search-box">

            <div class="search-icon">
                <i class="bx bx-search"></i>
            </div>

            <input
                type="text"
                id="searchInput"
                placeholder="Search by car name, category or transmission..."
                autocomplete="off"
            >

            <button
                type="button"
                id="searchBtn"
                class="search-btn"
            >
                Search
            </button>

        </div>

    </div>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="main-container">


        <!-- TOP BAR -->

        <div class="top-bar">

            <h2 class="results-title">
                Available <span>Cars</span>
            </h2>

            <select
                id="sortCars"
                class="sort-box"
            >

                <option value="default">
                    Sort By
                </option>

                <option value="low">
                    Price: Low to High
                </option>

                <option value="high">
                    Price: High to Low
                </option>

                <option value="name">
                    Name: A to Z
                </option>

            </select>

        </div>


        <!-- FILTERS -->

        <div class="filters">

            <button
                type="button"
                class="filter-btn active"
                data-category="all"
            >
                All
            </button>

            <button
                type="button"
                class="filter-btn"
                data-category="Sedan"
            >
                Sedan
            </button>

            <button
                type="button"
                class="filter-btn"
                data-category="SUV"
            >
                SUV
            </button>


            <button
                type="button"
                class="filter-btn"
                data-category="Luxury"
            >
                Luxury
            </button>

            <button
                type="button"
                class="filter-btn"
                data-category="Sports"
            >
                Sports
            </button>

        </div>


        <!-- LOADER -->

        <div
            id="loader"
            class="loader"
        >

            <i class="bx bx-loader-alt"></i>

            <span>
                Loading cars...
            </span>

        </div>


        <!-- CAR GRID -->

        <div
            id="carsGrid"
            class="cars-grid"
        ></div>


        <!-- EMPTY -->

        <div
            id="emptyState"
            class="empty-state"
        >

            <i class="bx bx-car"></i>

            <h3>
                No Cars Found
            </h3>

            <p>
                Try another search or category.
            </p>

        </div>

    </main>


    <!-- FLASH -->

    <div
        id="flashMessage"
        class="flash-message"
    ></div>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

        /* =====================================================
           ELEMENTS
        ===================================================== */

        const searchInput =
            document.getElementById("searchInput");

        const searchBtn =
            document.getElementById("searchBtn");

        const carsGrid =
            document.getElementById("carsGrid");

        const loader =
            document.getElementById("loader");

        const emptyState =
            document.getElementById("emptyState");

        const sortCars =
            document.getElementById("sortCars");

        const filterButtons =
            document.querySelectorAll(".filter-btn");

        const flashMessage =
            document.getElementById("flashMessage");


        let allCars = [];

        let activeCategory = "all";


        /* =====================================================
           FLASH
        ===================================================== */

        function showFlash(message, type = "success") {

            flashMessage.textContent = message;

            flashMessage.className =
                "flash-message show " + type;

            setTimeout(
                function() {

                    flashMessage.classList.remove(
                        "show"
                    );

                },
                3000
            );

        }


        /* =====================================================
           DATE FORMAT
        ===================================================== */

        function formatDate(dateValue) {

            if (!dateValue) {
                return "";
            }

            const date =
                new Date(dateValue);

            if (isNaN(date.getTime())) {
                return "";
            }

            return date.toLocaleDateString(
                "en-IN",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                }
            );

        }


        /* =====================================================
           LOAD CARS
        ===================================================== */

        async function loadCars() {

            try {

                loader.style.display = "flex";

                carsGrid.innerHTML = "";

                const response =
                    await fetch(
                        "/api/cars"
                    );

                const data =
                    await response.json();


                if (
                    !response.ok ||
                    !data.success
                ) {

                    throw new Error(
                        data.message ||
                        "Failed to load cars"
                    );

                }


                allCars =
                    Array.isArray(data.cars)
                        ? data.cars
                        : [];


                loader.style.display =
                    "none";


                renderCars();

            }
            catch (error) {

                console.error(
                    "Load Cars Error:",
                    error
                );

                loader.style.display =
                    "none";

                showFlash(
                    "Failed to load cars.",
                    "error"
                );

            }

        }


        /* =====================================================
           RENDER CARS
        ===================================================== */

        function renderCars() {

            let cars =
                [...allCars];


            /* SEARCH */

            const searchValue =
                searchInput
                    ? searchInput.value
                        .trim()
                        .toLowerCase()
                    : "";


            cars =
                cars.filter(
                    function(car) {

                        const name =
                            String(
                                car.name || ""
                            ).toLowerCase();

                        const category =
                            String(
                                car.category || ""
                            ).toLowerCase();

                        const transmission =
                            String(
                                car.transmission || ""
                            ).toLowerCase();


                        const matchesSearch =
                            !searchValue ||
                            name.includes(searchValue) ||
                            category.includes(searchValue) ||
                            transmission.includes(searchValue);


                        const matchesCategory =
                            activeCategory === "all" ||
                            category ===
                            activeCategory.toLowerCase();


                        return (
                            matchesSearch &&
                            matchesCategory
                        );

                    }
                );


            /* SORT */

            const sortValue =
                sortCars
                    ? sortCars.value
                    : "default";


            if (sortValue === "low") {

                cars.sort(
                    function(a, b) {

                        return (
                            Number(
                                a.pricePerDay || 0
                            ) -
                            Number(
                                b.pricePerDay || 0
                            )
                        );

                    }
                );

            }


            if (sortValue === "high") {

                cars.sort(
                    function(a, b) {

                        return (
                            Number(
                                b.pricePerDay || 0
                            ) -
                            Number(
                                a.pricePerDay || 0
                            )
                        );

                    }
                );

            }


            if (sortValue === "name") {

                cars.sort(
                    function(a, b) {

                        return String(
                            a.name || ""
                        ).localeCompare(
                            String(
                                b.name || ""
                            )
                        );

                    }
                );

            }


            /* CLEAR */

            carsGrid.innerHTML = "";


            /* EMPTY */

            if (cars.length === 0) {

                emptyState.style.display =
                    "block";

                return;

            }


            emptyState.style.display =
                "none";


            /* =================================================
               CREATE HOME-STYLE CARD
            ================================================= */

            cars.forEach(
                function(car) {

                    const card =
                        document.createElement(
                            "div"
                        );


                    /*
                     * IMPORTANT:
                     * SAME CLASS AS HOME
                     */

                    card.className =
                        "rental-box";


                    const image =
                        car.image ||
                        "/images/default-car.jpg";


                    const price =
                        Number(
                            car.pricePerDay || 0
                        ).toLocaleString(
                            "en-IN"
                        );


                    const category =
                        car.category ||
                        "Car";


                    const transmission =
                        car.transmission ||
                        "Automatic";


                    /* =================================================
                       AVAILABILITY
                    ================================================= */

                    let availabilityHTML = `

                        <div class="car-availability available">

                            <i class="bx bx-check-circle"></i>

                            Available for booking

                        </div>

                    `;


                    /*
                     * OWNER MANUALLY DISABLED CAR
                     */

                    if (
                        car.isAvailable === false
                    ) {

                        availabilityHTML = `

                            <div class="car-availability unavailable">

                                <i class="bx bx-x-circle"></i>

                                Currently unavailable

                            </div>

                        `;

                    }


                    /*
                     * CONFIRMED BOOKING EXISTS
                     */

                    else if (
                        Array.isArray(
                            car.bookedDates
                        ) &&
                        car.bookedDates.length > 0
                    ) {

                        const firstBooking =
                            car.bookedDates[0];


                        const bookedFrom =
                            formatDate(
                                firstBooking.startDate
                            );


                        const bookedUntil =
                            formatDate(
                                firstBooking.endDate
                            );


                        const availableAfter =
                            new Date(
                                firstBooking.endDate
                            );


                        availableAfter.setDate(
                            availableAfter.getDate() + 1
                        );


                        availabilityHTML = `

                            <div class="car-availability booked">

                                <div>

                                    <i class="bx bx-calendar-x"></i>

                                    <span>
                                        Booked:
                                        ${bookedFrom}
                                        -
                                        ${bookedUntil}
                                    </span>

                                </div>

                                <small>
                                    Available after
                                    ${formatDate(
                                        availableAfter
                                    )}
                                </small>

                            </div>

                        `;

                    }


                    /* =================================================
                       RENT BUTTON
                    ================================================= */

                    const rentButton =
                        car.isAvailable === false

                            ? `

                                <span
                                    class="rental-btn"
                                    style="
                                        opacity:0.55;
                                        cursor:not-allowed;
                                    "
                                >
                                    Unavailable
                                </span>

                            `

                            : `

                                <a
                                    href="/booking?car=${encodeURIComponent(
                                        car._id
                                    )}"
                                    class="rental-btn"
                                >
                                    Rent Now
                                </a>

                            `;


                    /* =================================================
                       EXACT HOME CARD HTML
                    ================================================= */

                    card.innerHTML = `

                        <div class="rental-top">

                            <h4>
                                ${category}
                            </h4>

                            <i class="bx bx-heart"></i>

                        </div>


                        <img
                            src="${image}"
                            alt="${car.name || "Car"}"
                            loading="lazy"
                            onerror="
                                this.src='/images/default-car.jpg';
                            "
                        >


                        <h3>
                            ${car.name || "Unnamed Car"}
                        </h3>


                        <span class="car-transmission">
                            ${transmission}
                        </span>


                        ${availabilityHTML}


                        <div class="rental-btn-wrapper">

                            <p class="price">

                                ₹${price}

                                <span>
                                    /day
                                </span>

                            </p>


                            ${rentButton}

                        </div>

                    `;


                    carsGrid.appendChild(
                        card
                    );

                }
            );

        }


        /* =====================================================
           LIVE SEARCH
        ===================================================== */

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                renderCars
            );

        }


        /* =====================================================
           SEARCH BUTTON
        ===================================================== */

        if (searchBtn) {

            searchBtn.addEventListener(
                "click",
                function(event) {

                    event.preventDefault();


                    const value =
                        searchInput.value.trim();


                    if (!value) {

                        window.location.href =
                            "/search";

                        return;

                    }


                    window.location.href =
                        "/search?q=" +
                        encodeURIComponent(
                            value
                        );

                }
            );

        }


        /* =====================================================
           ENTER SEARCH
        ===================================================== */

        if (searchInput) {

            searchInput.addEventListener(
                "keydown",
                function(event) {

                    if (
                        event.key === "Enter"
                    ) {

                        event.preventDefault();


                        const value =
                            searchInput.value.trim();


                        if (!value) {

                            window.location.href =
                                "/search";

                            return;

                        }


                        window.location.href =
                            "/search?q=" +
                            encodeURIComponent(
                                value
                            );

                    }

                }
            );

        }


        /* =====================================================
           FILTER
        ===================================================== */

        filterButtons.forEach(
            function(button) {

                button.addEventListener(
                    "click",
                    function() {

                        filterButtons.forEach(
                            function(btn) {

                                btn.classList.remove(
                                    "active"
                                );

                            }
                        );


                        this.classList.add(
                            "active"
                        );


                        activeCategory =
                            this.dataset.category ||
                            "all";


                        renderCars();

                    }
                );

            }
        );


        /* =====================================================
           SORT
        ===================================================== */

        if (sortCars) {

            sortCars.addEventListener(
                "change",
                renderCars
            );

        }
// =====================================================
// BOOKING LOGIN REDIRECT
// =====================================================

document.addEventListener("click", async function (event) {

    const bookButton = event.target.closest(".rental-btn");

    if (!bookButton) {
        return;
    }

    // Unavailable button ko ignore karo
    if (bookButton.tagName !== "A") {
        return;
    }

    event.preventDefault();

    const bookingUrl = bookButton.href;

    try {

        const response = await fetch("/api/auth/me", {
            method: "GET",
            credentials: "include"
        });

        const data = await response.json();

        console.log("Login Check:", data);

        if (data.loggedIn === true) {

            // ==========================================
            // USER LOGGED IN
            // DIRECTLY BOOKING PAGE
            // ==========================================

            window.location.href = bookingUrl;

        } else {

            // ==========================================
            // USER NOT LOGGED IN
            // SAVE CURRENT SEARCH PAGE
            // ==========================================

            const returnUrl =
                window.location.pathname +
                window.location.search;

            sessionStorage.setItem(
                "ridewaveReturnAfterLogin",
                returnUrl
            );

            window.location.href =
                "/login?returnTo=" +
                encodeURIComponent(returnUrl);
        }

    } catch (error) {

        console.error(
            "Login Check Error:",
            error
        );

        // Error hone par login page
        const returnUrl =
            window.location.pathname +
            window.location.search;

        window.location.href =
            "/login?returnTo=" +
            encodeURIComponent(returnUrl);
    }

});

        loadCars();

    </script>

</body>

</html>
