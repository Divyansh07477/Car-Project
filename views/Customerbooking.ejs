        const bookingStatus =
            getBookingStatus(booking);

        const paymentStatus =
            getPaymentStatus(booking);

        const carName =
            getCarName(booking);

        const renterName =
            getRenterName(booking);

        const renterEmail =
            getRenterEmail(booking);


        // =================================================
        // AMOUNT CALCULATION
        // =================================================

        const days =
            Math.max(
                1,
                Number(
                    booking?.totalDays
                ) || 1
            );


        const pricePerDay =
            Number(
                booking?.pricePerDay ??
                booking?.car?.pricePerDay ??
                0
            ) || 0;


        // Base Rental
        let baseAmount =
            Number(
                booking?.baseAmount
