          data-status="confirmed">

          <i data-lucide="check-circle-2" class="w-5 h-5"></i>

          <span class="text-xs font-bold">

            Confirm

          </span>

        </button>


        <button
          type="button"
          class="status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all"
          data-status="completed">

          <i data-lucide="check-check" class="w-5 h-5"></i>

          <span class="text-xs font-bold">

            Complete

