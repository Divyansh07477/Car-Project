        // =================================================

        const statusButtons =
            document.querySelectorAll(
                ".status-btn"
            );


        statusButtons.forEach(
            button => {

                const target =
                    button.dataset.status;


                button.disabled =
                    false;


                button.classList.remove(
                    "opacity-30",
                    "cursor-not-allowed"
                );


                let allowed =
                    false;


                if (
                    bookingStatus ===
                    "pending"
                ) {

                    allowed =
                        [
                            "confirmed",
                            "cancelled"
                        ].includes(
                            target
                        );

                }

                else if (
                    bookingStatus ===
                    "confirmed"
                ) {

                    allowed =
                        [
                            "completed",
                            "cancelled"
                        ].includes(
                            target
                        );
                }


                if (!allowed) {

                    button.disabled =
                        true;

                    button.classList.add(
                        "opacity-30",
                        "cursor-not-allowed"
                    );
