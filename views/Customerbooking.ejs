  <!-- ================= JAVASCRIPT ================= -->

  <script>

    lucide.createIcons();


    // =====================================================
    // VARIABLES
    // =====================================================

    const bookingsContainer =
      document.getElementById("bookingsContainer");

    const loadingState =
      document.getElementById("loadingState");

    const errorState =
      document.getElementById("errorState");

    const emptyState =
      document.getElementById("emptyState");

    const errorMessage =
      document.getElementById("errorMessage");

    const bookingCountText =
      document.getElementById("bookingCountText");

    const pendingSidebarCount =
      document.getElementById("pendingSidebarCount");

    const refreshBtn =
      document.getElementById("refreshBtn");

    const retryBtn =
      document.getElementById("retryBtn");

    const refreshIcon =
      document.getElementById("refreshIcon");


    const modal =
      document.getElementById("updateModal");

    const closeModalBtn =
      document.getElementById("closeModalBtn");

    const modalBookingId =
      document.getElementById("modalBookingId");

    const modalCarImage =
      document.getElementById("modalCarImage");

    const modalCarName =
      document.getElementById("modalCarName");

    const modalCustomerName =
      document.getElementById("modalCustomerName");

    const modalNoteInput =
      document.getElementById("modalNoteInput");

    const statusForm =
      document.getElementById("statusUpdateForm");

    const submitBtn =
      document.getElementById("submitUpdateBtn");


    // =====================================================
    // FLASH MESSAGE VARIABLES
    // =====================================================

    const flashMessage =
      document.getElementById("flashMessage");

    const flashIconBox =
      document.getElementById("flashIconBox");

    const flashTitle =
      document.getElementById("flashTitle");

    const flashText =
      document.getElementById("flashText");

    let flashTimer = null;


    // =====================================================
    // SHOW FLASH MESSAGE
    // =====================================================

    function showFlash(type, title, message) {

      clearTimeout(flashTimer);

      flashMessage.classList.remove(
        "success",
        "error",
        "show"
      );


      if (type === "success") {

        flashMessage.classList.add("success");

        flashTitle.textContent =
          title || "Success";

        flashText.textContent =
          message ||
          "Operation completed successfully.";

        flashIconBox.innerHTML = `
          <i data-lucide="check-circle-2"
             class="w-5 h-5">
          </i>
        `;

      } else {

        flashMessage.classList.add("error");

        flashTitle.textContent =
          title || "Error";

        flashText.textContent =
          message ||
          "Something went wrong.";

        flashIconBox.innerHTML = `
          <i data-lucide="alert-circle"
             class="w-5 h-5">
          </i>
        `;

      }


      lucide.createIcons();


      requestAnimationFrame(() => {

        flashMessage.classList.add("show");

      });


      flashTimer = setTimeout(() => {

        flashMessage.classList.remove("show");

      }, 2000);

    }


    // =====================================================
    // STATUS FLASH MESSAGE
    // =====================================================

    function getStatusFlash(status) {

      switch (status) {

        case "confirmed":

          return {
            title: "Booking Confirmed",
            message:
              "Booking has been confirmed successfully."
          };


        case "completed":

          return {
            title: "Booking Completed",
            message:
              "Booking has been marked as completed."
          };


        case "cancelled":

          return {
            title: "Booking Cancelled",
            message:
              "Booking has been cancelled successfully."
          };


        case "pending":

          return {
            title: "Booking Pending",
            message:
              "Booking has been moved to pending."
          };


        default:

          return {
            title: "Booking Updated",
            message:
              "Booking status updated successfully."
          };

      }

    }


    let allBookings = [];

    let currentFilter = "all";

    let currentBookingId = null;

    let selectedStatus = "pending";


    // =====================================================
    // STATUS CONFIG
    // =====================================================

    const statusConfig = {

      pending: {
        label: "Pending",
        bg: "bg-amber-50",
        text: "text-amber-600",
        border: "border-amber-500"
      },

      confirmed: {
        label: "Confirmed",
        bg: "bg-emerald-50",
        text: "text-emerald-600",
        border: "border-emerald-500"
      },

      completed: {
        label: "Completed",
        bg: "bg-sky-50",
        text: "text-sky-600",
        border: "border-sky-500"
      },

      cancelled: {
        label: "Cancelled",
        bg: "bg-rose-50",
        text: "text-rose-500",
        border: "border-rose-500"
      }

    };


    // =====================================================
    // SAFE HTML
    // =====================================================

    function escapeHtml(value) {

      if (
        value === null ||
        value === undefined
      ) {

        return "";

      }

      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }


    // =====================================================
    // DATE FORMAT
    // =====================================================

    function formatDate(dateValue) {

      if (!dateValue) {

        return "N/A";

      }

      const date =
        new Date(dateValue);

      if (isNaN(date.getTime())) {

        return "N/A";

      }

      return date.toLocaleDateString(
        "en-US",
        {
          month: "short",
          day: "numeric",
          year: "numeric"
        }
      );

    }


    // =====================================================
    // MONEY FORMAT
    // =====================================================

    function formatMoney(amount) {

      const number =
        Number(amount);

      if (isNaN(number)) {

        return "0";

      }

      return number.toLocaleString(
        "en-US",
        {
          maximumFractionDigits: 2
        }
      );

    }


    // =====================================================
    // GET CAR IMAGE
    // =====================================================

    function getCarImage(booking) {

      if (
        booking.car &&
        booking.car.image
      ) {

        return booking.car.image;

      }

      return "/images/title.png.jpeg";

    }


    // =====================================================
    // GET CAR NAME
    // =====================================================

    function getCarName(booking) {

      if (
        booking.car &&
        booking.car.name
      ) {

        return booking.car.name;

      }

      return "Rental Vehicle";

    }


    // =====================================================
    // FETCH ALL BOOKINGS
    // =====================================================

    async function loadBookings() {

      loadingState.classList.remove("hidden");

      errorState.classList.add("hidden");

      emptyState.classList.add("hidden");

      bookingsContainer.classList.add("hidden");

      refreshIcon.classList.add("animate-spin");


      try {

        const response =
          await fetch(
            "/api/bookings/owner-bookings",
            {
              method: "GET",

              headers: {
                "Accept":
                  "application/json"
              }
            }
          );


        const contentType =
          response.headers.get(
            "content-type"
          ) || "";


        if (
          !contentType.includes(
            "application/json"
          )
        ) {

          throw new Error(
            "Server returned HTML instead of JSON. Check login/session and API route."
          );

        }


        const result =
          await response.json();


        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.message ||
            "Failed to fetch bookings."
          );

        }


        allBookings =
          Array.isArray(result.bookings)
            ? result.bookings
            : [];


        // Update pending count

        const pendingCount =
          allBookings.filter(
            booking =>
              String(
                booking.status
              ).toLowerCase() ===
              "pending"
          ).length;


        pendingSidebarCount.textContent =
          pendingCount;


        renderBookings();


      } catch (error) {

        console.error(
          "Bookings Fetch Error:",
          error
        );


        loadingState.classList.add(
          "hidden"
        );

        errorState.classList.remove(
          "hidden"
        );

        errorMessage.textContent =
          error.message ||
          "Unable to load bookings.";

        lucide.createIcons();


      } finally {

        loadingState.classList.add(
          "hidden"
        );

        refreshIcon.classList.remove(
          "animate-spin"
        );

      }

    }


    // =====================================================
    // RENDER BOOKINGS
    // =====================================================

    function renderBookings() {

      bookingsContainer.innerHTML = "";


      const filteredBookings =
        currentFilter === "all"
          ? allBookings
          : allBookings.filter(
              booking =>
                String(
                  booking.status
                ).toLowerCase() ===
                currentFilter
            );


      bookingCountText.textContent =
        `${filteredBookings.length} booking${
          filteredBookings.length === 1
            ? ""
            : "s"
        } found`;


      if (
        filteredBookings.length === 0
      ) {

        bookingsContainer.classList.add(
          "hidden"
        );

        emptyState.classList.remove(
          "hidden"
        );

        return;

      }


      emptyState.classList.add(
        "hidden"
      );

      bookingsContainer.classList.remove(
        "hidden"
      );


      filteredBookings.forEach(
        booking => {

          bookingsContainer.appendChild(
            createBookingCard(booking)
          );

        }
      );


      lucide.createIcons();

    }


    // =====================================================
    // CREATE BOOKING CARD
    // =====================================================

    function createBookingCard(booking) {

      const card =
        document.createElement("div");


      card.className =
        "booking-card bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-slate-200";


      card.dataset.status =
        String(
          booking.status || ""
        ).toLowerCase();


      const status =
        String(
          booking.status ||
          "pending"
        ).toLowerCase();


      const config =
        statusConfig[status] ||
        statusConfig.pending;


      const carImage =
        getCarImage(booking);


      const carName =
        getCarName(booking);


      const customerName =
        booking.name ||
        (
          booking.renter &&
          booking.renter.name
        ) ||
        "Customer";


      const customerEmail =
        booking.email ||
        (
          booking.renter &&
          booking.renter.email
        ) ||
        "No email";


      const phone =
        booking.phone ||
        "No phone";


      const pickupLocation =
        booking.pickupLocation ||
        "N/A";


      const totalAmount =
        booking.totalAmount ??
        0;


      /* =====================================================
         PAYMENT STATUS
         ===================================================== */

      const paymentStatus =
        booking.payment &&
        booking.payment.status
          ? String(
              booking.payment.status
            ).toLowerCase()
          : "pending";


      const isPaid =
        paymentStatus === "paid";


      const totalDays =
        booking.totalDays ??
        1;


      const pricePerDay =
        booking.pricePerDay ??
        0;


      const startDate =
        formatDate(
          booking.startDate
        );


      const endDate =
        formatDate(
          booking.endDate
        );


      const bookingId =
        booking._id || "";


      card.innerHTML = `

        <!-- LEFT -->

        <div class="flex items-center gap-5 min-w-0">

          <!-- CAR IMAGE -->

          <div
            class="w-28 h-20 bg-slate-50 rounded-xl flex items-center justify-center p-2 shrink-0 border border-slate-100">

            <img
              src="${escapeHtml(carImage)}"
              alt="${escapeHtml(carName)}"
              class="max-h-full max-w-full object-contain"
              onerror="this.onerror=null;this.src='/images/title.png.jpeg';">

          </div>


          <!-- DETAILS -->

          <div class="space-y-1.5 min-w-0">

            <h3
              class="font-bold text-[#0B1536] text-base leading-tight truncate">

              ${escapeHtml(carName)}

            </h3>


            <!-- CUSTOMER -->

            <div
              class="flex flex-wrap items-center gap-1.5 text-xs text-slate-400">

              <i data-lucide="user"
                class="w-3.5 h-3.5 shrink-0"></i>

              <span>

                ${escapeHtml(customerName)}

                <span class="text-slate-500">

                  (${escapeHtml(customerEmail)})

                </span>

              </span>

            </div>


            <!-- PHONE -->

            <div
              class="flex items-center gap-1.5 text-xs text-slate-400">

              <i data-lucide="phone"
                class="w-3.5 h-3.5"></i>

              <span>

                ${escapeHtml(phone)}

              </span>

            </div>


            <!-- DATE + LOCATION -->

            <div
              class="flex flex-wrap items-center gap-3 text-xs text-slate-400 pt-0.5">

              <span class="flex items-center gap-1">

                <i data-lucide="calendar"
                  class="w-3.5 h-3.5"></i>

                ${startDate}

                <span>→</span>

                ${endDate}

              </span>


              <span class="flex items-center gap-1">

                <i data-lucide="map-pin"
                  class="w-3.5 h-3.5"></i>

                ${escapeHtml(pickupLocation)}

              </span>

            </div>


            <!-- PRICE INFO -->

            <div
              class="flex flex-wrap items-center gap-3 text-[11px] text-slate-400">

              <span>

                ${escapeHtml(totalDays)}

                day${
                  Number(totalDays) === 1
                    ? ""
                    : "s"
                }

              </span>

              <span>

                ₹${formatMoney(pricePerDay)}/day

              </span>

              <span
                class="font-semibold text-slate-500">

                Booking ID:

                ${escapeHtml(
                  String(
                    bookingId
                  ).slice(-8)
                )}

              </span>

            </div>

          </div>

        </div>


        <!-- RIGHT -->

        <div
          class="flex md:flex-col items-end justify-between w-full md:w-auto gap-2 self-stretch md:self-auto">

          <div class="text-right">

            <div
              class="text-base font-bold text-[#FF462D]">

              ₹${formatMoney(totalAmount)}

            </div>


            <!-- BOOKING STATUS -->

            <span
              class="inline-block ${config.bg} ${config.text} text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">

              ${config.label}

            </span>


            <!-- PAYMENT STATUS -->

            <div class="mt-2">

              ${
                isPaid
                  ? `
                    <span
                      class="inline-flex items-center gap-1.5
                             bg-emerald-50 text-emerald-600
                             border border-emerald-100
                             text-[10px] font-extrabold
                             px-2.5 py-1 rounded-lg uppercase">

                      <i
                        data-lucide="badge-check"
                        class="w-3.5 h-3.5">
                      </i>

                      Paid

                    </span>
                  `
                  : `
                    <span
                      class="inline-flex items-center gap-1.5
                             bg-amber-50 text-amber-600
                             border border-amber-100
                             text-[10px] font-extrabold
                             px-2.5 py-1 rounded-lg uppercase">

                      <i
                        data-lucide="clock-3"
                        class="w-3.5 h-3.5">
                      </i>

                      Payment Pending

                    </span>
                  `
              }

            </div>

          </div>


          <button
            type="button"
            class="open-modal-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors"
            data-booking-id="${escapeHtml(bookingId)}">

            <i data-lucide="edit-3"
              class="w-3.5 h-3.5"></i>

            Update

          </button>

        </div>

      `;


      return card;

    }


    // =====================================================
    // FILTER BUTTONS
    // =====================================================

    document
      .querySelectorAll(".filter-btn")
      .forEach(btn => {

        btn.addEventListener(
          "click",
          () => {

            currentFilter =
              btn.dataset.filter;


            document
              .querySelectorAll(
                ".filter-btn"
              )
              .forEach(button => {

                button.className =
                  "filter-btn px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-500 text-xs font-semibold hover:bg-slate-50";

              });


            btn.className =
              "filter-btn active-filter px-4 py-2 rounded-xl bg-[#0B1536] text-white text-xs font-semibold";


            renderBookings();

          }
        );

      });


    // =====================================================
    // OPEN MODAL
    // =====================================================

    bookingsContainer.addEventListener(
      "click",
      event => {

        const button =
          event.target.closest(
            ".open-modal-btn"
          );


        if (!button) {

          return;

        }


        const bookingId =
          button.dataset.bookingId;


        const booking =
          allBookings.find(
            item =>
              String(item._id) ===
              String(bookingId)
          );


        if (!booking) {

          showFlash(
            "error",
            "Booking Error",
            "Booking not found."
          );

          return;

        }


        openUpdateModal(booking);

      }
    );


    // =====================================================
    // OPEN UPDATE MODAL
    // =====================================================

    function openUpdateModal(booking) {

      currentBookingId =
        booking._id;


      selectedStatus =
        String(
          booking.status ||
          "pending"
        ).toLowerCase();


      modalBookingId.textContent =
        `Booking #${String(
          booking._id
        ).slice(-8)}`;


      modalCarName.textContent =
        getCarName(booking);


      modalCustomerName.textContent =
        `${booking.name || "Customer"} • ${
          booking.email || "No email"
        }`;


      modalCarImage.src =
        getCarImage(booking);


      modalCarImage.onerror =
        function () {

          this.onerror = null;

          this.src =
            "/images/title.png.jpeg";

        };


      modalNoteInput.value = "";


      updateStatusButtons();


      modal.classList.remove(
        "hidden"
      );

    }


    // =====================================================
    // CLOSE MODAL
    // =====================================================

    function closeModal() {

      modal.classList.add(
        "hidden"
      );

      currentBookingId = null;

    }


    closeModalBtn.addEventListener(
      "click",
      closeModal
    );


    modal.addEventListener(
      "click",
      event => {

        if (
          event.target === modal
        ) {

          closeModal();

        }

      }
    );


    document.addEventListener(
      "keydown",
      event => {

        if (
          event.key === "Escape" &&
          !modal.classList.contains(
            "hidden"
          )
        ) {

          closeModal();

        }

      }
    );


    // =====================================================
    // STATUS BUTTONS
    // =====================================================

    document
      .querySelectorAll(
        ".status-btn"
      )
      .forEach(btn => {

        btn.addEventListener(
          "click",
          () => {

            selectedStatus =
              btn.dataset.status;


            updateStatusButtons();

          }
        );

      });


    function updateStatusButtons() {

      document
        .querySelectorAll(
          ".status-btn"
        )
        .forEach(btn => {

          const status =
            btn.dataset.status;


          const config =
            statusConfig[status];


          if (
            status ===
            selectedStatus
          ) {

            btn.className =
              `status-btn border-2 ${config.border} ${config.bg} ${config.text} rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all shadow-sm`;

          } else {

            btn.className =
              "status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all hover:shadow-md";

          }

        });

    }


    // =====================================================
    // UPDATE STATUS
    // =====================================================

    statusForm.addEventListener(
      "submit",
      async event => {

        event.preventDefault();


        if (!currentBookingId) {

          showFlash(
            "error",
            "Booking Error",
            "Booking ID is missing."
          );

          return;

        }


        if (!selectedStatus) {

          showFlash(
            "error",
            "Status Required",
            "Please select a booking status."
          );

          return;

        }


        submitBtn.disabled = true;

        submitBtn.textContent =
          "Updating...";


        try {

          /*
           * IMPORTANT:
           *
           * Your booking router is mounted as:
           *
           * app.use("/api/bookings", bookingRoutes);
           *
           * Therefore the correct endpoint is:
           *
           * POST /api/bookings/update-status
           */


          const response =
            await fetch(
              "/api/bookings/update-status",
              {
                method: "POST",

                headers: {
                  "Content-Type":
                    "application/json",

                  "Accept":
                    "application/json"
                },

                body: JSON.stringify({

                  bookingId:
                    currentBookingId,

                  status:
                    selectedStatus,

                  note:
                    modalNoteInput.value.trim()

                })

              }
            );


          const contentType =
            response.headers.get(
              "content-type"
            ) || "";


          if (
            !contentType.includes(
              "application/json"
            )
          ) {

            throw new Error(
              "Server returned HTML instead of JSON. Check the API route."
            );

          }


          const result =
            await response.json();


          if (
            !response.ok ||
            !result.success
          ) {

            throw new Error(
              result.message ||
              "Status update failed."
            );

          }


          // =================================================
          // SUCCESS FLASH
          // =================================================

          const flash =
            getStatusFlash(
              selectedStatus
            );


          showFlash(
            "success",
            flash.title,
            result.message ||
            flash.message
          );


          closeModal();


          // Reload fresh data

          await loadBookings();


        } catch (error) {

          console.error(
            "Status Update Error:",
            error
          );


          // =================================================
          // ERROR FLASH
          // =================================================

          showFlash(
            "error",
            "Update Failed",
            error.message ||
            "Server communication error."
          );


        } finally {

          submitBtn.disabled =
            false;

          submitBtn.textContent =
            "Update Status";

        }

      }
    );


    // =====================================================
    // REFRESH
    // =====================================================

    refreshBtn.addEventListener(
      "click",
      loadBookings
    );


    retryBtn.addEventListener(
      "click",
      loadBookings
    );


    // =====================================================
    // INITIAL LOAD
    // =====================================================

    loadBookings();

  </script>

</body>
</html>