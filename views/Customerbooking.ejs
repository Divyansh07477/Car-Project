    // =====================================================
    // CLOSE MODAL
    // =====================================================

    function closeModal() {

        updateModal.classList.add(
            "hidden"
        );

        updateModal.classList.remove(
            "flex"
        );


        currentBookingId =
            null;

        selectedStatus =
            null;

        modalNote.value =
            "";
    }


    // =====================================================
    // STATUS BUTTON CLICK
    // =====================================================

    document
        .querySelectorAll(
            ".status-btn"
        )
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    () => {

                        if (
                            button.disabled
                        ) {
                            return;
                        }


                        document
                            .querySelectorAll(
                                ".status-btn"
                            )
                            .forEach(
                                item =>
                                    item.classList.remove(
                                        "selected"
                                    )
                            );


                        button.classList.add(
                            "selected"
                        );


                        selectedStatus =
                            button.dataset.status;
                    }
                );
            }
        );


    // =====================================================
    // STATUS UPDATE
    // =====================================================

    statusUpdateForm.addEventListener(
        "submit",
        async event => {

            event.preventDefault();


            if (!currentBookingId) {

                return showFlash(
                    "error",
                    "Error",
                    "Booking ID is missing."
                );
            }


            if (!selectedStatus) {

                return showFlash(
                    "error",
                    "Action Required",
                    "Please choose a status."
                );
            }


            submitStatusBtn.disabled =
                true;

            submitStatusBtn.textContent =
                "Updating...";


            try {

                const response =
                    await fetch(
                        "/api/bookings/update-status",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json",

                                "Accept":
                                    "application/json"
                            },

                            credentials:
                                "include",

                            body:
                                JSON.stringify(
                                    {
                                        bookingId:
                                            currentBookingId,

                                        status:
                                            selectedStatus,

                                        note:
                                            modalNote.value.trim()
                                    }
                                )
                        }
                    );


                const result =
                    await response.json();


                if (
                    !response.ok ||
                    !result.success
                ) {

                    throw new Error(
                        result.message ||
                        "Status update failed."
                    );
                }


                showFlash(
                    "success",
                    "Updated",
                    result.message ||
                    "Status updated successfully."
                );


                closeModal();


                await loadBookings(
                    true
                );


            } catch (error) {

                console.error(
                    "Status Update Error:",
                    error
                );


                showFlash(
                    "error",
                    "Failed",
                    error.message ||
                    "Failed to update booking status."
                );


            } finally {

                submitStatusBtn.disabled =
                    false;

                submitStatusBtn.textContent =
                    "Update Status";
            }
        }
    );


    // =====================================================
    // FILTER BUTTONS
    // =====================================================

    document
        .querySelectorAll(
            ".filter-btn"
        )
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    () => {

                        currentFilter =
                            button.dataset.filter;


                        document
                            .querySelectorAll(
                                ".filter-btn"
                            )
                            .forEach(
                                item =>
                                    item.classList.remove(
                                        "active"
                                    )
                            );


                        button.classList.add(
                            "active"
                        );


                        renderBookings();
                    }
                );
            }
        );


    // =====================================================
    // REFRESH BUTTON
    // =====================================================

    refreshBtn.addEventListener(
        "click",
        async () => {

            refreshBtn.disabled =
                true;


            refreshIcon.classList.add(
                "spin"
            );


            try {

                await loadBookings(
                    false
                );

            } finally {

                setTimeout(
                    () => {

                        refreshBtn.disabled =
                            false;

                        refreshIcon.classList.remove(
                            "spin"
                        );

                    },
                    500
                );
            }
        }
    );


    // =====================================================
    // RETRY
    // =====================================================

    retryBtn.addEventListener(
        "click",
        () =>
            loadBookings(false)
    );


    // =====================================================
    // MODAL CLOSE BUTTONS
    // =====================================================

    closeModalBtn.addEventListener(
        "click",
        closeModal
    );


    cancelModalBtn.addEventListener(
        "click",
        closeModal
    );


    // =====================================================
    // CLICK OUTSIDE MODAL
    // =====================================================

    updateModal.addEventListener(
        "click",
        event => {

            if (
                event.target ===
                updateModal
            ) {

                closeModal();
            }
        }
    );


    // =====================================================
    // ESCAPE KEY
    // =====================================================

    document.addEventListener(
        "keydown",
        event => {

            if (
                event.key === "Escape" &&
                !updateModal.classList.contains(
                    "hidden"
                )
            ) {

                closeModal();
            }
        }
    );


    // =====================================================
    // INITIAL LOAD
    // =====================================================

    loadBookings(false);


    // =====================================================
    // AUTO REAL-TIME POLLING
    // Every 5 seconds
    // =====================================================

    setInterval(
        () => {

            loadBookings(true);

        },
        5000
    );

</script>








</body>
</html>