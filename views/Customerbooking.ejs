            </a>

          </nav>

        </div>


        <!-- OTHER -->

        <div>

          <p
            class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">

            Other

          </p>


          <nav class="space-y-1.5">

            <a href="/"
              class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">

              <i data-lucide="arrow-left" class="w-5 h-5"></i>

              <span>Back to Site</span>

            </a>

          </nav>

        </div>

      </div>

    </div>


    <div
