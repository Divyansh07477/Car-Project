<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RideWave Admin - Customer Bookings</title>
  <link rel="icon" type="image/png" href="/images/title.png.jpeg">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
 <link
        rel="stylesheet"
        href="/css/style.css"
    >
  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      min-height: 100%;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .sidebar-link {
      transition: all 0.2s ease;
    }

    .sidebar-link:hover {
      transform: translateX(2px);
    }

    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      width: 256px;
      overflow-y: auto;
      overflow-x: hidden;
      z-index: 50;
    }

    .main-content {
      margin-left: 256px;
      min-height: 100vh;
    }

    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }

    ::-webkit-scrollbar-track {
      background: #f8fafc;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 20px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    .sidebar::-webkit-scrollbar-track {
      background: #0B1536;
    }

    .sidebar::-webkit-scrollbar-thumb {
      background: #24345e;
    }

    @media (max-width: 900px) {
      .sidebar {
        width: 220px;
      }
      .main-content {
        margin-left: 220px;
      }
    }

    @media (max-width: 700px) {
      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
      }
      .main-content {
        margin-left: 0;
      }
    }

    .booking-card {
      transition: all 0.2s ease;
    }

    .booking-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    }

    .filter-btn {
      transition: all 0.2s ease;
    }

    .filter-btn.active {
      background: #FF462D;
      color: white;
      border-color: #FF462D;
    }

    .modal-overlay {
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(4px);
    }

    .status-btn {
      transition: all 0.2s ease;
    }

    .status-btn.selected {
      border-color: #FF462D;
      background: #fff1ed;
      color: #FF462D;
    }

    .status-btn:hover {
      transform: translateY(-1px);
    }

    .flash-message {
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-15px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .spin {
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }
  </style>
</head>

<body class="bg-[#F8FAFC] text-slate-800">

  <!-- ================= FIXED SIDEBAR ================= -->
  <aside class="sidebar bg-[#0B1536] text-white flex flex-col justify-between p-6">
    <div>
      <!-- LOGO -->
      <div class="flex items-center gap-2 mb-10">
        <span class="text-2xl font-bold tracking-tight text-white">
          Ride<span class="text-[#FF462D]">Wave</span>
        </span>
        <span class="bg-[#FF462D]/15 text-[#FF462D] text-[10px] font-bold px-2 py-0.5 rounded tracking-wider uppercase">
          ADMIN
        </span>
      </div>

      <!-- NAVIGATION -->
      <div class="space-y-6">
        <div>
          <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">
            Main
          </p>

          <nav class="space-y-1.5">
            <!-- DASHBOARD -->
            <a href="/admin" class="sidebar-link flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium">
              <i data-lucide="layout-grid" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>

            <!-- RENTAL CARS -->
            <a href="/carAdmin" class="sidebar-link flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium">
              <i data-lucide="car" class="w-5 h-5"></i>
              <span>Rental Cars</span>
            </a>

            <!-- BOOKINGS (ACTIVE) -->
            <a href="/Customerbooking" class="sidebar-link flex items-center justify-between px-4 py-3 bg-[#FF462D] text-white rounded-xl font-medium shadow-md shadow-[#FF462D]/20">
              <div class="flex items-center gap-3.5">
                <i data-lucide="calendar" class="w-5 h-5"></i>
                <span>Bookings</span>
              </div>
              <span id="pendingSidebarCount" class="bg-[#FF9F1C] text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">
                0
              </span>
            </a>
          </nav>
        </div>

        <!-- OTHER -->
        <div>
          <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">
            Other
          </p>

          <nav class="space-y-1.5">
            <a href="/" class="sidebar-link flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium">
              <i data-lucide="arrow-left" class="w-5 h-5"></i>
              <span>Back to Site</span>
            </a>
          </nav>
        </div>
      </div>
    </div>

    <!-- SIDEBAR FOOTER -->
    <div class="pt-6 border-t border-slate-800 flex items-center gap-2 text-xs text-slate-500">
      <i data-lucide="shield" class="w-4 h-4 text-[#FF462D]"></i>
      <span>Admin Panel</span>
    </div>
  </aside>

  <!-- ================= MAIN CONTENT ================= -->
  <main class="main-content min-h-screen">
    <!-- TOP HEADER -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
      <div class="px-6 lg:px-8 py-4 lg:py-5 flex items-center justify-between">
        <div>
          <h1 class="text-xl lg:text-2xl font-extrabold text-slate-900">Customer Bookings</h1>
          <p class="text-xs lg:text-sm text-slate-500 mt-0.5">Manage incoming and confirmed rental bookings</p>
        </div>

        <button id="refreshBtn" type="button" class="flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 text-xs lg:text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
          <i data-lucide="refresh-cw" id="refreshIcon" class="w-4 h-4"></i>
          <span>Refresh</span>
        </button>
      </div>
    </header>

    <!-- CONTENT -->
    <section class="px-6 lg:px-8 py-6">
      <div id="flashMessage" class="hidden mb-6"></div>

      <!-- FILTERS -->
      <div class="bg-white border border-slate-200 rounded-2xl p-3.5 mb-6">
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" class="filter-btn active px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs lg:text-sm font-semibold" data-filter="all">All</button>
          <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs lg:text-sm font-semibold text-slate-600" data-filter="pending">Pending</button>
          <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs lg:text-sm font-semibold text-slate-600" data-filter="confirmed">Confirmed</button>
          <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs lg:text-sm font-semibold text-slate-600" data-filter="completed">Completed</button>
          <button type="button" class="filter-btn px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs lg:text-sm font-semibold text-slate-600" data-filter="cancelled">Cancelled</button>

          <div class="ml-auto">
            <span id="bookingCount" class="text-xs lg:text-sm text-slate-500 font-semibold">0 bookings</span>
          </div>
        </div>
      </div>

      <!-- STATES -->
      <div id="loadingState" class="bg-white border border-slate-200 rounded-2xl p-10 text-center">
        <div class="flex justify-center mb-3">
          <i data-lucide="loader-2" class="w-8 h-8 text-[#FF462D] spin"></i>
        </div>
        <p class="text-sm text-slate-600 font-semibold">Loading bookings...</p>
      </div>

      <div id="errorState" class="hidden bg-white border border-red-200 rounded-2xl p-10 text-center">
        <div class="w-12 h-12 mx-auto rounded-full bg-red-100 flex items-center justify-center mb-3">
          <i data-lucide="alert-circle" class="w-6 h-6 text-red-600"></i>
        </div>
        <h3 class="text-base font-bold text-slate-900">Failed to load bookings</h3>
        <p id="errorText" class="text-xs text-slate-500 mt-1">Something went wrong.</p>
        <button id="retryBtn" type="button" class="mt-4 px-4 py-2 bg-[#FF462D] text-white rounded-xl font-semibold text-xs">Try Again</button>
      </div>

      <div id="emptyState" class="hidden bg-white border border-slate-200 rounded-2xl p-10 text-center">
        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 flex items-center justify-center mb-3">
          <i data-lucide="calendar-x" class="w-6 h-6 text-slate-400"></i>
        </div>
        <h3 class="text-base font-bold text-slate-900">No bookings found</h3>
        <p class="text-xs text-slate-500 mt-1">There are no bookings matching this filter.</p>
      </div>

      <div id="bookingsContainer" class="hidden space-y-4"></div>
    </section>
  </main>

  <!-- ================= UPDATE STATUS MODAL ================= -->
  <div id="updateModal" class="hidden fixed inset-0 modal-overlay z-50 items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h2 class="text-base font-extrabold text-slate-900">Update Booking Status</h2>
          <p class="text-xs text-slate-500">Change status of this booking</p>
        </div>
        <button id="closeModalBtn" type="button" class="w-8 h-8 rounded-full hover:bg-slate-100 flex items-center justify-center">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <form id="statusUpdateForm" class="p-5">
        <div id="modalBookingInfo" class="bg-slate-50 rounded-xl p-3.5 mb-4"></div>
        <div id="modalPaymentInfo" class="mb-4"></div>

        <div class="mb-4">
          <label class="block text-xs font-bold text-slate-800 uppercase tracking-wide mb-2.5">Select Action</label>
          <div class="grid grid-cols-2 gap-2.5">
            <!-- CONFIRM BUTTON (GREEN) -->
            <button type="button" data-status="confirmed" class="status-btn border border-slate-200 rounded-xl p-3 text-left">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center shrink-0">
                  <i data-lucide="check-circle" class="w-4 h-4 text-green-600"></i>
                </div>
                <div>
                  <p class="font-bold text-xs text-slate-800">Confirm</p>
                  <p class="text-[10px] text-slate-500">Approve ride</p>
                </div>
              </div>
            </button>

            <!-- COMPLETE BUTTON (BLUE) -->
            <button type="button" data-status="completed" class="status-btn border border-slate-200 rounded-xl p-3 text-left">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center shrink-0">
                  <i data-lucide="badge-check" class="w-4 h-4 text-blue-600"></i>
                </div>
                <div>
                  <p class="font-bold text-xs text-slate-800">Completed</p>
                  <p class="text-[10px] text-slate-500">Finish trip</p>
                </div>
              </div>
            </button>

            <!-- CANCEL BUTTON (RED) -->
            <button type="button" data-status="cancelled" class="status-btn border border-slate-200 rounded-xl p-3 text-left col-span-2">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-red-100 flex items-center justify-center shrink-0">
                  <i data-lucide="x-circle" class="w-4 h-4 text-red-600"></i>
                </div>
                <div>
                  <p class="font-bold text-xs text-slate-800">Cancel Booking</p>
                  <p class="text-[10px] text-slate-500">Reject / Cancel ride request</p>
                </div>
              </div>
            </button>
          </div>
        </div>

        <div class="mb-5">
          <label for="modalNote" class="block text-xs font-bold text-slate-800 mb-1.5">
            Note <span class="text-slate-400 font-normal">(optional)</span>
          </label>
          <textarea id="modalNote" rows="2" placeholder="Add remarks or notes..." class="w-full border border-slate-200 rounded-xl px-3 py-2 text-xs outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] resize-none"></textarea>
        </div>

        <div class="flex items-center justify-end gap-2.5">
          <button id="cancelModalBtn" type="button" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50">Cancel</button>
          <button id="submitStatusBtn" type="submit" class="px-4 py-2 rounded-xl bg-[#FF462D] text-white text-xs font-bold hover:bg-[#e03e27] disabled:opacity-50 disabled:cursor-not-allowed">Update Status</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= JS ================= -->
 <script>
    let allBookings = [];
    let currentFilter = "all";
    let currentBookingId = null;
    let selectedStatus = null;
    let isFetching = false;


    // =====================================================
    // DOM ELEMENTS
    // =====================================================

    const bookingsContainer =
        document.getElementById("bookingsContainer");

    const loadingState =
        document.getElementById("loadingState");

    const errorState =
        document.getElementById("errorState");

    const emptyState =
        document.getElementById("emptyState");

    const errorText =
        document.getElementById("errorText");

    const bookingCount =
        document.getElementById("bookingCount");

    const refreshBtn =
        document.getElementById("refreshBtn");

    const refreshIcon =
        document.getElementById("refreshIcon");

    const retryBtn =
        document.getElementById("retryBtn");

    const flashMessage =
        document.getElementById("flashMessage");

    const updateModal =
        document.getElementById("updateModal");

    const closeModalBtn =
        document.getElementById("closeModalBtn");

    const cancelModalBtn =
        document.getElementById("cancelModalBtn");

    const statusUpdateForm =
        document.getElementById("statusUpdateForm");

    const submitStatusBtn =
        document.getElementById("submitStatusBtn");

    const modalNote =
        document.getElementById("modalNote");

    const modalBookingInfo =
        document.getElementById("modalBookingInfo");

    const modalPaymentInfo =
        document.getElementById("modalPaymentInfo");

    const pendingSidebarCount =
        document.getElementById("pendingSidebarCount");


    // =====================================================
    // LUCIDE ICONS
    // =====================================================

    if (window.lucide) {
        lucide.createIcons();
    }


    // =====================================================
    // PAYMENT STATUS
    // =====================================================

    function getPaymentStatus(booking) {

        if (
            !booking ||
            !booking.payment ||
            !booking.payment.status
        ) {
            return "pending";
        }

        return String(
            booking.payment.status
        )
            .trim()
            .toLowerCase();
    }


    // =====================================================
    // BOOKING STATUS
    // =====================================================

    function getBookingStatus(booking) {

        if (!booking || !booking.status) {
            return "pending";
        }

        return String(
            booking.status
        )
            .trim()
            .toLowerCase();
    }


    // =====================================================
    // DATE FORMAT
    // =====================================================

    function formatDate(dateValue) {

        if (!dateValue) {
            return "N/A";
        }

        const date = new Date(dateValue);

        if (isNaN(date.getTime())) {
            return "N/A";
        }

        return date.toLocaleDateString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric"
            }
        );
    }


    // =====================================================
    // DATE + TIME FORMAT
    // =====================================================

    function formatDateTime(dateValue) {

        if (!dateValue) {
            return "N/A";
        }

        const date = new Date(dateValue);

        if (isNaN(date.getTime())) {
            return "N/A";
        }

        return date.toLocaleString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            }
        );
    }


    // =====================================================
    // CURRENCY FORMAT
    // =====================================================

    function formatCurrency(amount) {

        const value = Number(amount) || 0;

        return value.toLocaleString(
            "en-IN",
            {
                style: "currency",
                currency: "INR",
                maximumFractionDigits: 0
            }
        );
    }


    // =====================================================
    // ESCAPE HTML
    // =====================================================

    function escapeHTML(value) {

        if (
            value === null ||
            value === undefined
        ) {
            return "";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    // =====================================================
    // CAR NAME
    // =====================================================

    function getCarName(booking) {

        if (
            booking &&
            booking.car &&
            typeof booking.car === "object" &&
            booking.car.name
        ) {
            return booking.car.name;
        }

        return "Rental Car";
    }


    // =====================================================
    // RENTER NAME
    // =====================================================

    function getRenterName(booking) {

        if (
            booking &&
            booking.renter &&
            typeof booking.renter === "object" &&
            booking.renter.name
        ) {
            return booking.renter.name;
        }

        if (
            booking &&
            booking.name
        ) {
            return booking.name;
        }

        return "Customer";
    }


    // =====================================================
    // RENTER EMAIL
    // =====================================================

    function getRenterEmail(booking) {

        if (
            booking &&
            booking.renter &&
            typeof booking.renter === "object" &&
            booking.renter.email
        ) {
            return booking.renter.email;
        }

        if (
            booking &&
            booking.email
        ) {
            return booking.email;
        }

        return "N/A";
    }


    // =====================================================
    // BOOKING STATUS BADGE
    // =====================================================

    function getStatusBadge(status) {

        switch (status) {

            case "confirmed":

                return `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                        Confirmed
                    </span>
                `;


            case "completed":

                return `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                        Completed
                    </span>
                `;


            case "cancelled":

                return `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                        Cancelled
                    </span>
                `;


            case "pending":

            default:

                return `
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-600"></span>
                        Pending
                    </span>
                `;
        }
    }


    // =====================================================
    // PAYMENT BADGE
    // =====================================================

    function getPaymentBadge(booking) {

        const bStatus =
            getBookingStatus(booking);

        const paymentStatus =
            getPaymentStatus(booking);


        // Pending booking
        // payment badge mat dikhao
        if (
            bStatus === "pending" ||
            (
                bStatus === "cancelled" &&
                paymentStatus !== "refunded"
            )
        ) {
            return "";
        }


        // Refunded
        if (paymentStatus === "refunded") {

            return `
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                    <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
                    Refunded
                </span>
            `;
        }


        // Paid
        if (paymentStatus === "paid") {

            return `
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                    <i data-lucide="check-circle-2" class="w-3 h-3"></i>
                    Paid
                </span>
            `;
        }


        // Failed
        if (paymentStatus === "failed") {

            return `
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-700">
                    <i data-lucide="circle-x" class="w-3 h-3"></i>
                    Failed
                </span>
            `;
        }


        // Payment pending
        return `
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700">
                <i data-lucide="clock-3" class="w-3 h-3"></i>
                Payment Pending
            </span>
        `;
    }


    // =====================================================
    // GET AMOUNT PAID
    // =====================================================

    function getAmountPaid(booking) {

        if (
            !booking ||
            !booking.payment
        ) {
            return 0;
        }

        return Number(
            booking.payment.amountPaid
        ) || 0;
    }


    // =====================================================
    // SHOW FLASH MESSAGE
    // =====================================================

    function showFlash(
        type,
        title,
        message
    ) {

        const isSuccess =
            type === "success";


        flashMessage.innerHTML = `

            <div class="flash-message rounded-xl border ${
                isSuccess
                    ? "border-green-200 bg-green-50"
                    : "border-red-200 bg-red-50"
            } p-3.5">

                <div class="flex items-start gap-2.5">

                    <div class="w-8 h-8 rounded-lg ${
                        isSuccess
                            ? "bg-green-100"
                            : "bg-red-100"
                    } flex items-center justify-center shrink-0">

                        <i
                            data-lucide="${
                                isSuccess
                                    ? "check-circle"
                                    : "alert-circle"
                            }"
                            class="w-4 h-4 ${
                                isSuccess
                                    ? "text-green-600"
                                    : "text-red-600"
                            }"
                        ></i>

                    </div>

                    <div>

                        <p class="font-bold text-xs ${
                            isSuccess
                                ? "text-green-800"
                                : "text-red-800"
                        }">

                            ${escapeHTML(title)}

                        </p>

                        <p class="text-[11px] ${
                            isSuccess
                                ? "text-green-700"
                                : "text-red-700"
                        } mt-0.5">

                            ${escapeHTML(message)}

                        </p>

                    </div>

                </div>

            </div>
        `;


        flashMessage.classList.remove("hidden");


        if (window.lucide) {
            lucide.createIcons();
        }


        setTimeout(() => {

            flashMessage.classList.add("hidden");

        }, 4000);
    }


    // =====================================================
    // LOAD BOOKINGS
    // =====================================================

    async function loadBookings(
        isSilent = false
    ) {

        if (isFetching) {
            return;
        }

        isFetching = true;


        if (!isSilent) {

            loadingState.classList.remove(
                "hidden"
            );

            errorState.classList.add(
                "hidden"
            );

            emptyState.classList.add(
                "hidden"
            );

            bookingsContainer.classList.add(
                "hidden"
            );
        }


        try {

            const response =
                await fetch(
                    "/api/bookings/owner-bookings",
                    {
                        method: "GET",

                        headers: {
                            "Accept":
                                "application/json"
                        },

                        credentials:
                            "include"
                    }
                );


            const contentType =
                response.headers.get(
                    "content-type"
                ) || "";


            if (
                !contentType.includes(
                    "application/json"
                )
            ) {

                throw new Error(
                    "Invalid session. Server did not return JSON."
                );
            }


            const result =
                await response.json();


            if (
                !response.ok ||
                !result.success
            ) {

                throw new Error(
                    result.message ||
                    "Failed to load bookings."
                );
            }


            allBookings =
                Array.isArray(
                    result.bookings
                )
                    ? result.bookings
                    : [];


            renderBookings();

        } catch (error) {

            console.error(
                "Load Bookings Error:",
                error
            );


            if (!isSilent) {

                loadingState.classList.add(
                    "hidden"
                );

                errorState.classList.remove(
                    "hidden"
                );

                errorText.textContent =
                    error.message ||
                    "Failed to load bookings.";
            }

        } finally {

            isFetching = false;
        }
    }


    // =====================================================
    // RENDER BOOKINGS
    // =====================================================

    function renderBookings() {

        loadingState.classList.add(
            "hidden"
        );

        errorState.classList.add(
            "hidden"
        );


        let filteredBookings =
            allBookings;


        if (
            currentFilter !== "all"
        ) {

            filteredBookings =
                allBookings.filter(
                    booking =>
                        getBookingStatus(
                            booking
                        ) === currentFilter
                );
        }


        bookingCount.textContent =
            `${filteredBookings.length} ${
                filteredBookings.length === 1
                    ? "booking"
                    : "bookings"
            }`;


        // Pending count
        if (pendingSidebarCount) {

            const pendingTotal =
                allBookings.filter(
                    booking =>
                        getBookingStatus(
                            booking
                        ) === "pending"
                ).length;


            pendingSidebarCount.textContent =
                pendingTotal;
        }


        // Empty
        if (
            filteredBookings.length === 0
        ) {

            bookingsContainer.classList.add(
                "hidden"
            );

            emptyState.classList.remove(
                "hidden"
            );

            return;
        }


        emptyState.classList.add(
            "hidden"
        );

        bookingsContainer.classList.remove(
            "hidden"
        );


        bookingsContainer.innerHTML =
            filteredBookings
                .map(
                    booking =>
                        createBookingCard(
                            booking
                        )
                )
                .join("");


        if (window.lucide) {
            lucide.createIcons();
        }
    }


