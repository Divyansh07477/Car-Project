    // =========================================================
    // OPEN STATUS MODAL
    // =========================================================

    function openStatusModal(
        bookingId
    ) {

        const booking =
            allBookings.find(
                item =>
                    String(item._id) ===
                    String(bookingId)
            );


        if (!booking) {

            showFlash(
                "error",
                "Booking Not Found",
                "Unable to find this booking."
            );

            return;
        }


        currentBookingId =
            bookingId;


        selectedStatus =
            null;


        // =============================================
        // BOOKING INFO
        // =============================================

        const bookingStatus =
            getBookingStatus(
                booking
            );


        const paymentStatus =
            getPaymentStatus(
                booking
            );


        modalBookingInfo.innerHTML = `

            <div
                class="flex items-center justify-between gap-4"
            >

                <div>

                    <p
                        class="text-xs text-slate-400 font-semibold"
                    >
                        Car
                    </p>

                    <p
                        class="text-sm font-extrabold text-slate-900 mt-1"
                    >
                        ${escapeHTML(
                            getCarName(
                                booking
                            )
                        )}
                    </p>

                </div>


                <div class="text-right">

                    <p
                        class="text-xs text-slate-400 font-semibold"
                    >
                        Current Status
                    </p>

                    <div class="mt-1">

                        ${getStatusBadge(
                            bookingStatus
                        )}

                    </div>

                </div>

            </div>

        `;



        // =============================================
        // PAYMENT INFO
        // =============================================

        let paymentMessage = "";

        let paymentClass =
            "bg-slate-50 border-slate-200 text-slate-700";


        if (
            paymentStatus === "paid"
        ) {

            paymentMessage =
                "Payment is currently Paid. If you cancel this booking, the backend will mark the payment as Refunded.";

            paymentClass =
                "bg-blue-50 border-blue-200 text-blue-700";

        } else if (
            paymentStatus === "refunded"
        ) {

            paymentMessage =
                "Payment has already been marked as Refunded.";

            paymentClass =
                "bg-green-50 border-green-200 text-green-700";

        } else if (
            paymentStatus === "failed"
        ) {

            paymentMessage =
                "Payment has Failed. Cancelling will not change it to Refunded.";

            paymentClass =
                "bg-red-50 border-red-200 text-red-700";

        } else {

            paymentMessage =
                "Payment is Pending. If you cancel this booking, payment will remain Pending.";

            paymentClass =
                "bg-yellow-50 border-yellow-200 text-yellow-700";
        }


        modalPaymentInfo.innerHTML = `

            <div
                class="border rounded-xl p-3 ${paymentClass}"
            >

                <div
                    class="flex items-start gap-3"
                >

                    <i
                        data-lucide="credit-card"
                        class="w-5 h-5 mt-0.5"
                    ></i>

                    <div>

                        <p
                            class="text-sm font-bold"
                        >
                            Payment:
                            ${
                                paymentStatus
                                    .charAt(0)
                                    .toUpperCase() +
                                paymentStatus.slice(1)
                            }
                        </p>

                        <p
                            class="text-xs mt-1"
                        >
                            ${escapeHTML(
                                paymentMessage
                            )}
                        </p>

                    </div>

                </div>

            </div>

        `;



        modalNote.value =
            booking.note || "";


        // =============================================
        // RESET STATUS BUTTONS
        // =============================================

        document
            .querySelectorAll(".status-btn")
            .forEach(button => {

                button.classList.remove(
                    "selected"
                );

            });


        // =============================================
        // DISABLE INVALID STATUS BUTTONS
        // =============================================

        const statusButtons =
            document.querySelectorAll(
                ".status-btn"
            );


        statusButtons.forEach(
            button => {

                const targetStatus =
                    button.dataset.status;


                button.disabled =
                    false;

                button.classList.remove(
                    "opacity-40",
                    "cursor-not-allowed"
                );


                let allowed =
                    false;


                if (
                    bookingStatus === "pending"
                ) {

                    allowed =
                        [
                            "confirmed",
                            "cancelled"
                        ].includes(
                            targetStatus
                        );

                } else if (
                    bookingStatus === "confirmed"
                ) {

                    allowed =
                        [
                            "completed",
                            "cancelled"
                        ].includes(
                            targetStatus
                        );

                } else {

                    allowed =
                        false;
                }


                if (!allowed) {

                    button.disabled =
                        true;

                    button.classList.add(
                        "opacity-40",
                        "cursor-not-allowed"
                    );
                }

            }
        );


        // =============================================
        // OPEN MODAL
        // =============================================

        updateModal.classList.remove(
            "hidden"
        );

        updateModal.classList.add(
            "flex"
        );


        if (window.lucide) {
            lucide.createIcons();
        }

    }



    // =========================================================
    // CLOSE STATUS MODAL
    // =========================================================

    function closeModal() {

        updateModal.classList.add(
            "hidden"
        );

        updateModal.classList.remove(
            "flex"
        );


        currentBookingId =
            null;

        selectedStatus =
            null;


        modalNote.value =
            "";


        document
            .querySelectorAll(".status-btn")
            .forEach(button => {

                button.classList.remove(
                    "selected"
                );

                button.disabled =
                    false;

                button.classList.remove(
                    "opacity-40",
                    "cursor-not-allowed"
                );

            });
    }



    // =========================================================
    // STATUS BUTTON CLICK
    // =========================================================

    document
        .querySelectorAll(".status-btn")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    if (
                        button.disabled
                    ) {
                        return;
                    }


                    document
                        .querySelectorAll(
                            ".status-btn"
                        )
                        .forEach(
                            item =>
                                item.classList.remove(
                                    "selected"
                                )
                        );


                    button.classList.add(
                        "selected"
                    );


                    selectedStatus =
                        button.dataset.status;

                }
            );

        });



    // =========================================================
    // STATUS FORM SUBMIT
    // =========================================================

    statusUpdateForm.addEventListener(
        "submit",
        async event => {

            event.preventDefault();


            // =============================================
            // VALIDATION
            // =============================================

            if (
                !currentBookingId
            ) {

                showFlash(
                    "error",
                    "Update Failed",
                    "Booking ID is missing."
                );

                return;
            }


            if (
                !selectedStatus
            ) {

                showFlash(
                    "error",
                    "Select Status",
                    "Please select a booking status."
                );

                return;
            }


            const currentBooking =
                allBookings.find(
                    item =>
                        String(item._id) ===
                        String(currentBookingId)
                );


            if (!currentBooking) {

                showFlash(
                    "error",
                    "Booking Not Found",
                    "Unable to find the selected booking."
                );

                return;
            }


            // =============================================
            // BUTTON STATE
            // =============================================

            submitStatusBtn.disabled =
                true;

            submitStatusBtn.textContent =
                "Updating...";


            try {

                // =========================================
                // API REQUEST
                // =========================================

                const response =
                    await fetch(
                        "/api/bookings/update-status",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json",

                                "Accept":
                                    "application/json"
                            },

                            credentials:
                                "include",

                            body:
                                JSON.stringify({

                                    bookingId:
                                        currentBookingId,

                                    status:
                                        selectedStatus,

                                    note:
                                        modalNote.value.trim()

                                })
                        }
                    );


                // =========================================
                // CHECK RESPONSE TYPE
                // =========================================

                const contentType =
                    response.headers.get(
                        "content-type"
                    ) || "";


                if (
                    !contentType.includes(
                        "application/json"
                    )
                ) {

                    throw new Error(
                        "Server returned HTML instead of JSON. Check the API route."
                    );
                }


                // =========================================
                // PARSE JSON
                // =========================================

                const result =
                    await response.json();


                // =========================================
                // CHECK API RESULT
                // =========================================

                if (
                    !response.ok ||
                    !result.success
                ) {

                    throw new Error(
                        result.message ||
                        "Status update failed."
                    );
                }


                // =================================================
                // IMPORTANT:
                // SERVER RESPONSE IS THE SOURCE OF TRUTH
                // =================================================

                if (
                    result.booking
                ) {

                    const updatedIndex =
                        allBookings.findIndex(
                            item =>
                                String(item._id) ===
                                String(
                                    result.booking._id
                                )
                        );


                    if (
                        updatedIndex !== -1
                    ) {

                        allBookings[
                            updatedIndex
                        ] =
                            result.booking;

                    } else {

                        allBookings.unshift(
                            result.booking
                        );
                    }

                }


                // =================================================
                // GET UPDATED BOOKING
                // =================================================

                const updatedBooking =
                    result.booking ||
                    currentBooking;


                // =================================================
                // GET ACTUAL PAYMENT STATUS
                // =================================================

                const updatedPaymentStatus =
                    getPaymentStatus(
                        updatedBooking
                    );


                // =================================================
                // SUCCESS MESSAGE
                // =================================================

                if (
                    selectedStatus ===
                        "cancelled" &&
                    updatedPaymentStatus ===
                        "refunded"
                ) {

                    showFlash(
                        "success",
                        "Booking Cancelled",
                        "Booking cancelled successfully and payment has been marked as refunded."
                    );

                } else if (
                    selectedStatus ===
                    "cancelled"
                ) {

                    showFlash(
                        "success",
                        "Booking Cancelled",
                        "Booking cancelled successfully."
                    );

                } else if (
                    selectedStatus ===
                    "confirmed"
                ) {

                    showFlash(
                        "success",
                        "Booking Confirmed",
                        "Booking confirmed successfully."
                    );

                } else if (
                    selectedStatus ===
                    "completed"
                ) {

                    showFlash(
                        "success",
                        "Booking Completed",
                        "Booking completed successfully."
                    );

                } else {

                    showFlash(
                        "success",
                        "Status Updated",
                        result.message ||
                        "Booking status updated successfully."
                    );
                }


                // =================================================
                // CLOSE MODAL
                // =================================================

                closeModal();


                // =================================================
                // IMMEDIATE UI UPDATE
                // =================================================

                renderBookings();


                // =================================================
                // FETCH FRESH DATABASE DATA
                // =================================================

                await loadBookings();


            } catch (error) {

                console.error(
                    "Status Update Error:",
                    error
                );


                showFlash(
                    "error",
                    "Update Failed",
                    error.message ||
                    "Failed to update booking status."
                );


            } finally {

                submitStatusBtn.disabled =
                    false;

                submitStatusBtn.textContent =
                    "Update Status";

            }

        }
    );



    // =========================================================
    // FILTER BUTTONS
    // =========================================================

    document
        .querySelectorAll(".filter-btn")
        .forEach(button => {

            button.addEventListener(
                "click",
                () => {

                    currentFilter =
                        button.dataset.filter;


                    document
                        .querySelectorAll(
                            ".filter-btn"
                        )
                        .forEach(
                            item => {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                    button.classList.add(
                        "active"
                    );


                    renderBookings();

                }
            );

        });



    // =========================================================
    // REFRESH BUTTON
    // =========================================================

    refreshBtn.addEventListener(
        "click",
        async () => {

            refreshBtn.disabled =
                true;

            refreshIcon.classList.add(
                "spin"
            );


            try {

                await loadBookings();

            } finally {

                refreshBtn.disabled =
                    false;

                refreshIcon.classList.remove(
                    "spin"
                );

            }

        }
    );



    // =========================================================
    // RETRY
    // =========================================================

    retryBtn.addEventListener(
        "click",
        () => {

            loadBookings();

        }
    );



    // =========================================================
    // CLOSE MODAL BUTTONS
    // =========================================================

    closeModalBtn.addEventListener(
        "click",
        closeModal
    );


    cancelModalBtn.addEventListener(
        "click",
        closeModal
    );



    // =========================================================
    // CLICK OUTSIDE MODAL
    // =========================================================

    updateModal.addEventListener(
        "click",
        event => {

            if (
                event.target ===
                updateModal
            ) {

                closeModal();

            }

        }
    );



    // =========================================================
    // ESCAPE KEY
    // =========================================================

    document.addEventListener(
        "keydown",
        event => {

            if (
                event.key === "Escape" &&
                !updateModal.classList.contains(
                    "hidden"
                )
            ) {

                closeModal();

            }

        }
    );



    // =========================================================
    // INITIAL LOAD
    // =========================================================

    loadBookings();


</script>


</body>

</html>