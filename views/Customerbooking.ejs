    </div>

  </main>


  <!-- ================= UPDATE MODAL ================= -->

  <div id="updateModal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-[#0B1536]/40 backdrop-blur-sm hidden p-4">

    <div
      class="bg-white w-full max-w-[480px] rounded-3xl p-8 shadow-2xl relative border border-slate-100">

      <!-- CLOSE -->

