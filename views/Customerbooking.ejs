      </button>


      <!-- TITLE -->

      <div class="text-center mb-7">

        <h2 class="text-2xl font-extrabold text-[#FF462D]">

          Update Status

        </h2>

        <p id="modalBookingId"
          class="text-xs font-semibold text-slate-400 mt-1">

          Booking

        </p>

      </div>


      <!-- CURRENT CAR -->

      <div id="modalCarInfo"
        class="bg-slate-50 rounded-2xl p-3 mb-5 flex items-center gap-3">

        <div
          class="w-16 h-12 rounded-xl bg-white border border-slate-100 flex items-center justify-center p-1">

          <img
            id="modalCarImage"
            src=""
