<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RideWave Admin - Bookings</title>

  <link rel="icon" type="image/png" href="/images/title.png.jpeg">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .booking-card {
      transition: all 0.2s ease;
    }

    .booking-card.hidden-card {
      display: none;
    }

    .loader {
      border: 3px solid #e2e8f0;
      border-top: 3px solid #FF462D;
      border-radius: 50%;
      width: 30px;
      height: 30px;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* =====================================================
       FLASH MESSAGE
    ===================================================== */

    #flashMessage {
      transform: translateX(450px);
      opacity: 0;
      pointer-events: none;
      transition: all 0.3s ease;
    }

    #flashMessage.show {
      transform: translateX(0);
      opacity: 1;
    }

    #flashMessage.success {
      background: green;
      border-color: #a7f3d0;
      color: white;
    }

    #flashMessage.success #flashIconBox {
      background: green;
      color: white;
    }

    #flashMessage.error {
      background: #be123c;
      border-color: #fecdd3;
      color: white;
    }

    #flashMessage.error #flashIconBox {
      background: #be123c;
      color: white;
    }

    @media (max-width: 640px) {

      #flashMessage {
        left: 15px;
        right: 15px;
        top: 15px;
        min-width: auto;
        max-width: none;
        transform: translateY(-150px);
      }

      #flashMessage.show {
        transform: translateY(0);
      }

    }
  </style>
</head>

<body class="bg-[#F8FAFC] text-slate-800 flex min-h-screen relative">

  <!-- =====================================================
       FLASH MESSAGE
  ===================================================== -->

  <div id="flashMessage"
    class="fixed top-6 right-6 z-[9999] min-w-[320px] max-w-[430px]
           border rounded-2xl shadow-xl px-4 py-3
           flex items-center gap-3">

    <div id="flashIconBox"
      class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0">

      <i data-lucide="check-circle-2" class="w-5 h-5"></i>

    </div>

    <div class="flex-1">

      <div id="flashTitle"
        class="text-sm font-extrabold">

        Success

      </div>

      <div id="flashText"
        class="text-xs mt-0.5 opacity-80">

        Booking updated successfully.

      </div>

    </div>

  </div>


  <!-- ================= SIDEBAR ================= -->

  <aside class="w-64 bg-[#0B1536] text-white flex flex-col justify-between p-6 shrink-0">

    <div>

      <div class="flex items-center gap-2 mb-10">

        <span class="text-2xl font-bold tracking-tight text-white">

          Ride<span class="text-[#FF462D]">Wave</span>

        </span>

        <span
          class="bg-[#FF462D]/15 text-[#FF462D] text-[10px] font-bold px-2 py-0.5 rounded tracking-wider uppercase">

          ADMIN

        </span>

      </div>


      <div class="space-y-6">

        <!-- MAIN -->

        <div>

          <p
            class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">

            Main

          </p>


          <nav class="space-y-1.5">

            <a href="/admin"
              class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">

              <i data-lucide="layout-grid" class="w-5 h-5"></i>

              <span>Dashboard</span>

            </a>


            <a href="/carAdmin"
              class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">

              <i data-lucide="car" class="w-5 h-5"></i>

              <span>Rental Cars</span>

            </a>


            <a href="/Customerbooking"
              class="flex items-center justify-between px-4 py-3 bg-[#FF462D] text-white rounded-xl font-medium shadow-md shadow-[#FF462D]/20 transition-all duration-200">

              <div class="flex items-center gap-3.5">

                <i data-lucide="calendar" class="w-5 h-5"></i>

                <span>Bookings</span>

              </div>

              <span id="pendingSidebarCount"
                class="bg-[#FF9F1C] text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">

                0

