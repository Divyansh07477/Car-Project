    // =========================================================
    // LOAD BOOKINGS
    // =========================================================

    async function loadBookings() {

        loadingState.classList.remove(
            "hidden"
        );

        errorState.classList.add(
            "hidden"
        );

        emptyState.classList.add(
            "hidden"
        );

        bookingsContainer.classList.add(
            "hidden"
        );


        try {

            const response =
                await fetch(
                    "/api/bookings/owner-bookings",
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        },
                        credentials: "include"
                    }
                );


            const contentType =
                response.headers.get(
                    "content-type"
                ) || "";


            if (
                !contentType.includes(
                    "application/json"
                )
            ) {

                throw new Error(
                    "Server returned HTML instead of JSON. Please check your login session and API route."
                );
            }


            const result =
                await response.json();


            if (
                !response.ok ||
                !result.success
            ) {

                throw new Error(
                    result.message ||
                    "Failed to load bookings."
                );
            }


            allBookings =
                Array.isArray(
                    result.bookings
                )
                    ? result.bookings
                    : [];


            renderBookings();


        } catch (error) {

            console.error(
                "Load Bookings Error:",
                error
            );


            loadingState.classList.add(
                "hidden"
            );

            errorState.classList.remove(
                "hidden"
            );

            errorText.textContent =
                error.message ||
                "Failed to load bookings.";

        }
    }



    // =========================================================
    // RENDER BOOKINGS
    // =========================================================

    function renderBookings() {

        loadingState.classList.add(
            "hidden"
        );

        errorState.classList.add(
            "hidden"
        );


        let filteredBookings =
            allBookings;


        // =============================================
        // FILTER
        // =============================================

        if (
            currentFilter !== "all"
        ) {

            filteredBookings =
                allBookings.filter(
                    booking =>
                        getBookingStatus(
                            booking
                        ) === currentFilter
                );
        }


        // =============================================
        // COUNT
        // =============================================

        bookingCount.textContent =
            `${filteredBookings.length} ${
                filteredBookings.length === 1
                    ? "booking"
                    : "bookings"
            }`;


        // =============================================
        // EMPTY
        // =============================================

        if (
            filteredBookings.length === 0
        ) {

            bookingsContainer.classList.add(
                "hidden"
            );

            emptyState.classList.remove(
                "hidden"
            );

            return;
        }


        emptyState.classList.add(
            "hidden"
        );

        bookingsContainer.classList.remove(
            "hidden"
        );


        bookingsContainer.innerHTML =
            filteredBookings
                .map(
                    booking =>
                        createBookingCard(
                            booking
                        )
                )
                .join("");


        if (window.lucide) {
            lucide.createIcons();
        }
    }



