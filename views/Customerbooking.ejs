            bookingId;

        selectedStatus = null;


        const bookingStatus =
            getBookingStatus(booking);


        // =================================================
        // AMOUNT CALCULATION FOR MODAL
        // =================================================

        const days =
            Math.max(
                1,
                Number(
                    booking?.totalDays
                ) || 1
            );


        const pricePerDay =
            Number(
                booking?.pricePerDay ??
                booking?.car?.pricePerDay ??
                0
            ) || 0;


        let baseAmount =
            Number(
                booking?.baseAmount
            ) || 0;


        if (baseAmount <= 0) {

            baseAmount =
                pricePerDay * days;
        }


        let gstAmount =
            Number(
                booking?.gstAmount
            ) || 0;


        if (gstAmount <= 0) {

            gstAmount =
                Math.round(
                    baseAmount * 0.18
                );
        }


        let securityDeposit =
            Number(
                booking?.securityDeposit
            ) || 0;


        if (securityDeposit <= 0) {

            securityDeposit = 3000;
        }


        const totalAmount =
            baseAmount +
            gstAmount +
            securityDeposit;


        let amountPaid =
            getAmountPaid(booking);


        if (
            getPaymentStatus(booking) ===
            "paid"
        ) {

            amountPaid =
                totalAmount;
        }


        // =================================================
        // MODAL BOOKING INFO
        // =================================================

        modalBookingInfo.innerHTML = `

            <div
                class="flex items-center justify-between text-xs"
            >

                <div>

                    <p
                        class="text-slate-400 font-medium"
                    >
                        Car
                    </p>

