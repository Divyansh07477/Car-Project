<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RideWave Admin - Bookings</title>
  <link rel="icon" type="image/png" href="/images/title.png.jpeg">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
</head>
<body class="bg-[#F8FAFC] text-slate-800 flex min-h-screen relative">

  <aside class="w-64 bg-[#0B1536] text-white flex flex-col justify-between p-6 shrink-0">
    <div>
      <div class="flex items-center gap-2 mb-10">
        <span class="text-2xl font-bold tracking-tight text-white">Ride<span class="text-[#FF462D]">Wave</span></span>
        <span class="bg-[#FF462D]/15 text-[#FF462D] text-[10px] font-bold px-2 py-0.5 rounded tracking-wider uppercase">ADMIN</span>
      </div>

      <div class="space-y-6">
        <div>
          <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">Main</p>
          <nav class="space-y-1.5">
            <a href="/admin" class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">
              <i data-lucide="layout-grid" class="w-5 h-5"></i>
              <span>Dashboard</span>
            </a>
            
            <a href="/carAdmin" class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">
              <i data-lucide="car" class="w-5 h-5"></i>
              <span>Rental Cars</span>
            </a>

            <a href="/Customerbooking" class="flex items-center justify-between px-4 py-3 bg-[#FF462D] text-white rounded-xl font-medium shadow-md shadow-[#FF462D]/20 transition-all duration-200">
              <div class="flex items-center gap-3.5">
                <i data-lucide="calendar" class="w-5 h-5"></i>
                <span>Bookings</span>
              </div>
              <span class="bg-white/20 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">4</span>
            </a>
          </nav>
        </div>

        <div>
          <p class="text-[11px] uppercase tracking-wider text-slate-500 font-semibold mb-3 px-3">Other</p>
          <nav class="space-y-1.5">
            <a href="/" class="flex items-center gap-3.5 px-4 py-3 text-slate-400 hover:text-white hover:bg-white/5 rounded-xl font-medium transition-all duration-200">
              <i data-lucide="arrow-left" class="w-5 h-5"></i>
              <span>Back to Site</span>
            </a>
          </nav>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-slate-800 flex items-center gap-2 text-xs text-slate-500">
      <i data-lucide="shield" class="w-4 h-4 text-[#FF462D]"></i>
      <span>Admin Panel</span>
    </div>
  </aside>

  <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
    <header class="p-8 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-2xl font-bold text-[#0B1536]">Bookings</h1>
          <button class="text-slate-400 hover:text-slate-600 transition" title="Refresh">
            <i data-lucide="rotate-cw" class="w-4 h-4"></i>
          </button>
        </div>
        <p class="text-xs text-slate-400 mt-0.5">Review and manage customer bookings.</p>
      </div>

      <div class="flex items-center gap-2 text-xs font-semibold overflow-x-auto pb-1">
        <button class="bg-[#FF462D] text-white px-4 py-1.5 rounded-full shadow-sm">All</button>
        <button class="bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 px-4 py-1.5 rounded-full transition">Pending</button>
        <button class="bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 px-4 py-1.5 rounded-full transition">Confirmed</button>
        <button class="bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 px-4 py-1.5 rounded-full transition">Completed</button>
        <button class="bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 px-4 py-1.5 rounded-full transition">Cancelled</button>
      </div>
    </header>

    <div class="p-8 pt-2 space-y-3">
      
      <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-slate-200 transition-all">
        <div class="flex items-center gap-5">
          <div class="w-24 h-16 bg-slate-50 rounded-xl flex items-center justify-center p-2 shrink-0 border border-slate-100">
            <img src="https://purepng.com/public/uploads/large/purepng.com-green-porsche-macan-carcarvehicletransportporsche-9615246473185h93i.png" alt="Macan 4" class="max-h-full object-contain" />
          </div>
          <div class="space-y-1">
            <h3 class="font-bold text-[#0B1536] text-base leading-tight">Macan 4</h3>
            <div class="flex items-center gap-1.5 text-xs text-slate-400">
              <i data-lucide="user" class="w-3.5 h-3.5"></i>
              <span>Waseem (<span class="text-slate-500">waseemuser@gmail.com</span>)</span>
            </div>
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 pt-0.5">
              <span class="flex items-center gap-1">
                <i data-lucide="calendar" class="w-3.5 h-3.5"></i> Feb 27 &rarr; Mar 3
              </span>
              <span class="flex items-center gap-1">
                <i data-lucide="map-pin" class="w-3.5 h-3.5"></i> New York, USA
              </span>
            </div>
          </div>
        </div>
        <div class="flex md:flex-col items-end justify-between w-full md:w-auto gap-2 self-stretch md:self-auto">
          <div class="text-right">
            <div class="text-base font-bold text-[#FF462D]">$1196</div>
            <span class="inline-block bg-amber-50 text-amber-600 text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">Pending</span>
          </div>
          <button data-booking-id="#8" class="open-modal-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Update
          </button>
        </div>
      </div>

      <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-slate-200 transition-all">
        <div class="flex items-center gap-5">
          <div class="w-24 h-16 bg-slate-50 rounded-xl flex items-center justify-center p-2 shrink-0 border border-slate-100">
            <img src="https://purepng.com/public/uploads/large/purepng.com-green-porsche-macan-carcarvehicletransportporsche-9615246473185h93i.png" alt="Macan 4" class="max-h-full object-contain" />
          </div>
          <div class="space-y-1">
            <h3 class="font-bold text-[#0B1536] text-base leading-tight">Macan 4</h3>
            <div class="flex items-center gap-1.5 text-xs text-slate-400">
              <i data-lucide="user" class="w-3.5 h-3.5"></i>
              <span>Waseem (<span class="text-slate-500">waseemuser@gmail.com</span>)</span>
            </div>
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 pt-0.5">
              <span class="flex items-center gap-1">
                <i data-lucide="calendar" class="w-3.5 h-3.5"></i> Feb 26 &rarr; Feb 27
              </span>
              <span class="flex items-center gap-1">
                <i data-lucide="map-pin" class="w-3.5 h-3.5"></i> New York, USA
              </span>
            </div>
          </div>
        </div>
        <div class="flex md:flex-col items-end justify-between w-full md:w-auto gap-2 self-stretch md:self-auto">
          <div class="text-right">
            <div class="text-base font-bold text-[#FF462D]">$299</div>
            <span class="inline-block bg-sky-50 text-sky-600 text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">Completed</span>
          </div>
          <button data-booking-id="#9" class="open-modal-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Update
          </button>
        </div>
      </div>

      <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-slate-200 transition-all">
        <div class="flex items-center gap-5">
          <div class="w-24 h-16 bg-slate-50 rounded-xl flex items-center justify-center p-2 shrink-0 border border-slate-100">
            <img src="https://purepng.com/public/uploads/large/purepng.com-white-nissan-gt-r-carcarvehicletransportnissan-961524643640w383f.png" alt="Nisan GT-R" class="max-h-full object-contain" />
          </div>
          <div class="space-y-1">
            <h3 class="font-bold text-[#0B1536] text-base leading-tight">Nisan GT-R</h3>
            <div class="flex items-center gap-1.5 text-xs text-slate-400">
              <i data-lucide="user" class="w-3.5 h-3.5"></i>
              <span>Admin (<span class="text-slate-500">admin@ridewave.com</span>)</span>
            </div>
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 pt-0.5">
              <span class="flex items-center gap-1">
                <i data-lucide="calendar" class="w-3.5 h-3.5"></i> Feb 26 &rarr; Feb 28
              </span>
              <span class="flex items-center gap-1">
                <i data-lucide="map-pin" class="w-3.5 h-3.5"></i> New York, USA
              </span>
            </div>
          </div>
        </div>
        <div class="flex md:flex-col items-end justify-between w-full md:w-auto gap-2 self-stretch md:self-auto">
          <div class="text-right">
            <div class="text-base font-bold text-[#FF462D]">$598</div>
            <span class="inline-block bg-sky-50 text-sky-600 text-[10px] font-bold px-2 py-0.5 rounded tracking-wide uppercase mt-0.5">Completed</span>
          </div>
          <button data-booking-id="#10" class="open-modal-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors">
            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Update
          </button>
        </div>
      </div>

    </div>
  </main>

  <div id="updateModal" class="fixed inset-0 z-50 flex items-center justify-center bg-[#0B1536]/40 backdrop-blur-sm hidden transition-all duration-200 p-4">
    
    <div class="bg-white w-full max-w-[480px] rounded-3xl p-8 shadow-2xl relative border border-slate-100 transform transition-all">
      
      <button id="closeModalBtn" class="absolute top-6 right-6 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-700 transition">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="text-center mb-7">
        <h2 class="text-2xl font-extrabold text-[#FF462D]">Update Status</h2>
        <p id="modalBookingId" class="text-xs font-semibold text-slate-400 mt-1">Booking #8</p>
      </div>

      <div class="grid grid-cols-4 gap-3 mb-6">
        
        <button type="button" class="status-btn border-2 border-emerald-500 bg-emerald-50 text-emerald-600 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all hover:shadow-md" data-status="Confirm">
          <i data-lucide="check-circle-2" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Confirm</span>
        </button>

        <button type="button" class="status-btn border border-slate-200 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-600 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all" data-status="Complete">
          <i data-lucide="check-check" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Complete</span>
        </button>

        <button type="button" class="status-btn border border-slate-200 hover:border-rose-400 hover:bg-rose-50 hover:text-rose-600 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all" data-status="Cancel">
          <i data-lucide="x-circle" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Cancel</span>
        </button>

        <button type="button" class="status-btn border border-slate-200 hover:border-amber-400 hover:bg-amber-50 hover:text-amber-600 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all" data-status="Pending">
          <i data-lucide="clock" class="w-5 h-5"></i>
          <span class="text-xs font-bold">Pending</span>
        </button>

      </div>

      <form id="statusUpdateForm" onsubmit="event.preventDefault();">
        <div class="space-y-2 mb-6">
          <label class="text-xs font-bold text-slate-700 block">Reason / Note <span class="font-normal text-slate-400">(optional)</span></label>
          <textarea 
            rows="3" 
            placeholder="Add a reason or note for the customer..." 
            class="w-full border border-slate-200 rounded-2xl p-3.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#FF462D] focus:ring-1 focus:ring-[#FF462D] transition resize-none"></textarea>
        </div>

        <button type="submit" class="w-full py-3.5 bg-[#FF462D] hover:bg-[#e03a22] text-white font-bold rounded-2xl text-sm shadow-md shadow-[#FF462D]/25 transition active:scale-[0.99]">
          Update Status
        </button>
      </form>

    </div>
  </div>

  <script>
    lucide.createIcons();

    const modal = document.getElementById('updateModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const openBtns = document.querySelectorAll('.open-modal-btn');
    const modalBookingId = document.getElementById('modalBookingId');
    const statusBtns = document.querySelectorAll('.status-btn');

    // Open Modal with Booking ID
    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-booking-id') || '#8';
        modalBookingId.textContent = `Booking ${id}`;
        modal.classList.remove('hidden');
      });
    });

    // Close Modal
    function closeModal() {
      modal.classList.add('hidden');
    }

    closeModalBtn.addEventListener('click', closeModal);

    // Close on overlay backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Toggle active status styles
    const statusStyles = {
      Confirm: { border: 'border-emerald-500', bg: 'bg-emerald-50', text: 'text-emerald-600' },
      Complete: { border: 'border-sky-500', bg: 'bg-sky-50', text: 'text-sky-600' },
      Cancel: { border: 'border-rose-500', bg: 'bg-rose-50', text: 'text-rose-600' },
      Pending: { border: 'border-amber-500', bg: 'bg-amber-50', text: 'text-amber-600' }
    };

    statusBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset all buttons to default grey state
        statusBtns.forEach(b => {
          b.className = 'status-btn border border-slate-200 text-slate-500 rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all';
        });

        // Apply active style to selected button
        const status = btn.getAttribute('data-status');
        const style = statusStyles[status];
        btn.className = `status-btn border-2 ${style.border} ${style.bg} ${style.text} rounded-2xl p-3 flex flex-col items-center justify-center gap-1.5 transition-all shadow-sm`;
      });
    });
  </script>
</body>
</html>