<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>RideWave Admin - Customer Bookings</title>

    <link
        rel="icon"
        type="image/png"
        href="/images/title.png.jpeg"
    >

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Plus Jakarta Sans", sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }

        .sidebar {
            background: #08123B;
        }

        .orange {
            color: #FF532E;
        }

        .orange-bg {
            background: #FF532E;
        }

        .nav-item {
            transition: all 0.2s ease;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .nav-item.active {
            background: #FF532E;
            color: white;
        }

        .booking-card {
            transition: all 0.2s ease;
        }

        .booking-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
        }

        .filter-btn {
            transition: all 0.2s ease;
        }

        .filter-btn.active {
            background: #FF532E;
            color: white;
            border-color: #FF532E;
        }

        .modal-overlay {
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(4px);
        }

        .status-btn {
            transition: all 0.2s ease;
        }

        .status-btn.selected {
            border-color: #FF532E;
            background: #fff1ed;
            color: #FF532E;
        }

        .status-btn:hover {
            transform: translateY(-1px);
        }

        .scrollbar::-webkit-scrollbar {
            width: 6px;
        }

        .scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .flash-message {
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .spin {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @media (max-width: 900px) {

            .sidebar {
                width: 220px !important;
            }

            .main-content {
                margin-left: 220px !important;
            }

        }

        @media (max-width: 700px) {

            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0 !important;
            }

        }

    </style>

</head>


<body>


<!-- ========================================================= -->
<!-- SIDEBAR -->
<!-- ========================================================= -->

<aside
    class="sidebar fixed top-0 left-0 h-screen w-64 text-white flex flex-col z-40"
>

    <!-- LOGO -->
    <div class="px-6 py-7 border-b border-white/10">

        <a
            href="/"
            class="text-2xl font-extrabold tracking-tight"
        >

            Ride
            <span class="text-[#FF532E]">
                Wave
            </span>

        </a>

        <p class="text-xs text-white/50 mt-1">
            Admin Panel
        </p>

    </div>


    <!-- NAVIGATION -->
    <nav class="flex-1 px-4 py-6 space-y-2">

        <!-- Dashboard -->
        <a
            href="/admin"
            class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-white/80"
        >

            <i data-lucide="layout-dashboard" class="w-5 h-5"></i>

            <span>
                Dashboard
            </span>

        </a>


        <!-- Rental Cars -->
        <a
            href="/carAdmin"
            class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-white/80"
        >

            <i data-lucide="car-front" class="w-5 h-5"></i>

            <span>
                Rental Cars
            </span>

        </a>


        <!-- Customer Bookings -->
        <a
            href="/Customerbooking"
            class="nav-item active flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold"
        >

            <i data-lucide="calendar-check" class="w-5 h-5"></i>

            <span>
                Customer Bookings
            </span>

        </a>


        <!-- Website -->
        <a
            href="/"
            class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-white/80"
        >

            <i data-lucide="external-link" class="w-5 h-5"></i>

            <span>
                View Website
            </span>

        </a>

    </nav>


    <!-- SIDEBAR FOOTER -->
    <div class="px-4 py-5 border-t border-white/10">

        <div class="flex items-center gap-3 px-3">

            <div
                class="w-10 h-10 rounded-full bg-[#FF532E] flex items-center justify-center"
            >

                <i data-lucide="user" class="w-5 h-5"></i>

            </div>

            <div>

                <p class="text-sm font-semibold">
                    Admin
                </p>

                <p class="text-xs text-white/50">
                    RideWave
                </p>

            </div>

        </div>

    </div>

</aside>



<!-- ========================================================= -->
<!-- MAIN CONTENT -->
<!-- ========================================================= -->

<main
    class="main-content ml-64 min-h-screen"
>


    <!-- ===================================================== -->
    <!-- TOP HEADER -->
    <!-- ===================================================== -->

    <header
        class="bg-white border-b border-slate-200 sticky top-0 z-30"
    >

        <div
            class="px-8 py-5 flex items-center justify-between"
        >

            <div>

                <h1
                    class="text-2xl font-extrabold text-slate-900"
                >
                    Customer Bookings
                </h1>

                <p
                    class="text-sm text-slate-500 mt-1"
                >
                    Manage bookings for your rental cars
                </p>

            </div>


            <!-- Refresh -->
            <button
                id="refreshBtn"
                type="button"
                class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition"
            >

                <i
                    data-lucide="refresh-cw"
                    id="refreshIcon"
                    class="w-4 h-4"
                ></i>

                Refresh

            </button>

        </div>

    </header>



    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <section class="px-8 py-7">


        <!-- ================================================= -->
        <!-- FLASH MESSAGE -->
        <!-- ================================================= -->

        <div
            id="flashMessage"
            class="hidden mb-6"
        ></div>



        <!-- ================================================= -->
        <!-- FILTERS -->
        <!-- ================================================= -->

        <div
            class="bg-white border border-slate-200 rounded-2xl p-4 mb-6"
        >

            <div
                class="flex flex-wrap items-center gap-2"
            >

                <button
                    type="button"
                    class="filter-btn active px-4 py-2 rounded-xl border border-slate-200 text-sm font-semibold"
                    data-filter="all"
                >
                    All
                </button>


                <button
                    type="button"
                    class="filter-btn px-4 py-2 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600"
                    data-filter="pending"
                >
                    Pending
                </button>


                <button
                    type="button"
                    class="filter-btn px-4 py-2 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600"
                    data-filter="confirmed"
                >
                    Confirmed
                </button>


                <button
                    type="button"
                    class="filter-btn px-4 py-2 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600"
                    data-filter="completed"
                >
                    Completed
                </button>


                <button
                    type="button"
                    class="filter-btn px-4 py-2 rounded-xl border border-slate-200 text-sm font-semibold text-slate-600"
                    data-filter="cancelled"
                >
                    Cancelled
                </button>


                <div class="ml-auto">

                    <span
                        id="bookingCount"
                        class="text-sm text-slate-500 font-semibold"
                    >
                        0 bookings
                    </span>

                </div>

            </div>

        </div>



        <!-- ================================================= -->
        <!-- LOADING -->
        <!-- ================================================= -->

        <div
            id="loadingState"
            class="bg-white border border-slate-200 rounded-2xl p-12 text-center"
        >

            <div class="flex justify-center mb-4">

                <i
                    data-lucide="loader-2"
                    class="w-8 h-8 text-[#FF532E] spin"
                ></i>

            </div>

            <p class="text-slate-600 font-semibold">
                Loading bookings...
            </p>

        </div>



        <!-- ================================================= -->
        <!-- ERROR -->
        <!-- ================================================= -->

        <div
            id="errorState"
            class="hidden bg-white border border-red-200 rounded-2xl p-12 text-center"
        >

            <div
                class="w-14 h-14 mx-auto rounded-full bg-red-100 flex items-center justify-center mb-4"
            >

                <i
                    data-lucide="alert-circle"
                    class="w-7 h-7 text-red-600"
                ></i>

            </div>

            <h3
                class="text-lg font-bold text-slate-900"
            >
                Failed to load bookings
            </h3>

            <p
                id="errorText"
                class="text-sm text-slate-500 mt-2"
            >
                Something went wrong.
            </p>

            <button
                id="retryBtn"
                type="button"
                class="mt-5 px-5 py-2.5 bg-[#FF532E] text-white rounded-xl font-semibold text-sm"
            >
                Try Again
            </button>

        </div>



        <!-- ================================================= -->
        <!-- EMPTY -->
        <!-- ================================================= -->

        <div
            id="emptyState"
            class="hidden bg-white border border-slate-200 rounded-2xl p-12 text-center"
        >

            <div
                class="w-14 h-14 mx-auto rounded-full bg-slate-100 flex items-center justify-center mb-4"
            >

                <i
                    data-lucide="calendar-x"
                    class="w-7 h-7 text-slate-400"
                ></i>

            </div>

            <h3
                class="text-lg font-bold text-slate-900"
            >
                No bookings found
            </h3>

            <p
                class="text-sm text-slate-500 mt-2"
            >
                There are no bookings matching this filter.
            </p>

        </div>



        <!-- ================================================= -->
        <!-- BOOKINGS GRID -->
        <!-- ================================================= -->

        <div
            id="bookingsContainer"
            class="hidden space-y-5"
        ></div>


    </section>

</main>



<!-- ========================================================= -->
<!-- UPDATE STATUS MODAL -->
<!-- ========================================================= -->

<div
    id="updateModal"
    class="hidden fixed inset-0 modal-overlay z-50 items-center justify-center p-4"
>

    <div
        class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden"
    >


        <!-- MODAL HEADER -->
        <div
            class="px-6 py-5 border-b border-slate-200 flex items-center justify-between"
        >

            <div>

                <h2
                    class="text-lg font-extrabold text-slate-900"
                >
                    Update Booking Status
                </h2>

                <p
                    class="text-xs text-slate-500 mt-1"
                >
                    Change the current booking status
                </p>

            </div>


            <button
                id="closeModalBtn"
                type="button"
                class="w-9 h-9 rounded-full hover:bg-slate-100 flex items-center justify-center"
            >

                <i
                    data-lucide="x"
                    class="w-5 h-5"
                ></i>

            </button>

        </div>



        <!-- MODAL BODY -->
        <form
            id="statusUpdateForm"
            class="p-6"
        >


            <!-- BOOKING INFO -->
            <div
                id="modalBookingInfo"
                class="bg-slate-50 rounded-2xl p-4 mb-5"
            ></div>


            <!-- PAYMENT INFO -->
            <div
                id="modalPaymentInfo"
                class="mb-5"
            ></div>


            <!-- STATUS -->
            <div class="mb-5">

                <label
                    class="block text-sm font-bold text-slate-800 mb-3"
                >
                    Select Status
                </label>


                <div class="grid grid-cols-2 gap-3">


                    <!-- CONFIRMED -->
                    <button
                        type="button"
                        data-status="confirmed"
                        class="status-btn border border-slate-200 rounded-2xl p-4 text-left"
                    >

                        <div
                            class="flex items-center gap-3"
                        >

                            <div
                                class="w-9 h-9 rounded-xl bg-blue-100 flex items-center justify-center"
                            >

                                <i
                                    data-lucide="check-circle"
                                    class="w-5 h-5 text-blue-600"
                                ></i>

                            </div>

                            <div>

                                <p class="font-bold text-sm">
                                    Confirmed
                                </p>

                                <p class="text-xs text-slate-500">
                                    Approve booking
                                </p>

                            </div>

                        </div>

                    </button>



                    <!-- COMPLETED -->
                    <button
                        type="button"
                        data-status="completed"
                        class="status-btn border border-slate-200 rounded-2xl p-4 text-left"
                    >

                        <div
                            class="flex items-center gap-3"
                        >

                            <div
                                class="w-9 h-9 rounded-xl bg-green-100 flex items-center justify-center"
                            >

                                <i
                                    data-lucide="badge-check"
                                    class="w-5 h-5 text-green-600"
                                ></i>

                            </div>

                            <div>

                                <p class="font-bold text-sm">
                                    Completed
                                </p>

                                <p class="text-xs text-slate-500">
                                    Finish booking
                                </p>

                            </div>

                        </div>

                    </button>



                    <!-- CANCELLED -->
                    <button
                        type="button"
                        data-status="cancelled"
                        class="status-btn border border-slate-200 rounded-2xl p-4 text-left"
                    >

                        <div
                            class="flex items-center gap-3"
                        >

                            <div
                                class="w-9 h-9 rounded-xl bg-red-100 flex items-center justify-center"
                            >

                                <i
                                    data-lucide="x-circle"
                                    class="w-5 h-5 text-red-600"
                                ></i>

                            </div>

                            <div>

                                <p class="font-bold text-sm">
                                    Cancelled
                                </p>

                                <p class="text-xs text-slate-500">
                                    Cancel booking
                                </p>

                            </div>

                        </div>

                    </button>



                    <!-- PENDING -->
                    <button
                        type="button"
                        data-status="pending"
                        class="status-btn border border-slate-200 rounded-2xl p-4 text-left"
                    >

                        <div
                            class="flex items-center gap-3"
                        >

                            <div
                                class="w-9 h-9 rounded-xl bg-yellow-100 flex items-center justify-center"
                            >

                                <i
                                    data-lucide="clock-3"
                                    class="w-5 h-5 text-yellow-600"
                                ></i>

                            </div>

                            <div>

                                <p class="font-bold text-sm">
                                    Pending
                                </p>

                                <p class="text-xs text-slate-500">
                                    Keep pending
                                </p>

                            </div>

                        </div>

                    </button>


                </div>

            </div>



            <!-- NOTE -->
            <div class="mb-6">

                <label
                    for="modalNote"
                    class="block text-sm font-bold text-slate-800 mb-2"
                >
                    Note
                    <span class="text-slate-400 font-normal">
                        (optional)
                    </span>
                </label>

                <textarea
                    id="modalNote"
                    rows="3"
                    placeholder="Add a note for this booking..."
                    class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm outline-none focus:border-[#FF532E] focus:ring-2 focus:ring-orange-100 resize-none"
                ></textarea>

            </div>



            <!-- ACTIONS -->
            <div
                class="flex items-center justify-end gap-3"
            >

                <button
                    id="cancelModalBtn"
                    type="button"
                    class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-700 hover:bg-slate-50"
                >
                    Cancel
                </button>


                <button
                    id="submitStatusBtn"
                    type="submit"
                    class="px-5 py-2.5 rounded-xl bg-[#FF532E] text-white text-sm font-bold hover:bg-[#e94725] disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    Update Status
                </button>

            </div>

        </form>

    </div>

</div>



<script>

    // =========================================================
    // GLOBAL VARIABLES
    // =========================================================

    let allBookings = [];

    let currentFilter = "all";

    let currentBookingId = null;

    let selectedStatus = null;



    // =========================================================
    // DOM ELEMENTS
    // =========================================================

    const bookingsContainer =
        document.getElementById("bookingsContainer");

    const loadingState =
        document.getElementById("loadingState");

    const errorState =
        document.getElementById("errorState");

    const emptyState =
        document.getElementById("emptyState");

    const errorText =
        document.getElementById("errorText");

    const bookingCount =
        document.getElementById("bookingCount");

    const refreshBtn =
        document.getElementById("refreshBtn");

    const refreshIcon =
        document.getElementById("refreshIcon");

    const retryBtn =
        document.getElementById("retryBtn");

    const flashMessage =
        document.getElementById("flashMessage");


    // Modal
    const updateModal =
        document.getElementById("updateModal");

    const closeModalBtn =
        document.getElementById("closeModalBtn");

    const cancelModalBtn =
        document.getElementById("cancelModalBtn");

    const statusUpdateForm =
        document.getElementById("statusUpdateForm");

    const submitStatusBtn =
        document.getElementById("submitStatusBtn");

    const modalNote =
        document.getElementById("modalNote");

    const modalBookingInfo =
        document.getElementById("modalBookingInfo");

    const modalPaymentInfo =
        document.getElementById("modalPaymentInfo");



    // =========================================================
    // LUCIDE
    // =========================================================

    if (window.lucide) {
        lucide.createIcons();
    }



    // =========================================================
    // NORMALIZE PAYMENT STATUS
    // =========================================================

    function getPaymentStatus(booking) {

        if (
            !booking ||
            !booking.payment ||
            !booking.payment.status
        ) {
            return "pending";
        }

        return String(
            booking.payment.status
        )
            .trim()
            .toLowerCase();
    }



    // =========================================================
    // NORMALIZE BOOKING STATUS
    // =========================================================

    function getBookingStatus(booking) {

        if (
            !booking ||
            !booking.status
        ) {
            return "pending";
        }

        return String(
            booking.status
        )
            .trim()
            .toLowerCase();
    }



    // =========================================================
    // FORMAT DATE
    // =========================================================

    function formatDate(dateValue) {

        if (!dateValue) {
            return "N/A";
        }

        const date =
            new Date(dateValue);

        if (isNaN(date.getTime())) {
            return "N/A";
        }

        return date.toLocaleDateString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric"
            }
        );
    }



    // =========================================================
    // FORMAT DATE + TIME
    // =========================================================

    function formatDateTime(dateValue) {

        if (!dateValue) {
            return "N/A";
        }

        const date =
            new Date(dateValue);

        if (isNaN(date.getTime())) {
            return "N/A";
        }

        return date.toLocaleString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            }
        );
    }



    // =========================================================
    // FORMAT CURRENCY
    // =========================================================

    function formatCurrency(amount) {

        const value =
            Number(amount) || 0;

        return value.toLocaleString(
            "en-IN",
            {
                style: "currency",
                currency: "INR",
                maximumFractionDigits: 0
            }
        );
    }



    // =========================================================
    // ESCAPE HTML
    // =========================================================

    function escapeHTML(value) {

        if (
            value === null ||
            value === undefined
        ) {
            return "";
        }

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }



    // =========================================================
    // GET CAR NAME
    // =========================================================

    function getCarName(booking) {

        if (
            booking &&
            booking.car &&
            typeof booking.car === "object" &&
            booking.car.name
        ) {
            return booking.car.name;
        }

        return "Rental Car";
    }



    // =========================================================
    // GET RENTER NAME
    // =========================================================

    function getRenterName(booking) {

        if (
            booking &&
            booking.renter &&
            typeof booking.renter === "object" &&
            booking.renter.name
        ) {
            return booking.renter.name;
        }

        if (booking && booking.name) {
            return booking.name;
        }

        return "Customer";
    }



    // =========================================================
    // GET RENTER EMAIL
    // =========================================================

    function getRenterEmail(booking) {

        if (
            booking &&
            booking.renter &&
            typeof booking.renter === "object" &&
            booking.renter.email
        ) {
            return booking.renter.email;
        }

        if (booking && booking.email) {
            return booking.email;
        }

        return "N/A";
    }



    // =========================================================
    // STATUS BADGE
    // =========================================================

    function getStatusBadge(status) {

        switch (status) {

            case "confirmed":

                return `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                        Confirmed
                    </span>
                `;


            case "completed":

                return `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                        Completed
                    </span>
                `;


            case "cancelled":

                return `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                        Cancelled
                    </span>
                `;


            case "pending":
            default:

                return `
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700">
                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-600"></span>
                        Pending
                    </span>
                `;
        }
    }



    // =========================================================
    // PAYMENT BADGE
    // =========================================================

    function getPaymentBadge(booking) {

        const paymentStatus =
            getPaymentStatus(booking);


        // =============================================
        // REFUNDED
        // =============================================

        if (
            paymentStatus === "refunded"
        ) {

            return `
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                    Refunded
                </span>
            `;
        }


        // =============================================
        // PAID
        // =============================================

        if (
            paymentStatus === "paid"
        ) {

            return `
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                    <i data-lucide="badge-check" class="w-3.5 h-3.5"></i>
                    Paid
                </span>
            `;
        }


        // =============================================
        // FAILED
        // =============================================

        if (
            paymentStatus === "failed"
        ) {

            return `
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">
                    <i data-lucide="circle-x" class="w-3.5 h-3.5"></i>
                    Failed
                </span>
            `;
        }


        // =============================================
        // PENDING
        // =============================================

        return `
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700">
                <i data-lucide="clock-3" class="w-3.5 h-3.5"></i>
                Payment Pending
            </span>
        `;
    }



    // =========================================================
    // GET PAYMENT AMOUNT
    // =========================================================

    function getAmountPaid(booking) {

        if (
            booking &&
            booking.payment
        ) {

            return Number(
                booking.payment.amountPaid
            ) || 0;
        }

        return 0;
    }



    // =========================================================
    // GET REMAINING AMOUNT
    // =========================================================

    function getAmountRemaining(booking) {

        if (
            booking &&
            booking.payment
        ) {

            return Number(
                booking.payment.amountRemaining
            ) || 0;
        }

        return Number(
            booking.totalAmount
        ) || 0;
    }



