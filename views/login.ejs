<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
    }

    body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        position: relative;
        overflow: hidden;
    }

    .background {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background: url("/images/background.png")
            center center / cover no-repeat;
        filter: blur(5px);
        transform: scale(1.08);
        z-index: -2;
        animation: rideWaveBackground 16s ease-in-out infinite alternate;
    }

    @keyframes rideWaveBackground {
        0% {
            transform: scale(1.08) translateX(0);
        }

        50% {
            transform: scale(1.11) translateX(-8px);
        }

        100% {
            transform: scale(1.08) translateX(8px);
        }
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        background: linear-gradient(
            120deg,
            rgba(0, 0, 0, 0.82) 0%,
            rgba(0, 0, 0, 0.50) 50%,
            rgba(229, 63, 40, 0.18) 100%
        );
        z-index: -1;
        pointer-events: none;
    }

    body::after {
        content: "";
        position: fixed;
        width: 550px;
        height: 550px;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(229, 63, 40, 0.20) 0%,
            rgba(229, 63, 40, 0.08) 35%,
            transparent 70%
        );
        filter: blur(50px);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: -1;
        pointer-events: none;
        animation: rideWaveLight 10s ease-in-out infinite alternate;
    }

    @keyframes rideWaveLight {
        0% {
            transform: translate(-55%, -50%) scale(0.85);
            opacity: 0.45;
        }

        50% {
            transform: translate(-45%, -50%) scale(1);
            opacity: 0.65;
        }

        100% {
            transform: translate(-55%, -50%) scale(0.85);
            opacity: 0.45;
        }
    }

    .auth-card {
        width: 100%;
        max-width: 430px;
        padding: 34px;
        background: rgba(255, 255, 255, 0.97);
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 24px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.42);
        animation: cardIn 0.6s ease;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .auth-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 35px 90px rgba(0, 0, 0, 0.48);
    }

    @keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(25px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .brand {
        text-align: center;
        margin-bottom: 27px;
    }

    .brand h1 {
        font-size: 30px;
        font-weight: 750;
        color: #172554;
        letter-spacing: -0.7px;
    }

    .brand h1 span {
        color: #e53f28;
    }

    .brand p {
        margin-top: 7px;
        font-size: 14px;
        color: #718096;
    }

    .input-group {
        margin-bottom: 19px;
    }

    .input-group label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 600;
        color: #333;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper > i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
        font-size: 15px;
        pointer-events: none;
        transition: color 0.25s ease;
    }

    .input-wrapper input {
        width: 100%;
        height: 48px;
        padding: 0 45px;
        border: 1px solid #dedede;
        border-radius: 11px;
        outline: none;
        background: #fff;
        color: #222;
        font-size: 14px;
        transition:
            border-color 0.25s ease,
            box-shadow 0.25s ease,
            transform 0.25s ease;
    }

    .input-wrapper input::placeholder {
        color: #aaa;
    }

    .input-wrapper input:hover {
        border-color: #c4c4c4;
    }

    .input-wrapper input:focus {
        border-color: #e53f28;
        box-shadow: 0 0 0 4px rgba(229, 63, 40, 0.10);
        transform: translateY(-1px);
    }

    .input-wrapper:focus-within > i {
        color: #e53f28;
    }

    .password-eye {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #888;
        cursor: pointer;
        font-size: 15px;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .password-eye:hover {
        color: #e53f28;
        transform: translateY(-50%) scale(1.1);
    }

    .submit-btn {
        width: 100%;
        height: 48px;
        margin-top: 5px;
        border: none;
        border-radius: 11px;
        background: #e53f28;
        color: #fff;
        font-size: 15px;
        font-weight: 650;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(229, 63, 40, 0.22);
        transition:
            transform 0.25s ease,
            background 0.25s ease,
            box-shadow 0.25s ease;
    }

    .submit-btn:hover {
        background: #cf351f;
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(229, 63, 40, 0.30);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .toggle-box {
        margin-top: 21px;
        text-align: center;
        font-size: 13px;
        color: #777;
    }

    .toggle-box a {
        color: #e53f28;
        font-weight: 700;
        text-decoration: none;
        margin-left: 4px;
        transition: color 0.2s ease;
    }

    .toggle-box a:hover {
        color: #b92d1b;
        text-decoration: underline;
    }

    .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0;
        color: #aaa;
        font-size: 10px;
        font-weight: 600;
    }

    .divider::before,
    .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #e6e6e6;
    }

    .social-buttons {
        display: flex;
        justify-content: center;
        gap: 13px;
    }

    .social-btn {
        width: 43px;
        height: 43px;
        border-radius: 50%;
        border: 1px solid #ddd;
        background: #fff;
        color: #444;
        cursor: pointer;
        font-size: 15px;
        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .social-btn:hover {
        border-color: #e53f28;
        color: #e53f28;
        transform: translateY(-4px);
        box-shadow: 0 8px 18px rgba(229, 63, 40, 0.14);
    }

    .home-link {
        display: block;
        margin-top: 21px;
        text-align: center;
        color: #777;
        font-size: 12px;
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .home-link:hover {
        color: #e53f28;
        transform: translateX(-2px);
    }

    .flash-message {
        position: fixed;
        top: 25px;
        right: 25px;
        z-index: 99999;
        min-width: 280px;
        max-width: 400px;
        padding: 15px 20px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        opacity: 0;
        transform: translateX(120%);
        transition: all 0.4s ease;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
    }

    .flash-message.show {
        opacity: 1;
        transform: translateX(0);
    }

    .flash-message.success {
        background: #22c55e;
        color: white;
    }

    .flash-message.error {
        background: #ef4444;
        color: white;
    }

    @media (max-width: 480px) {
        body {
            padding: 15px;
        }

        .auth-card {
            padding: 28px 22px;
            border-radius: 20px;
        }

        .brand h1 {
            font-size: 25px;
        }

        .brand p {
            font-size: 12px;
        }

        .flash-message {
            top: 15px;
            right: 15px;
            left: 15px;
            min-width: auto;
        }
    }
</style>
