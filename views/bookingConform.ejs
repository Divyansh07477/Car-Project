    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>


        /* =========================================================
           GET BOOKING ID
        ========================================================= */

        function extractBookingId() {

            const params =
                new URLSearchParams(window.location.search);

            const queryId =
                params.get("booking") ||
                params.get("id");

            if (queryId) {
                return queryId;
            }


            const pathParts =
                window.location.pathname
                    .split("/")
                    .filter(Boolean);


            const lastPart =
                pathParts[pathParts.length - 1];


            if (
                lastPart &&
                lastPart !== "booking-confirm" &&
                lastPart !== "bookingConform"
            ) {

                return lastPart;

            }


            return null;
        }



        const bookingId =
            extractBookingId();



        /* =========================================================
           DOM ELEMENTS
        ========================================================= */

        const loading =
            document.getElementById("loading");

        const errorBox =
            document.getElementById("errorBox");

        const content =
            document.getElementById("confirmationContent");



        /* =========================================================
           DATE FORMAT
        ========================================================= */

        function formatDate(dateString) {

            if (!dateString) {
                return "N/A";
            }


            const d =
                new Date(dateString);


            if (isNaN(d.getTime())) {
                return "N/A";
            }


            return d.toLocaleDateString(
                "en-IN",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                }
            );
        }



        /* =========================================================
           MONEY FORMAT
        ========================================================= */

        function formatMoney(value) {

            return Number(value || 0)
                .toLocaleString("en-IN");

        }



        /* =========================================================
           STATUS BADGE
        ========================================================= */

        function renderStatusBadge(status) {

            status =
                String(status || "pending")
                    .toLowerCase();


            const container =
                document.getElementById(
                    "statusBadgeContainer"
                );


            if (status === "confirmed") {

                container.innerHTML = `
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold"
                    >

                        <span
                            class="w-2 h-2 rounded-full bg-emerald-500"
                        ></span>

                        Confirmed

                    </span>
                `;

            }


            else if (
                status === "completed"
            ) {

                container.innerHTML = `
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold"
                    >

                        <span
                            class="w-2 h-2 rounded-full bg-blue-500"
                        ></span>

                        Completed

                    </span>
                `;

            }


            else if (
                status === "cancelled"
            ) {

                container.innerHTML = `
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 text-red-700 border border-red-200 text-xs font-bold"
                    >

                        <span
                            class="w-2 h-2 rounded-full bg-red-500"
                        ></span>

                        Cancelled

                    </span>
                `;

            }


            else {

                container.innerHTML = `
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold"
                    >

                        <span
                            class="w-2 h-2 rounded-full bg-amber-500"
                        ></span>

                        Pending

                    </span>
                `;

            }

        }



        /* =========================================================
           LOAD BOOKING
        ========================================================= */

        async function loadBooking() {


            if (!bookingId) {

                loading.classList.add("hidden");

                errorBox.classList.remove("hidden");

                return;
            }



            try {


                /* =================================================
                   API REQUEST
                ================================================= */

                const response =
                    await fetch(
                        `/api/bookings/${encodeURIComponent(bookingId)}`,
                        {
                            method: "GET",
                            credentials: "include"
                        }
                    );



                const data =
                    await response.json();



                if (
                    !response.ok ||
                    !data.success ||
                    !data.booking
                ) {

                    throw new Error(
                        data.message ||
                        "Booking not found"
                    );

                }



                const booking =
                    data.booking;


                const car =
                    booking.car ||
                    booking.vehicle ||
                    {};


                const user =
                    booking.user ||
                    {};



                /* =================================================
                   BOOKING ID
                ================================================= */

                document.getElementById(
                    "bookingId"
                ).textContent =
                    booking._id ||
                    bookingId;



                /* =================================================
                   STATUS
                ================================================= */

                renderStatusBadge(
                    booking.status
                );



                /* =================================================
                   CAR IMAGE
                ================================================= */

                let carImgUrl =
                    car.image ||
                    car.imageUrl ||
                    (
                        Array.isArray(car.images)
                            ? car.images[0]
                            : null
                    ) ||
                    "/images/car-placeholder.jpg";


                if (
                    typeof carImgUrl === "object" &&
                    carImgUrl !== null
                ) {

                    carImgUrl =
                        carImgUrl.url ||
                        "/images/car-placeholder.jpg";

                }


                document.getElementById(
                    "carImage"
                ).src =
                    carImgUrl;


                document.getElementById(
                    "carImage"
                ).alt =
                    car.name ||
                    "Booked Car";



                /* =================================================
                   CAR DETAILS
                ================================================= */

                document.getElementById(
                    "carName"
                ).textContent =
                    car.name ||
                    car.title ||
                    "Rental Car";


                document.getElementById(
                    "carCategory"
                ).textContent =
                    car.category ||
                    car.type ||
                    "Vehicle";


                document.getElementById(
                    "carTransmission"
                ).textContent =
                    car.transmission ||
                    "Automatic";


                document.getElementById(
                    "carSeats"
                ).textContent =
                    `${car.seats || 5} Seats`;



                /* =================================================
                   CUSTOMER DETAILS
                ================================================= */

                document.getElementById(
                    "customerName"
                ).textContent =
                    booking.name ||
                    user.name ||
                    "N/A";


                document.getElementById(
                    "customerPhone"
                ).textContent =
                    booking.phone ||
                    user.phone ||
                    "N/A";


                document.getElementById(
                    "customerEmail"
                ).textContent =
                    booking.email ||
                    user.email ||
                    "N/A";



                /* =================================================
                   RENTAL DAYS
                ================================================= */

                let days =
                    Number(
                        booking.totalDays
                    );


                if (
                    !days ||
                    days < 1
                ) {

                    const start =
                        new Date(
                            booking.startDate ||
                            booking.pickupDate
                        );


                    const end =
                        new Date(
                            booking.endDate ||
                            booking.returnDate
                        );


                    if (
                        !isNaN(start) &&
                        !isNaN(end)
                    ) {

                        const difference =
                            end.getTime() -
                            start.getTime();


                        days =
                            Math.ceil(
                                difference /
                                (1000 * 60 * 60 * 24)
                            );

                    }

                }


                if (
                    !days ||
                    days < 1
                ) {

                    days = 1;

                }



                document.getElementById(
                    "totalDays"
                ).textContent =
                    `${days} Day(s)`;


                document.getElementById(
                    "daysText"
                ).textContent =
                    days;



                /* =================================================
                   DATES
                ================================================= */

                document.getElementById(
                    "pickupDate"
                ).textContent =
                    formatDate(
                        booking.startDate ||
                        booking.pickupDate
                    );


                document.getElementById(
                    "returnDate"
                ).textContent =
                    formatDate(
                        booking.endDate ||
                        booking.returnDate
                    );



                /* =================================================
                   PICKUP LOCATION
                ================================================= */

                document.getElementById(
                    "pickupLocation"
                ).textContent =
                    booking.pickupLocation ||
                    booking.location ||
                    "Indore (Self-Pickup)";



                /* =========================================================
                   IMPORTANT PAYMENT CALCULATION
                   
                   BASE
                   GST = 18% OF BASE
                   SECURITY = ₹3000
                   TOTAL = BASE + GST + SECURITY
                ========================================================= */


                /* PRICE PER DAY */

                const pricePerDay =
                    Number(
                        booking.pricePerDay ||
                        car.pricePerDay ||
                        0
                    );



                /* =================================================
                   BASE AMOUNT
                ================================================= */

                let baseAmount =
                    Number(
                        booking.baseAmount
                    );


                if (
                    !baseAmount ||
                    baseAmount <= 0
                ) {

                    baseAmount =
                        pricePerDay *
                        days;

                }



                /* =================================================
                   GST 18%
                ================================================= */

                const gstRate =
                    18;


                let gstAmount =
                    Number(
                        booking.gstAmount
                    );


                /*
                    Agar backend se GST nahi aayi
                    to frontend khud calculate karega.
                */

                if (
                    !gstAmount ||
                    gstAmount <= 0
                ) {

                    gstAmount =
                        Math.round(
                            baseAmount *
                            gstRate /
                            100
                        );

                }



                /* =================================================
                   SECURITY DEPOSIT
                ================================================= */

                let securityDeposit =
                    Number(
                        booking.securityDeposit
                    );


                /*
                    Agar backend se security deposit nahi aayi
                    to ₹3000 default.
                */

                if (
                    !securityDeposit ||
                    securityDeposit < 0
                ) {

                    securityDeposit =
                        3000;

                }



                /* =================================================
                   TOTAL AMOUNT
                ================================================= */

                const calculatedTotal =
                    baseAmount +
                    gstAmount +
                    securityDeposit;



                /*
                    Backend total ko blindly use nahi kar rahe.
                    Frontend total hamesha:

                    BASE + GST + SECURITY
                */

                const totalAmount =
                    calculatedTotal;



                /* =================================================
                   DISPLAY PAYMENT
                ================================================= */

                document.getElementById(
                    "baseAmount"
                ).textContent =
                    formatMoney(
                        baseAmount
                    );


                document.getElementById(
                    "gstRate"
                ).textContent =
                    gstRate;


                document.getElementById(
                    "gstAmount"
                ).textContent =
                    formatMoney(
                        gstAmount
                    );


                document.getElementById(
                    "securityDeposit"
                ).textContent =
                    formatMoney(
                        securityDeposit
                    );


                document.getElementById(
                    "totalPrice"
                ).textContent =
                    formatMoney(
                        totalAmount
                    );



                /* =================================================
                   SAVE CALCULATED VALUES
                   So payment page can also access them if needed.
                ================================================= */

                window.bookingPaymentData = {

                    bookingId:
                        booking._id ||
                        bookingId,

                    baseAmount:
                        baseAmount,

                    gstRate:
                        gstRate,

                    gstAmount:
                        gstAmount,

                    securityDeposit:
                        securityDeposit,

                    totalAmount:
                        totalAmount,

                    days:
                        days,

                    pricePerDay:
                        pricePerDay

                };



                /* =================================================
                   PAYMENT STATUS
                ================================================= */

                const paymentStatus =
                    String(
                        booking.payment?.status ||
                        booking.paymentStatus ||
                        "pending"
                    ).toLowerCase();


                const isPaid =
                    [
                        "paid",
                        "success",
                        "completed"
                    ].includes(
                        paymentStatus
                    );



                const payBox =
                    document.getElementById(
                        "paymentStatusBox"
                    );


                const payText =
                    document.getElementById(
                        "paymentStatusText"
                    );


                const payIcon =
                    document.getElementById(
                        "paymentStatusIcon"
                    );


                const payPill =
                    document.getElementById(
                        "paymentStatusPill"
                    );


                const payBtn =
                    document.getElementById(
                        "payButton"
                    );



                /* =================================================
                   PAID
                ================================================= */

                if (isPaid) {

                    payBox.className =
                        "mt-6 p-4 rounded-xl flex items-center justify-between border bg-emerald-50 border-emerald-200 text-emerald-800";


                    payText.textContent =
                        "Payment Completed";


                    payIcon.className =
                        "bx bx-check-shield text-xl text-emerald-600";


                    payPill.className =
                        "text-xs font-bold px-3 py-1 rounded-full bg-emerald-200 text-emerald-900";


                    payPill.textContent =
                        "PAID";


                    payBtn.disabled =
                        true;


                    payBtn.className =
                        "w-full sm:w-auto px-10 py-3.5 rounded-xl bg-emerald-600 text-white font-bold text-base cursor-default flex items-center justify-center gap-2 opacity-90";


                    payBtn.innerHTML =
                        `
                        <i class="bx bx-check-circle text-xl"></i>
                        Already Paid
                        `;

                }


                /* =================================================
                   UNPAID
                ================================================= */

                else {

                    payBox.className =
                        "mt-6 p-4 rounded-xl flex items-center justify-between border bg-amber-50 border-amber-200 text-amber-800";


                    payText.textContent =
                        "Payment Pending";


                    payIcon.className =
                        "bx bx-time-five text-xl text-amber-600";


                    payPill.className =
                        "text-xs font-bold px-3 py-1 rounded-full bg-amber-200 text-amber-900";


                    payPill.textContent =
                        "UNPAID";

                }



                /* =================================================
                   SHOW CONTENT
                ================================================= */

                loading.classList.add(
                    "hidden"
                );


                content.classList.remove(
                    "hidden"
                );


            }


            catch (err) {

                console.error(
                    "Booking Load Error:",
                    err
                );


                loading.classList.add(
                    "hidden"
                );


                errorBox.classList.remove(
                    "hidden"
                );


                document.getElementById(
                    "errorMsg"
                ).textContent =
                    err.message ||
                    "Failed to load booking details.";

            }

        }



        /* =========================================================
           COPY BOOKING ID
        ========================================================= */

        document
            .getElementById("copyBookingId")
            .addEventListener(
                "click",
                async function () {

                    const id =
                        document.getElementById(
                            "bookingId"
                        ).textContent;


                    try {

                        await navigator
                            .clipboard
                            .writeText(id);


                        this.innerHTML =
                            `
                            <i class="bx bx-check text-emerald-500"></i>
                            `;


                        setTimeout(() => {

                            this.innerHTML =
                                `
                                <i class="bx bx-copy"></i>
                                `;

                        }, 2000);


                    }

                    catch (e) {

                        console.warn(
                            "Copy to clipboard failed",
                            e
                        );

                    }

                }
            );



        /* =========================================================
           PAYMENT REDIRECT
        ========================================================= */

        function initiatePayment() {

            if (!bookingId) {
                return;
            }


            window.location.href =
                `/payment?booking=${encodeURIComponent(bookingId)}`;

        }



        /* =========================================================
           INITIALIZE
        ========================================================= */

        loadBooking();

    </script>

</body>

</html>