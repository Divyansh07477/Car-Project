<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Bookings - RideWave</title>
 <link
        rel="stylesheet"
        href="/css/style.css"
    >
    <link
        rel="icon"
        type="image/png"
        href="/images/title.png.jpeg"
    >

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Boxicons -->
    <link
        href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
        rel="stylesheet"
    >

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            primary: "#f97316",
                            "primary-hover": "#ea580c"
                        }
                    }
                }
            }
        };
    </script>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f8fafc;
        }

        .booking-card {
            transition: all 0.25s ease;
        }

        .booking-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
        }

        .filter-btn {
            transition: all 0.2s ease;
        }

        .filter-btn.active {
            background: #f97316;
            color: white;
            border-color: #f97316;
            box-shadow: 0 4px 14px rgba(249, 115, 22, 0.25);
        }

        .filter-btn:not(.active):hover {
            background: #fff7ed;
            color: #ea580c;
            border-color: #fdba74;
        }

        .loading-spinner {
            width: 38px;
            height: 38px;
            border: 4px solid #fed7aa;
            border-top-color: #f97316;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* CAR IMAGE */

        .booking-car-image {
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
            padding: 8px;
            display: block;
        }

        /* CANCEL BUTTON */

        .cancel-booking-btn {
            transition: all 0.2s ease;
        }

        .cancel-booking-btn:hover {
            transform: translateY(-1px);
        }

        /* MODAL */

        #cancelModal {
            backdrop-filter: blur(4px);
        }

        .cancel-modal-box {
            animation: modalIn 0.2s ease;
        }

        @keyframes modalIn {

            from {
                opacity: 0;
                transform: scale(0.96) translateY(8px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }

        }

        /* NOTIFICATION DROPDOWN */

        .notification-dropdown {

            position: absolute;

            top: 50px;

            right: 0;

            width: 360px;

            max-height: 480px;

            background: white;

            border-radius: 16px;

            box-shadow:
                0 15px 40px rgba(0, 0, 0, 0.15);

            border: 1px solid #fed7aa;

            z-index: 100;

            overflow: hidden;

        }

        .notification-item {

            display: flex;

            gap: 12px;

            padding: 12px 16px;

            border-bottom: 1px solid #f3f4f6;

            cursor: pointer;

            transition: background 0.2s ease;

        }

        .notification-item:hover {
            background: #f9fafb;
        }

        .notification-item.unread {
            background: #fff7ed;
        }

        .notification-item.unread:hover {
            background: #ffedd5;
        }

        @media (max-width: 640px) {

            .notification-dropdown {

                position: fixed;

                top: 75px;

                left: 16px;

                right: 16px;

                width: auto;

                max-height: 70vh;

            }

        }

    </style>

</head>


