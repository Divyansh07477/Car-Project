    <!-- ================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ================================================= -->

    <script>

        let allBookingsData = [];

        let currentFilter = "all";

        let selectedBookingIdForCancel = null;


        // =================================================
        // ESCAPE HTML
        // =================================================

        function escapeHtml(value) {

            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }


        // =================================================
        // GET BOOKING STATUS
        // =================================================

        function getBookingStatus(booking) {

            return String(
                booking?.status || "pending"
            ).toLowerCase();

        }


        // =================================================
        // FORMAT DATE
        // =================================================

        function formatBookingDate(dateValue) {

            if (!dateValue) {
                return "N/A";
            }

            const date = new Date(dateValue);

            if (isNaN(date.getTime())) {
                return "N/A";
            }

            return date.toLocaleDateString(
                "en-IN",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                }
            );
        }


        // =================================================
        // FORMAT MONEY
        // =================================================

        function formatMoney(amount) {

            const number = Number(amount) || 0;

            return number.toLocaleString("en-IN");
        }


        // =================================================
        // STATUS BADGE
        // =================================================

        function getStatusBadge(status) {

            status = String(
                status || "pending"
            ).toLowerCase();


            if (status === "confirmed") {

                return `
                    <span
                        class="
                        inline-flex
                        items-center
                        gap-1.5
                        px-3
                        py-1.5
                        rounded-full
                        bg-emerald-50
                        text-emerald-700
                        border
                        border-emerald-200
                        text-xs
                        font-bold
                        "
                    >
                        <span
                            class="
                            w-1.5
                            h-1.5
                            rounded-full
                            bg-emerald-500
                            "
                        ></span>

                        Confirmed
                    </span>
                `;
            }


            if (status === "completed") {

                return `
                    <span
                        class="
                        inline-flex
                        items-center
                        gap-1.5
                        px-3
                        py-1.5
                        rounded-full
                        bg-blue-50
                        text-blue-700
                        border
                        border-blue-200
                        text-xs
                        font-bold
                        "
                    >
                        <span
                            class="
                            w-1.5
                            h-1.5
                            rounded-full
                            bg-blue-500
                            "
                        ></span>

                        Completed
                    </span>
                `;
            }


            if (status === "cancelled") {

                return `
                    <span
                        class="
                        inline-flex
                        items-center
                        gap-1.5
                        px-3
                        py-1.5
                        rounded-full
                        bg-red-50
                        text-red-700
                        border
                        border-red-200
                        text-xs
                        font-bold
                        "
                    >
                        <span
                            class="
                            w-1.5
                            h-1.5
                            rounded-full
                            bg-red-500
                            "
                        ></span>

                        Cancelled
                    </span>
                `;
            }


            return `
                <span
                    class="
                    inline-flex
                    items-center
                    gap-1.5
                    px-3
                    py-1.5
                    rounded-full
                    bg-amber-50
                    text-amber-700
                    border
                    border-amber-200
                    text-xs
                    font-bold
                    "
                >
                    <span
                        class="
                        w-1.5
                        h-1.5
                        rounded-full
                        bg-amber-500
                        "
                    ></span>

                    Pending
                </span>
            `;
        }


        // =================================================
        // PAYMENT STATUS
        // =================================================

        function getPaymentStatus(booking) {

            if (
                booking &&
                booking.payment &&
                booking.payment.status
            ) {

                return String(
                    booking.payment.status
                ).toLowerCase();

            }

            return "pending";
        }


        // =================================================
        // CHECK PAID
        // =================================================

        function isBookingPaid(booking) {

            const paymentStatus =
                getPaymentStatus(booking);

            return [
                "paid",
                "success",
                "completed"
            ].includes(paymentStatus);
        }


        // =================================================
        // CHECK REFUNDED
        // =================================================

        function isBookingRefunded(booking) {

            const paymentStatus =
                getPaymentStatus(booking);

            const status =
                getBookingStatus(booking);


            /*
             * Direct refund status
             */

            if (
                paymentStatus === "refunded" ||
                paymentStatus === "refund" ||
                paymentStatus === "refunded_success"
            ) {

                return true;
            }


            /*
             * IMPORTANT:
             *
             * Owner cancelled a PAID booking.
             *
             * If backend still sends payment.status = paid,
             * cancelled + paid means refunded from
             * user-side perspective.
             */

            if (
                status === "cancelled" &&
                isBookingPaid(booking)
            ) {

                return true;
            }


            return false;
        }


        // =================================================
        // USER CAN CANCEL
        // =================================================

        function canUserCancelBooking(booking) {

            if (!booking) {
                return false;
            }

            const status =
                getBookingStatus(booking);


            /*
             * PAID BOOKING:
             *
             * User cannot cancel.
             */

            if (isBookingPaid(booking)) {
                return false;
            }


            /*
             * REFUNDED BOOKING:
             *
             * Already cancelled/refunded.
             */

            if (isBookingRefunded(booking)) {
                return false;
            }


            /*
             * Already cancelled/completed.
             */

            if (
                status === "cancelled" ||
                status === "completed"
            ) {

                return false;
            }


            /*
             * ONLY pending and confirmed
             * unpaid bookings can be cancelled.
             */

            return (
                status === "pending" ||
                status === "confirmed"
            );
        }


        // =================================================
        // REFUNDED PAYMENT UI
        // =================================================

        function refundedPaymentHtml() {

            return `
                <div
                    class="
                    mt-6
                    pt-6
                    border-t
                    border-slate-200
                    flex
                    flex-col
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                    gap-4
                    "
                >

                    <div>

                        <p
                            class="
                            text-[10px]
                            font-bold
                            uppercase
                            tracking-wider
                            text-slate-400
                            "
                        >
                            Payment Status
                        </p>

                        <div
                            class="
                            mt-1
                            flex
                            items-center
                            gap-2
                            "
                        >

                            <span
                                class="
                                flex
                                items-center
                                justify-center
                                w-6
                                h-6
                                rounded-full
                                bg-emerald-100
                                text-emerald-600
                                font-bold
                                "
                            >
                                ✓
                            </span>

                            <p
                                class="
                                text-sm
                                font-bold
                                text-emerald-600
                                "
                            >
                                Payment Refunded
                            </p>

                        </div>

                    </div>


                    <div
                        class="
                        inline-flex
                        items-center
                        justify-center
                        gap-2
                        px-6
                        py-2.5
                        rounded-xl
                        bg-emerald-50
                        border
                        border-emerald-200
                        text-emerald-700
                        text-sm
                        font-bold
                        transition-all
                        hover:bg-emerald-100
                        hover:border-emerald-300
                        hover:text-emerald-800
                        hover:-translate-y-0.5
                        "
                    >
                        <span>✓</span>

                        Refunded
                    </div>

                </div>
            `;
        }


        // =================================================
        // PAID PAYMENT UI
        // =================================================

        function paidPaymentHtml() {

            return `
                <div
                    class="
                    mt-6
                    pt-6
                    border-t
                    border-slate-200
                    flex
                    flex-col
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                    gap-4
                    "
                >

                    <div>

                        <p
                            class="
                            text-[10px]
                            font-bold
                            uppercase
                            tracking-wider
                            text-slate-400
                            "
                        >
                            Payment Status
                        </p>

                        <div
                            class="
                            mt-1
                            flex
                            items-center
                            gap-2
                            "
                        >

                            <span
                                class="
                                flex
                                items-center
                                justify-center
                                w-6
                                h-6
                                rounded-full
                                bg-emerald-100
                                text-emerald-600
                                font-bold
                                "
                            >
                                ✓
                            </span>

                            <p
                                class="
                                text-sm
                                font-bold
                                text-emerald-600
                                "
                            >
                                Payment Completed
                            </p>

                        </div>

                    </div>


                    <div
                        class="
                        inline-flex
                        items-center
                        justify-center
                        gap-2
                        px-6
                        py-2.5
                        rounded-xl
                        bg-emerald-50
                        border
                        border-emerald-200
                        text-emerald-700
                        text-sm
                        font-bold
                        "
                    >
                        <span>✓</span>

                        Paid
                    </div>

                </div>
            `;
        }


        // =================================================
        // CANCEL BUTTON HTML
        // =================================================

        function cancelButtonHtml(
            bookingId,
            text = "Cancel Booking"
        ) {

            return `
                <button
                    type="button"
                    class="
                    cancel-booking-btn
                    inline-flex
                    items-center
                    justify-center
                    gap-2
                    px-5
                    py-3
                    rounded-xl
                    bg-red-50
                    border
                    border-red-200
                    text-red-600
                    text-sm
                    font-bold
                    hover:bg-red-100
                    hover:border-red-300
                    hover:text-red-700
                    "
                    data-cancel-id="${escapeHtml(bookingId)}"
                >

                    <i class="bx bx-x text-lg"></i>

                    ${escapeHtml(text)}

                </button>
            `;
        }


        // =================================================
        // PAYMENT SECTION
        // =================================================

        function renderPaymentSection(
            booking,
            status,
            bookingId
        ) {

            const paid =
                isBookingPaid(booking);

            const refunded =
                isBookingRefunded(booking);


            // ---------------------------------------------
            // CANCELLED
            // ---------------------------------------------

            if (status === "cancelled") {

                if (refunded) {
                    return refundedPaymentHtml();
                }


                return `
                    <div
                        class="
                        mt-6
                        pt-6
                        border-t
                        border-slate-200
                        "
                    >

                        <p
                            class="
                            text-[10px]
                            font-bold
                            uppercase
                            tracking-wider
                            text-slate-400
                            "
                        >
                            Booking Status
                        </p>

                        <p
                            class="
                            mt-1
                            text-sm
                            font-bold
                            text-red-600
                            "
                        >
                            Booking Cancelled
                        </p>

                    </div>
                `;
            }


            // ---------------------------------------------
            // COMPLETED
            // ---------------------------------------------

            if (status === "completed") {

                return `
                    <div
                        class="
                        mt-6
                        pt-6
                        border-t
                        border-slate-200
                        "
                    >

                        <p
                            class="
                            text-[10px]
                            font-bold
                            uppercase
                            tracking-wider
                            text-slate-400
                            "
                        >
                            Booking Status
                        </p>

                        <p
                            class="
                            mt-1
                            text-sm
                            font-bold
                            text-blue-600
                            "
                        >
                            Rental Completed
                        </p>

                    </div>
                `;
            }


            // ---------------------------------------------
            // CONFIRMED
            // ---------------------------------------------

            if (status === "confirmed") {

                /*
                 * CONFIRMED + PAID
                 *
                 * No cancel button.
                 */

                if (paid) {

                    return paidPaymentHtml();
                }


                /*
                 * CONFIRMED + UNPAID
                 *
                 * Pay Now + Cancel
                 */

                return `
                    <div
                        class="
                        mt-6
                        pt-6
                        border-t
                        border-slate-200
                        flex
                        flex-col
                        sm:flex-row
                        sm:items-center
                        sm:justify-between
                        gap-4
                        "
                    >

                        <div>

                            <p
                                class="
                                text-[10px]
                                font-bold
                                uppercase
                                tracking-wider
                                text-slate-400
                                "
                            >
                                Payment Status
                            </p>

                            <p
                                class="
                                mt-1
                                text-sm
                                font-bold
                                text-amber-600
                                "
                            >
                                Payment Pending
                            </p>

                        </div>


                        <div
                            class="
                            flex
                            flex-wrap
                            items-center
                            gap-3
                            "
                        >

                            <a
                                href="/payment?booking=${encodeURIComponent(bookingId)}"
                                class="
                                inline-flex
                                items-center
                                justify-center
                                gap-2
                                px-6
                                py-3
                                rounded-xl
                                bg-blue-600
                                text-white
                                text-sm
                                font-bold
                                shadow-sm
                                hover:bg-blue-700
                                hover:-translate-y-0.5
                                transition-all
                                "
                            >

                                Pay Now

                                <i class="bx bx-right-arrow-alt text-lg"></i>

                            </a>


                            ${
                                canUserCancelBooking(booking)
                                    ? cancelButtonHtml(
                                        bookingId,
                                        "Cancel"
                                    )
                                    : ""
                            }

                        </div>

                    </div>
                `;
            }


            // ---------------------------------------------
            // PENDING
            // ---------------------------------------------

            if (status === "pending") {

                return `
                    <div
                        class="
                        mt-6
                        pt-6
                        border-t
                        border-slate-200
                        flex
                        flex-col
                        sm:flex-row
                        sm:items-center
                        sm:justify-between
                        gap-4
                        "
                    >

                        <div>

                            <p
                                class="
                                text-[10px]
                                font-bold
                                uppercase
                                tracking-wider
                                text-slate-400
                                "
                            >
                                Booking Status
                            </p>

                            <p
                                class="
                                mt-1
                                text-sm
                                font-bold
                                text-amber-600
                                "
                            >
                                Waiting for owner confirmation
                            </p>

                        </div>


                        ${
                            canUserCancelBooking(booking)
                                ? cancelButtonHtml(
                                    bookingId,
                                    "Cancel Booking"
                                )
                                : ""
                        }

                    </div>
                `;
            }


            return "";
        }


        // =================================================
        // RENDER BOOKINGS
        // =================================================

        function renderBookings() {

            const container =
                document.getElementById(
                    "bookingsContainer"
                );

            const emptyState =
                document.getElementById(
                    "emptyState"
                );

            const emptyMessage =
                document.getElementById(
                    "emptyMessage"
                );


            let filteredBookings =
                allBookingsData;


            // FILTER

            if (currentFilter !== "all") {

                filteredBookings =
                    allBookingsData.filter(
                        booking => {

                            const status =
                                getBookingStatus(
                                    booking
                                );

                            return (
                                status ===
                                currentFilter
                            );
                        }
                    );
            }


            // EMPTY

            if (
                !filteredBookings ||
                filteredBookings.length === 0
            ) {

                container.innerHTML = "";

                container.classList.add("hidden");

                emptyState.classList.remove("hidden");


                if (
                    allBookingsData.length > 0 &&
                    currentFilter !== "all"
                ) {

                    emptyMessage.textContent =
                        `No ${currentFilter} bookings found.`;

                } else {

                    emptyMessage.textContent =
                        "You haven't made any bookings yet.";
                }

                return;
            }


            emptyState.classList.add("hidden");

            container.classList.remove("hidden");


            // CREATE CARDS

            container.innerHTML =
                filteredBookings
                    .map(booking => {

                        const status =
                            getBookingStatus(
                                booking
                            );


                        const car =
                            booking.car || {};


                        const carName =
                            car.name ||
                            "Rental Car";


                        const carImage =
                            car.image ||
                            car.imageUrl ||
                            "/images/car-placeholder.jpg";


                        const category =
                            car.category ||
                            car.type ||
                            "Car";


                        const transmission =
                            car.transmission ||
                            "Automatic";


                        const bookingId =
                            booking._id ||
                            booking.id ||
                            "";


                        const totalAmount =
                            Number(
                                booking.totalAmount
                            ) || 0;


                        const pricePerDay =
                            Number(
                                booking.pricePerDay
                            ) || 0;


                        const note =
                            booking.note ||
                            "";


                        return `

                            <div
                                class="
                                booking-card
                                bg-white
                                rounded-2xl
                                border
                                border-slate-200
                                overflow-hidden
                                "
                            >

                                <!-- TOP CAR SECTION -->

                                <div class="p-5 md:p-6">

                                    <div
                                        class="
                                        flex
                                        flex-col
                                        lg:flex-row
                                        gap-6
                                        "
                                    >

                                        <!-- CAR IMAGE -->

                                        <div
                                            class="
                                            w-full
                                            lg:w-64
                                            h-44
                                            rounded-xl
                                            overflow-hidden
                                            bg-slate-100
                                            flex-shrink-0
                                            flex
                                            items-center
                                            justify-center
                                            "
                                        >

                                            <img
                                                src="${escapeHtml(carImage)}"
                                                alt="${escapeHtml(carName)}"
                                                class="booking-car-image"
                                                onerror="
                                                    this.onerror=null;
                                                    this.src='/images/car-placeholder.jpg';
                                                "
                                            >

                                        </div>


                                        <!-- CAR DETAILS -->

                                        <div class="flex-1">

                                            <div
                                                class="
                                                flex
                                                flex-col
                                                sm:flex-row
                                                sm:items-start
                                                sm:justify-between
                                                gap-3
                                                "
                                            >

                                                <div>

                                                    <p
                                                        class="
                                                        text-xs
                                                        font-bold
                                                        uppercase
                                                        tracking-wider
                                                        text-blue-600
                                                        "
                                                    >
                                                        ${escapeHtml(category)}
                                                    </p>


                                                    <h2
                                                        class="
                                                        mt-1
                                                        text-2xl
                                                        font-extrabold
                                                        text-slate-900
                                                        "
                                                    >
                                                        ${escapeHtml(carName)}
                                                    </h2>

                                                </div>


                                                <div>
                                                    ${getStatusBadge(status)}
                                                </div>

                                            </div>


                                            <!-- CAR META -->

                                            <div
                                                class="
                                                flex
                                                flex-wrap
                                                gap-4
                                                mt-5
                                                "
                                            >

                                                <div
                                                    class="
                                                    inline-flex
                                                    items-center
                                                    gap-2
                                                    text-sm
                                                    text-slate-500
                                                    "
                                                >

                                                    <i
                                                        class="
                                                        bx
                                                        bx-cog
                                                        text-lg
                                                        text-blue-500
                                                        "
                                                    ></i>

                                                    ${escapeHtml(transmission)}

                                                </div>


                                                ${
                                                    car.seats
                                                        ? `
                                                            <div
                                                                class="
                                                                inline-flex
                                                                items-center
                                                                gap-2
                                                                text-sm
                                                                text-slate-500
                                                                "
                                                            >

                                                                <i
                                                                    class="
                                                                    bx
                                                                    bx-user
                                                                    text-lg
                                                                    text-blue-500
                                                                    "
                                                                ></i>

                                                                ${escapeHtml(car.seats)}
                                                                Seats

                                                            </div>
                                                        `
                                                        : ""
                                                }

                                            </div>


                                            <!-- BOOKING ID -->

                                            <div
                                                class="
                                                mt-5
                                                inline-flex
                                                items-center
                                                gap-2
                                                px-3
                                                py-2
                                                rounded-lg
                                                bg-slate-50
                                                border
                                                border-slate-200
                                                "
                                            >

                                                <span
                                                    class="
                                                    text-xs
                                                    font-bold
                                                    text-slate-400
                                                    "
                                                >
                                                    BOOKING ID
                                                </span>


                                                <span
                                                    class="
                                                    text-xs
                                                    font-bold
                                                    text-slate-700
                                                    break-all
                                                    "
                                                >
                                                    ${escapeHtml(bookingId)}
                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- BOOKING INFORMATION -->

                                <div
                                    class="
                                    border-t
                                    border-slate-200
                                    p-5
                                    md:p-6
                                    "
                                >

                                    <div
                                        class="
                                        grid
                                        grid-cols-1
                                        md:grid-cols-2
                                        lg:grid-cols-4
                                        gap-5
                                        "
                                    >

                                        <!-- START DATE -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Pickup Date
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                font-bold
                                                text-slate-800
                                                "
                                            >
                                                ${formatBookingDate(
                                                    booking.startDate
                                                )}
                                            </p>

                                        </div>


                                        <!-- END DATE -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Return Date
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                font-bold
                                                text-slate-800
                                                "
                                            >
                                                ${formatBookingDate(
                                                    booking.endDate
                                                )}
                                            </p>

                                        </div>


                                        <!-- PICKUP -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Pickup Location
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                font-bold
                                                text-slate-800
                                                "
                                            >
                                                ${escapeHtml(
                                                    booking.pickupLocation ||
                                                    "N/A"
                                                )}
                                            </p>

                                        </div>


                                        <!-- DAYS -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Rental Duration
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                font-bold
                                                text-slate-800
                                                "
                                            >
                                                ${escapeHtml(
                                                    booking.totalDays || 1
                                                )}
                                                Day(s)
                                            </p>

                                        </div>

                                    </div>


                                    <!-- CUSTOMER / PHONE / PRICE -->

                                    <div
                                        class="
                                        grid
                                        grid-cols-1
                                        md:grid-cols-2
                                        lg:grid-cols-4
                                        gap-5
                                        mt-6
                                        pt-6
                                        border-t
                                        border-slate-100
                                        "
                                    >

                                        <!-- CUSTOMER -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Customer
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                font-bold
                                                text-slate-800
                                                "
                                            >
                                                ${escapeHtml(
                                                    booking.name ||
                                                    "N/A"
                                                )}
                                            </p>

                                        </div>


                                        <!-- PHONE -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Phone
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                font-bold
                                                text-slate-800
                                                "
                                            >
                                                ${escapeHtml(
                                                    booking.phone ||
                                                    "N/A"
                                                )}
                                            </p>

                                        </div>


                                        <!-- PRICE -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Price / Day
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                font-bold
                                                text-slate-800
                                                "
                                            >
                                                ₹${formatMoney(
                                                    pricePerDay
                                                )}
                                            </p>

                                        </div>


                                        <!-- TOTAL -->

                                        <div>

                                            <p
                                                class="
                                                text-[10px]
                                                font-bold
                                                uppercase
                                                tracking-wider
                                                text-slate-400
                                                "
                                            >
                                                Total Amount
                                            </p>

                                            <p
                                                class="
                                                mt-1
                                                text-lg
                                                font-extrabold
                                                text-slate-900
                                                "
                                            >
                                                ₹${formatMoney(
                                                    totalAmount
                                                )}
                                            </p>

                                        </div>

                                    </div>


                                    <!-- EMAIL -->

                                    <div
                                        class="
                                        mt-6
                                        pt-6
                                        border-t
                                        border-slate-100
                                        "
                                    >

                                        <p
                                            class="
                                            text-[10px]
                                            font-bold
                                            uppercase
                                            tracking-wider
                                            text-slate-400
                                            "
                                        >
                                            Email
                                        </p>

                                        <p
                                            class="
                                            mt-1
                                            text-sm
                                            font-semibold
                                            text-slate-700
                                            break-all
                                            "
                                        >
                                            ${escapeHtml(
                                                booking.email ||
                                                "N/A"
                                            )}
                                        </p>

                                    </div>


                                    <!-- NOTE -->

                                    ${
                                        note
                                            ? `
                                                <div
                                                    class="
                                                    mt-6
                                                    p-4
                                                    rounded-xl
                                                    bg-blue-50
                                                    border
                                                    border-blue-100
                                                    "
                                                >

                                                    <div
                                                        class="
                                                        flex
                                                        items-start
                                                        gap-3
                                                        "
                                                    >

                                                        <i
                                                            class="
                                                            bx
                                                            bx-message-detail
                                                            text-xl
                                                            text-blue-600
                                                            "
                                                        ></i>


                                                        <div>

                                                            <p
                                                                class="
                                                                text-xs
                                                                font-bold
                                                                uppercase
                                                                tracking-wider
                                                                text-blue-500
                                                                "
                                                            >
                                                                Note
                                                            </p>


                                                            <p
                                                                class="
                                                                mt-1
                                                                text-sm
                                                                text-slate-700
                                                                "
                                                            >
                                                                ${escapeHtml(note)}
                                                            </p>

                                                        </div>

                                                    </div>

                                                </div>
                                            `
                                            : ""
                                    }


                                    <!-- PAYMENT / CANCEL -->

                                    ${renderPaymentSection(
                                        booking,
                                        status,
                                        bookingId
                                    )}

                                </div>

                            </div>

                        `;

                    })
                    .join("");


            // =================================================
            // CANCEL BUTTON EVENTS
            // =================================================

            document
                .querySelectorAll("[data-cancel-id]")
                .forEach(button => {

                    button.addEventListener(
                        "click",
                        () => {

                            const bookingId =
                                button.dataset.cancelId;


                            const booking =
                                allBookingsData.find(
                                    item =>
                                        String(
                                            item._id ||
                                            item.id
                                        ) ===
                                        String(bookingId)
                                );


                            /*
                             * Extra frontend safety:
                             * stale/paid booking par modal
                             * open hi nahi hoga.
                             */

                            if (
                                !booking ||
                                !canUserCancelBooking(
                                    booking
                                )
                            ) {

                                alert(
                                    "This booking cannot be cancelled now."
                                );

                                return;
                            }


                            openCancelModal(
                                bookingId
                            );

                        }
                    );

                });
        }


        // =================================================
        // FILTER BUTTONS
        // =================================================

        document
            .querySelectorAll(".filter-btn")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    () => {

                        document
                            .querySelectorAll(
                                ".filter-btn"
                            )
                            .forEach(btn => {

                                btn.classList.remove(
                                    "active"
                                );

                            });


                        button.classList.add(
                            "active"
                        );


                        currentFilter =
                            button.dataset.filter ||
                            "all";


                        renderBookings();

                    }
                );

            });


        // =================================================
        // LOAD PROFILE
        // =================================================

        async function loadProfile() {

            try {

                const response =
                    await fetch(
                        "/api/auth/me",
                        {
                            credentials: "include"
                        }
                    );


                if (!response.ok) {
                    return;
                }


                const data =
                    await response.json();


                const user =
                    data.user ||
                    data;


                if (!user) {
                    return;
                }


                document.getElementById(
                    "profileName"
                ).textContent =
                    user.name ||
                    user.username ||
                    "Welcome";


                document.getElementById(
                    "profileEmail"
                ).textContent =
                    user.email ||
                    "";

            } catch (error) {

                console.log(
                    "Profile load error:",
                    error.message
                );

            }
        }


        // =================================================
        // LOAD BOOKINGS
        // =================================================

        async function loadBookings() {

            const loadingState =
                document.getElementById(
                    "loadingState"
                );

            const errorState =
                document.getElementById(
                    "errorState"
                );

            const errorMessage =
                document.getElementById(
                    "errorMessage"
                );


            loadingState.classList.remove(
                "hidden"
            );

            errorState.classList.add(
                "hidden"
            );


            try {

                const response =
                    await fetch(
                        "/api/bookings/my-bookings",
                        {
                            method: "GET",

                            credentials: "include",

                            headers: {
                                "Accept":
                                    "application/json"
                            }
                        }
                    );


                if (!response.ok) {

                    if (
                        response.status === 401
                    ) {

                        window.location.href =
                            "/login";

                        return;
                    }


                    throw new Error(
                        "Unable to fetch bookings."
                    );
                }


                const bookData =
                    await response.json();


                allBookingsData =
                    Array.isArray(
                        bookData.bookings
                    )
                        ? bookData.bookings
                        : [];


                loadingState.classList.add(
                    "hidden"
                );


                renderBookings();

            } catch (error) {

                console.error(
                    "Booking load error:",
                    error
                );


                loadingState.classList.add(
                    "hidden"
                );


                errorState.classList.remove(
                    "hidden"
                );


                errorMessage.textContent =
                    error.message ||
                    "Something went wrong while loading bookings.";
            }
        }


        // =================================================
        // OPEN CANCEL MODAL
        // =================================================

        function openCancelModal(bookingId) {

            const booking =
                allBookingsData.find(
                    item =>
                        String(
                            item._id ||
                            item.id
                        ) ===
                        String(bookingId)
                );


            /*
             * Never open modal for paid/cancelled/completed
             * booking.
             */

            if (
                !booking ||
                !canUserCancelBooking(booking)
            ) {

                return;
            }


            selectedBookingIdForCancel =
                bookingId;


            const modal =
                document.getElementById(
                    "cancelModal"
                );


            modal.classList.remove(
                "hidden"
            );
        }


        // =================================================
        // CLOSE CANCEL MODAL
        // =================================================

        function closeCancelModal() {

            selectedBookingIdForCancel =
                null;


            const modal =
                document.getElementById(
                    "cancelModal"
                );


            modal.classList.add(
                "hidden"
            );
        }


        document
            .getElementById(
                "closeCancelModal"
            )
            .addEventListener(
                "click",
                closeCancelModal
            );


        // =================================================
        // CLICK OUTSIDE MODAL
        // =================================================

        document
            .getElementById(
                "cancelModal"
            )
            .addEventListener(
                "click",
                event => {

                    if (
                        event.target.id ===
                        "cancelModal"
                    ) {

                        closeCancelModal();
                    }
                }
            );


        // =================================================
        // ESC KEY CLOSE MODAL
        // =================================================

        document.addEventListener(
            "keydown",
            event => {

                if (
                    event.key === "Escape"
                ) {

                    closeCancelModal();
                }
            }
        );


        // =================================================
        // USER CANCEL BOOKING
        // =================================================

        async function cancelBooking() {

            if (
                !selectedBookingIdForCancel
            ) {

                return;
            }


            const bookingId =
                selectedBookingIdForCancel;


            const booking =
                allBookingsData.find(
                    item =>
                        String(
                            item._id ||
                            item.id
                        ) ===
                        String(bookingId)
                );


            /*
             * FRONTEND SAFETY CHECK
             */

            if (!booking) {

                alert(
                    "Booking not found."
                );

                closeCancelModal();

                return;
            }


            /*
             * IMPORTANT:
             *
             * Paid booking cannot be cancelled.
             */

            if (
                !canUserCancelBooking(
                    booking
                )
            ) {

                alert(
                    "This booking cannot be cancelled now."
                );

                closeCancelModal();

                return;
            }


            const button =
                document.getElementById(
                    "confirmCancelBtn"
                );


            button.disabled = true;


            button.innerHTML = `
                <i
                    class="
                    bx
                    bx-loader-alt
                    bx-spin
                    text-lg
                    "
                ></i>

                Cancelling...
            `;


            try {

                /*
                 * USER CANCEL ENDPOINT
                 *
                 * POST /api/bookings/:id/cancel
                 */

                const response =
                    await fetch(`/api/bookings/${bookingId}/customer-cancel`, {
                            method: "POST",

                            credentials: "include",

                            headers: {
                                "Content-Type":
                                    "application/json",

                                "Accept":
                                    "application/json"
                            },

                            body: JSON.stringify({

                                cancelledBy: "user",

                                note: "User Cancelled",

                                reason: "User Cancelled"

                            })
                        }
                    );


                const data =
                    await response
                        .json()
                        .catch(
                            () => ({})
                        );


                if (!response.ok) {

                    throw new Error(
                        data.message ||
                        "Unable to cancel booking."
                    );
                }


                /*
                 * Close modal
                 */

                closeCancelModal();


                /*
                 * Reload latest DB data.
                 */

                await loadBookings();


            } catch (error) {

                console.error(
                    "Cancel booking error:",
                    error
                );


                alert(
                    error.message ||
                    "Unable to cancel booking."
                );

            } finally {

                button.disabled = false;

                button.innerHTML =
                    "Yes, Cancel";
            }
        }


        document
            .getElementById(
                "confirmCancelBtn"
            )
            .addEventListener(
                "click",
                cancelBooking
            );


        // =================================================
        // RETRY
        // =================================================

        document
            .getElementById("retryBtn")
            .addEventListener(
                "click",
                loadBookings
            );


        // =================================================
        // LOGOUT
        // =================================================

        async function handleLogout() {

            try {

                const response =
                    await fetch(
                        "/api/auth/logout",
                        {
                            method: "POST",
                            credentials: "include"
                        }
                    );


                if (
                    response.ok ||
                    response.redirected
                ) {

                    window.location.href =
                        "/login";

                    return;
                }


                window.location.href =
                    "/login";


            } catch (error) {

                console.error(
                    "Logout error:",
                    error
                );


                window.location.href =
                    "/login";
            }
        }


        document
            .getElementById("logoutBtn")
            .addEventListener(
                "click",
                handleLogout
            );


        // =================================================
        // NOTIFICATION
        // =================================================

        document
            .getElementById("notificationBtn")
            .addEventListener(
                "click",
                () => {

                    window.location.href =
                        "/notifications";

                }
            );


        // =================================================
        // INIT
        // =================================================

        async function initPage() {

            await loadProfile();

            await loadBookings();

        }


        initPage();

    </script>

</body>

</html>