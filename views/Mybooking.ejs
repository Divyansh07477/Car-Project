                            button.dataset.filter ||
                            "all";


                        renderBookings();

                    }
                );

            });


        /* =====================================================
           LOAD PROFILE
        ===================================================== */

        async function loadProfile() {

            try {

                const response =
                    await fetch(
                        "/api/auth/me",
                        {
                            credentials:
                                "include"
                        }
                    );


                if (!response.ok) {
                    return;
                }


                const data =
                    await response.json();


                const user =
                    data.user || data;


                if (!user) {
                    return;
                }


                const name =
                    user.name ||
                    user.username ||
                    "Welcome";


                document
                    .getElementById(
                        "profileName"
                    )
                    .textContent = name;


                document
                    .getElementById(
                        "navUserName"
                    )
                    .textContent = name;


                document
                    .getElementById(
                        "profileEmail"
                    )
                    .textContent =
                        user.email || "";


                document
                    .getElementById(
                        "dropdownUserEmail"
                    )
                    .textContent =
                        user.email || "";

            } catch (error) {

                console.log(
                    "Profile load error:",
                    error.message
                );

            }

        }


        /* =====================================================
           LOAD BOOKINGS
        ===================================================== */

        async function loadBookings() {

            const loadingState =
                document.getElementById(
                    "loadingState"
                );

            const errorState =
                document.getElementById(
                    "errorState"
                );

            const errorMessage =
                document.getElementById(
                    "errorMessage"
                );


            loadingState.classList.remove(
                "hidden"
            );

            errorState.classList.add(
                "hidden"
            );


            try {

                const response =
                    await fetch(
                        "/api/bookings/my-bookings",
                        {
                            method: "GET",
                            credentials: "include",
                            headers: {
                                "Accept":
                                    "application/json"
                            }
                        }
                    );


                if (!response.ok) {

                    if (
                        response.status === 401
                    ) {

                        window.location.href =
                            "/login";

                        return;

                    }


                    throw new Error(
                        "Unable to fetch bookings."
                    );

                }


                const bookData =
                    await response.json();


                allBookingsData =
                    Array.isArray(
                        bookData.bookings
                    )
                        ? bookData.bookings
                        : [];


                loadingState.classList.add(
                    "hidden"
                );


                renderBookings();

            } catch (error) {

                loadingState.classList.add(
                    "hidden"
                );

                errorState.classList.remove(
                    "hidden"
                );

                errorMessage.textContent =
                    error.message ||
                    "Failed to load bookings.";

            }

        }


        /* =====================================================
           MODAL
        ===================================================== */

        function openCancelModal(
            bookingId
        ) {

            selectedBookingIdForCancel =
                bookingId;


            document
                .getElementById(
                    "cancelModal"
                )
                .classList.remove(
                    "hidden"
                );

        }


        function closeCancelModal() {

            selectedBookingIdForCancel =
                null;


            document
                .getElementById(
                    "cancelModal"
                )
                .classList.add(
                    "hidden"
                );

        }


        document
            .getElementById(
                "closeCancelModal"
            )
            .addEventListener(
                "click",
                closeCancelModal
            );


        document
            .getElementById(
                "cancelModal"
            )
            .addEventListener(
                "click",
                e => {

                    if (
                        e.target.id ===
                        "cancelModal"
                    ) {

                        closeCancelModal();

                    }

                }
            );


        document.addEventListener(
            "keydown",
            e => {

                if (
                    e.key === "Escape"
                ) {

                    closeCancelModal();

                }

            }
        );


        /* =====================================================
           CANCEL BOOKING
        ===================================================== */

        async function cancelBooking() {

            if (
                !selectedBookingIdForCancel
            ) {
                return;
            }


            const bookingId =
                selectedBookingIdForCancel;


            const btn =
                document.getElementById(
                    "confirmCancelBtn"
                );


            btn.disabled = true;


            btn.innerHTML =
                `
                    <i class="bx bx-loader-alt bx-spin mr-1"></i>
                    Cancelling...
                `;


            try {

                const response =
                    await fetch(
                        `/api/bookings/${encodeURIComponent(bookingId)}/customer-cancel`,
                        {
                            method: "POST",
                            credentials: "include",
                            headers: {
                                "Content-Type":
                                    "application/json",
                                "Accept":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                cancelledBy:
                                    "user",
                                note:
                                    "User Cancelled",
                                reason:
                                    "User Cancelled"
                            })
                        }
                    );


                const data =
                    await response
                        .json()
                        .catch(
                            () => ({})
                        );


                if (!response.ok) {

                    throw new Error(
                        data.message ||
                        "Unable to cancel booking."
                    );

                }


                closeCancelModal();


                await loadBookings();

            } catch (err) {

                alert(
                    err.message ||
                    "Something went wrong."
                );

            } finally {

                btn.disabled = false;

                btn.innerHTML =
                    "Yes, Cancel";

            }

        }


        document
            .getElementById(
                "confirmCancelBtn"
            )
            .addEventListener(
                "click",
                cancelBooking
            );


        document
            .getElementById(
                "retryBtn"
            )
            .addEventListener(
                "click",
                loadBookings
            );


