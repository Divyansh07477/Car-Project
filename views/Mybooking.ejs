    <script>

        let allBookingsData = [];

        let currentFilter = "all";

        let selectedBookingIdForCancel = null;


        /* =====================================================
           HTML ESCAPE
        ===================================================== */

        function escapeHtml(value) {

            if (
                value === null ||
                value === undefined
            ) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        /* =====================================================
           BOOKING STATUS
        ===================================================== */

        function getBookingStatus(booking) {

            return String(
                booking?.status || "pending"
            ).toLowerCase();

        }


        /* =====================================================
           DATE FORMAT
        ===================================================== */

        function formatBookingDate(dateValue) {

            if (!dateValue) {
                return "N/A";
            }

            const date = new Date(dateValue);

            if (isNaN(date.getTime())) {
                return "N/A";
            }

            return date.toLocaleDateString(
                "en-IN",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                }
            );

        }


        /* =====================================================
           MONEY FORMAT
        ===================================================== */

        function formatMoney(amount) {

            const number =
                Number(amount) || 0;

            return number.toLocaleString("en-IN");

        }


        /* =====================================================
           PAYMENT STATUS
        ===================================================== */

        function getPaymentStatus(booking) {

            if (
                booking &&
                booking.payment &&
                booking.payment.status
            ) {

                return String(
                    booking.payment.status
                ).toLowerCase();

            }

            if (booking?.paymentStatus) {

                return String(
                    booking.paymentStatus
                ).toLowerCase();

            }

            return "pending";

        }


        function isBookingPaid(booking) {

            const paymentStatus =
                getPaymentStatus(booking);

            return [
                "paid",
                "success",
                "completed"
            ].includes(paymentStatus);

        }


        function isBookingRefunded(booking) {

            const paymentStatus =
                getPaymentStatus(booking);

            const status =
                getBookingStatus(booking);


            if (
                [
                    "refunded",
                    "refund",
                    "refunded_success"
                ].includes(paymentStatus)
            ) {

                return true;

            }


            if (
                status === "cancelled" &&
                isBookingPaid(booking)
            ) {

                return true;

            }


            return false;

        }


        function canUserCancelBooking(booking) {

            if (!booking) {
                return false;
            }

            const status =
                getBookingStatus(booking);


            if (isBookingPaid(booking)) {
                return false;
            }

            if (isBookingRefunded(booking)) {
                return false;
            }

            if (
                status === "cancelled" ||
                status === "completed"
            ) {
                return false;
            }


            return (
                status === "pending" ||
                status === "confirmed"
            );

        }


        /* =====================================================
           TOTAL AMOUNT CALCULATION
           
           BASE + GST 18% + SECURITY DEPOSIT
        ===================================================== */

        function calculateBookingAmount(booking, car) {

            const days = Math.max(
                1,
                Number(
                    booking?.totalDays ?? 1
                ) || 1
            );


            /* PRICE PER DAY */

            const pricePerDay =
                Number(
                    booking?.pricePerDay ??
                    car?.pricePerDay ??
                    0
                ) || 0;


            /* BASE RENTAL */

            const storedBaseAmount =
                Number(
                    booking?.baseAmount
                );


            let baseAmount;


            if (
                Number.isFinite(storedBaseAmount) &&
                storedBaseAmount > 0
            ) {

                baseAmount =
                    storedBaseAmount;

            } else {

                baseAmount =
                    pricePerDay * days;

            }


            /* GST */

            const gstRate = 18;


            const storedGstAmount =
                Number(
                    booking?.gstAmount
                );


            const gstAmount =
                Number.isFinite(storedGstAmount) &&
                storedGstAmount > 0

                    ? storedGstAmount

                    : Math.round(
                        (
                            baseAmount *
                            gstRate
                        ) / 100
                    );


            /* SECURITY DEPOSIT */

            const storedSecurityDeposit =
                Number(
                    booking?.securityDeposit
                );


            const securityDeposit =
                Number.isFinite(
                    storedSecurityDeposit
                ) &&
                storedSecurityDeposit > 0

                    ? storedSecurityDeposit

                    : 3000;


            /* FINAL TOTAL */

            const totalAmount =
                baseAmount +
                gstAmount +
                securityDeposit;


            return {

                days,

                pricePerDay,

                baseAmount,

                gstRate,

                gstAmount,

                securityDeposit,

                totalAmount

            };

        }


        /* =====================================================
           STATUS BADGE
        ===================================================== */

        function getStatusBadge(status) {

            status =
                String(
                    status || "pending"
                ).toLowerCase();


            if (status === "confirmed") {

                return `

                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold"
                    >

                        <span
                            class="w-1.5 h-1.5 rounded-full bg-emerald-500"
                        ></span>

                        Confirmed

                    </span>

                `;

            }


            if (status === "completed") {

                return `

                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold"
                    >

                        <span
                            class="w-1.5 h-1.5 rounded-full bg-blue-500"
                        ></span>

                        Completed

                    </span>

                `;

            }


            if (status === "cancelled") {

                return `

                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 text-red-700 border border-red-200 text-xs font-bold"
                    >

                        <span
                            class="w-1.5 h-1.5 rounded-full bg-red-500"
                        ></span>

                        Cancelled

                    </span>

                `;

            }


            return `

                <span
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold"
                >

                    <span
                        class="w-1.5 h-1.5 rounded-full bg-amber-500"
                    ></span>

                    Pending

                </span>

            `;

        }


        /* =====================================================
           REFUNDED PAYMENT
        ===================================================== */

        function refundedPaymentHtml() {

            return `

                <div
                    class="mt-6 pt-6 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
                >

                    <div>

                        <p
                            class="text-[10px] font-bold uppercase tracking-wider text-slate-400"
                        >
                            Payment Status
                        </p>

                        <div
                            class="mt-1 flex items-center gap-2"
                        >

                            <span
                                class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 font-bold text-xs"
                            >
                                ✓
                            </span>

                            <p
                                class="text-sm font-bold text-emerald-600"
                            >
                                Payment Refunded
                            </p>

                        </div>

                    </div>


                    <div
                        class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold"
                    >
                        ✓ Refund Complete
                    </div>

                </div>

            `;

        }


        /* =====================================================
           PAID PAYMENT
        ===================================================== */

        function paidPaymentHtml() {

            return `

                <div
                    class="mt-6 pt-6 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
                >

                    <div>

                        <p
                            class="text-[10px] font-bold uppercase tracking-wider text-slate-400"
                        >
                            Payment Status
                        </p>

                        <div
                            class="mt-1 flex items-center gap-2"
                        >

                            <span
                                class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 font-bold text-xs"
                            >
                                ✓
                            </span>

                            <p
                                class="text-sm font-bold text-emerald-600"
                            >
                                Payment Completed
                            </p>

                        </div>

                    </div>


                    <div
                        class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold"
                    >
                        ✓ Paid
                    </div>

                </div>

            `;

        }


        /* =====================================================
           CANCEL BUTTON
        ===================================================== */

        function cancelButtonHtml(
            bookingId,
            text = "Cancel Booking"
