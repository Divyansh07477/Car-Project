<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - RideWave</title>

    <link rel="icon" type="image/png" href="/images/title.png.jpeg">
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-primary': '#FF6B35',
                        'brand-primary-hover': '#e85a26'
                    }
                }
            }
        }
    </script>

    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding-top: 72px !important; }

        .ridewave-navbar {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 92px !important;
            background: #ffffff !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            border-bottom: 1px solid #e5e7eb;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            z-index: 99998;
        }

        .ridewave-logo {
            width: 125px;
            height: 90px;
            object-fit: contain;
            display: block;
        }

        @media (max-width: 768px) {
            .ridewave-navbar { height: 64px !important; padding: 0 18px; }
            body { padding-top: 64px !important; }
        }
    </style>
</head>

<body class="bg-[#FBFBFC] text-gray-900 min-h-screen">

    <!-- NAVBAR -->
    <header class="ridewave-navbar">
        <a href="/" class="flex items-center">
            <img src="/images/logo.png" alt="RideWave" class="ridewave-logo">
        </a>

        <a href="/" class="flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-brand-primary transition-colors">
            <span>&larr;</span>
            <span>Browse Cars</span>
        </a>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-4xl mx-auto px-4 py-8 sm:py-12 space-y-8">

        <!-- PROFILE HEADER CARD -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-full bg-orange-50 text-brand-primary flex items-center justify-center text-xl font-bold border border-orange-100">
                    <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <div>
                    <h2 id="userName" class="text-xl font-bold text-slate-900 leading-tight">Loading...</h2>
                    <p id="userEmail" class="text-sm text-slate-500">Loading...</p>
                </div>
            </div>

            <button onclick="handleLogout()" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl border border-orange-200 text-brand-primary font-semibold text-sm hover:bg-orange-50 transition-all self-start sm:self-auto active:scale-95">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                Logout
            </button>
        </div>

        <!-- MY BOOKINGS HEADER & FILTER TABS -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <h1 class="text-2xl font-extrabold text-slate-900">
                My <span class="text-brand-primary">Bookings</span>
            </h1>

            <!-- FILTERS -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 text-sm no-scrollbar">
                <button onclick="filterBookings('all')" class="filter-btn px-4 py-1.5 rounded-full font-medium transition-all bg-brand-primary text-white shadow-sm" data-filter="all">All</button>
                <button onclick="filterBookings('pending')" class="filter-btn px-4 py-1.5 rounded-full font-medium transition-all bg-white border border-slate-200 text-slate-600 hover:border-brand-primary hover:text-brand-primary" data-filter="pending">Pending</button>
                <button onclick="filterBookings('confirmed')" class="filter-btn px-4 py-1.5 rounded-full font-medium transition-all bg-white border border-slate-200 text-slate-600 hover:border-brand-primary hover:text-brand-primary" data-filter="confirmed">Confirmed</button>
                <button onclick="filterBookings('completed')" class="filter-btn px-4 py-1.5 rounded-full font-medium transition-all bg-white border border-slate-200 text-slate-600 hover:border-brand-primary hover:text-brand-primary" data-filter="completed">Completed</button>
                <button onclick="filterBookings('cancelled')" class="filter-btn px-4 py-1.5 rounded-full font-medium transition-all bg-white border border-slate-200 text-slate-600 hover:border-brand-primary hover:text-brand-primary" data-filter="cancelled">Cancelled</button>
            </div>
        </div>

        <!-- BOOKINGS LIST CONTAINER -->
        <div id="bookingsContainer" class="space-y-4">
            <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center text-slate-400 font-medium">
                Loading your bookings...
            </div>
        </div>

    </main>

    <footer class="py-8 text-center text-gray-400 border-t border-gray-100 mt-16">
        <p class="text-xs tracking-wider">CARPOOL VENOM</p>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
       let allBookingsData = [];
        let currentFilter = 'all';

        // 1. Date Formatter
        function formatBookingDate(dStr) {
            if (!dStr) return "N/A";
            const date = new Date(dStr);
            if (isNaN(date.getTime())) return dStr;
            return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
        }

        // 2. Status Badge Mapper
        function getStatusBadge(status) {
            const s = (status || "pending").toLowerCase();
            if (s === "confirmed") {
                return `<span class="text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-md">CONFIRMED</span>`;
            } else if (s === "completed") {
                return `<span class="text-xs font-bold uppercase tracking-wider text-sky-600 bg-sky-50 border border-sky-200 px-3 py-1 rounded-md">COMPLETED</span>`;
            } else if (s === "cancelled") {
                return `<span class="text-xs font-bold uppercase tracking-wider text-rose-500 bg-rose-50 border border-rose-100 px-3 py-1 rounded-md">CANCELLED</span>`;
            }
            return `<span class="text-xs font-bold uppercase tracking-wider text-amber-600 bg-amber-50 border border-amber-200 px-3 py-1 rounded-md">PENDING</span>`;
        }

        // 3. Render Real Database Bookings
        function renderBookings() {
            const container = document.getElementById("bookingsContainer");
            
            const filtered = currentFilter === 'all' 
                ? allBookingsData 
                : allBookingsData.filter(b => (b.status || 'pending').toLowerCase() === currentFilter);

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center text-slate-400">
                        Aapki koi real booking nahi mili (${currentFilter.toUpperCase()}).
                    </div>`;
                return;
            }

            container.innerHTML = filtered.map(item => {
                // Real Car details check
                const carObj = (typeof item.car === 'object' && item.car !== null) ? item.car : {};
                const carName = carObj.name || item.carName || "Car Booking";
                const carImg = carObj.image || item.carImage || "/images/title.png.jpeg";
                
                // Real Pricing and Dates
                const price = Number(item.totalPrice || item.price || 0).toLocaleString("en-IN");
                const pickup = formatBookingDate(item.pickupDate);
                const ret = formatBookingDate(item.returnDate);
                const location = item.pickupLocation || "Pickup address not specified";
                const adminNote = item.adminNote || "";

                return `
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all p-5 sm:p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
                        
                        <!-- Left Info -->
                        <div class="flex items-center gap-5">
                            <div class="w-28 h-20 bg-[#F7F8FA] rounded-xl p-2 flex items-center justify-center flex-shrink-0 border border-slate-100 overflow-hidden">
                                <img src="${carImg}" alt="${carName}" class="max-w-full max-h-full object-contain">
                            </div>

                            <div class="space-y-1">
                                <h3 class="text-lg font-extrabold text-slate-900">${carName}</h3>
                                <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-500 font-medium">
                                    <span>📅 ${pickup} &rarr; ${ret}</span>
                                    <span>•</span>
                                    <span>📍 ${location}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Details -->
                        <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto gap-2 border-t sm:border-t-0 pt-3 sm:pt-0 border-slate-50">
                            <span class="text-xl sm:text-2xl font-black text-brand-primary">₹${price}</span>
                            ${getStatusBadge(item.status)}
                        </div>

                    </div>

                    ${adminNote ? `
                    <div class="pt-3 border-t border-slate-50 flex items-start gap-2">
                        <div class="w-1 bg-brand-primary self-stretch rounded-full"></div>
                        <p class="text-xs sm:text-sm text-slate-600 bg-slate-50 px-3 py-2 rounded-lg w-full">
                            <strong class="text-slate-800 font-semibold">Admin Note:</strong> ${adminNote}
                        </p>
                    </div>` : ''}
                </div>
                `;
            }).join('');
        }

        // 4. Tab Switcher
        function filterBookings(type) {
            currentFilter = type;

            document.querySelectorAll(".filter-btn").forEach(btn => {
                const btnType = btn.getAttribute("data-filter");
                if (btnType === currentFilter) {
                    btn.className = "filter-btn px-4 py-1.5 rounded-full font-medium transition-all bg-brand-primary text-white shadow-sm";
                } else {
                    btn.className = "filter-btn px-4 py-1.5 rounded-full font-medium transition-all bg-white border border-slate-200 text-slate-600 hover:border-brand-primary hover:text-brand-primary";
                }
            });

            renderBookings();
        }

        // 5. Fetch Actual User and Bookings
        async function initPage() {
            try {
                // Step A: Logged in user fetch karo
                const authRes = await fetch("/api/auth/me", { method: "GET", credentials: "include" });
                const authData = await authRes.json();

                if (!authRes.ok || !authData.loggedIn) {
                    window.location.href = "/login";
                    return;
                }

                const user = authData.user || {};
                document.getElementById("userName").textContent = user.name || "User";
                document.getElementById("userEmail").textContent = user.email || "";

                const userEmail = (user.email || "").trim();

                // Step B: User ke email se database bookings mangwao
                const bookRes = await fetch(`/api/bookings/my-bookings?email=${encodeURIComponent(userEmail)}`, {
                    method: "GET",
                    credentials: "include"
                });

                const bookData = await bookRes.json();
                console.log("Database se aayi bookings:", bookData);

                if (bookData.success && Array.isArray(bookData.bookings)) {
                    allBookingsData = bookData.bookings;
                } else {
                    allBookingsData = [];
                }

                renderBookings();

            } catch (err) {
                console.error("Initialization error:", err);
                document.getElementById("bookingsContainer").innerHTML = `
                    <div class="bg-white rounded-2xl border border-rose-100 p-8 text-center text-rose-500 font-medium">
                        Database se data load karne me problem aayi. Console (F12) check karein.
                    </div>`;
            }
        }

        // 6. Logout
        async function handleLogout() {
            try {
                await fetch("/api/auth/logout", { method: "POST", credentials: "include" });
                window.location.href = "/login";
            } catch (err) {
                window.location.href = "/login";
            }
        }

        document.addEventListener("DOMContentLoaded", initPage);
    </script>

</body>
</html>